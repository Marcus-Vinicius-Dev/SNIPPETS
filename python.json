			"def funcao_ler_pasta_origem(): # verifique o comando çlogica",
			"    arquivos = os.listdir(pasta_base)                                          # lista todos os itens da pasta_base",
			"    print(Fore.YELLOW + Style.BRIGHT + f\"Total de itens em '{os.path.basename(pasta_base)}' = {len(arquivos)} itens\") # exibe quantidade",
			"    for arq in arquivos:                                                        # percorre cada item",
