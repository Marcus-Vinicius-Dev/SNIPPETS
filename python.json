			"discar = conexao.connect((\"google.com\", 80))",
			"print(Fore.BLUE + Style.BRIGHT + '\\ndiscar', discar)",
			"",
			"envio = conexao.send(b\"GET / HTTP/1.1\\r\\nHost: google.com\\r\\n\\r\\n\")",
			"print(Fore.BLUE + Style.BRIGHT + '\\nenvio', envio)",
			"",
			"resposta = conexao.recv(100)",
			"print(Fore.BLUE + Style.BRIGHT + '\\nresposta', resposta)",
			"",
			"desconectar = conexao.close()",
			"print(Fore.BLUE + Style.BRIGHT + '\\ndesconectar', desconectar)"
