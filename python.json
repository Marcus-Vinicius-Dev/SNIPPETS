"web_extrator_total": {
	"prefix": "webextratotal",
	"body": [
		"# ============================================",
		"# EXTRATOR RESUMIDO - APENAS TOTALIZAÇÕES",
		"# ============================================",
		"print(\"\\n\" + \"=\" * 60)",
		"print(\"📊 RESUMO COMPLETO DA PÁGINA\")",
		"print(\"=\" * 60)",
		"",
		"def extrair_resumo_completo(driver):",
		"    \"\"\"",
		"    Extrai apenas o resumo completo da página com totalizações",
		"    Sem listar item por item",
		"    \"\"\"",
		"    ",
		"    resumo = {}",
		"    ",
		"    # ============================================",
		"    # 1. INFORMAÇÕES BÁSICAS",
		"    # ============================================",
		"    print(\"\\n1️⃣ INFORMAÇÕES BÁSICAS:\")",
		"    print(\"-\" * 40)",
		"    ",
		"    resumo['titulo'] = driver.title",
		"    resumo['url'] = driver.current_url",
		"    resumo['html_tamanho'] = len(driver.page_source)",
		"    ",
		"    # Tamanho do texto",
		"    try:",
		"        texto = driver.find_element(By.TAG_NAME, \"body\").text",
		"        resumo['texto_tamanho'] = len(texto)",
		"    except:",
		"        resumo['texto_tamanho'] = 0",
		"    ",
		"    print(f\"   📄 Título: {resumo['titulo']}\")",
		"    print(f\"   🔗 URL: {resumo['url']}\")",
		"    print(f\"   📝 Tamanho HTML: {resumo['html_tamanho']:,} caracteres\")",
		"    print(f\"   📌 Tamanho texto: {resumo['texto_tamanho']:,} caracteres\")",
		"    ",
		"    # ============================================",
		"    # 2. CONTAGEM DE ELEMENTOS POR TAG",
		"    # ============================================",
		"    print(\"\\n2️⃣ CONTAGEM DE ELEMENTOS POR TAG:\")",
		"    print(\"-\" * 40)",
		"    ",
		"    # Lista de tags para contar",
		"    tags = [",
		"        'p', 'a', 'img',",
		"        'h1', 'h2', 'h3', 'h4', 'h5', 'h6',",
		"        'div', 'span', 'label', 'input', 'button',",
		"        'form', 'table', 'ul', 'ol', 'li',",
		"        'section', 'article', 'header', 'footer', 'nav', 'main', 'aside'",
		"    ]",
		"    ",
		"    contagem = {}",
		"    for tag in tags:",
		"        elementos = driver.find_elements(By.TAG_NAME, tag)",
		"        contagem[tag] = len(elementos)",
		"        if contagem[tag] > 0:",
		"            print(f\"   <{tag}>: {contagem[tag]:,}\")",
		"    ",
		"    resumo['contagem_tags'] = contagem",
		"    ",
		"    # ============================================",
		"    # 3. DETALHES DE INPUTS (por tipo)",
		"    # ============================================",
		"    print(\"\\n3️⃣ DETALHES DOS INPUTS:\")",
		"    print(\"-\" * 40)",
		"    ",
		"    inputs = driver.find_elements(By.TAG_NAME, \"input\")",
		"    tipos_input = {}",
		"    for inp in inputs:",
		"        tipo = inp.get_attribute('type') or 'text'",
		"        tipos_input[tipo] = tipos_input.get(tipo, 0) + 1",
		"    ",
		"    print(f\"   📝 Total de inputs: {len(inputs)}\")",
		"    if tipos_input:",
		"        print(f\"   📊 Tipos encontrados:\")",
		"        for tipo, qtd in sorted(tipos_input.items()):",
		"            print(f\"      - {tipo}: {qtd}\")",
		"    ",
		"    resumo['inputs'] = {'total': len(inputs), 'tipos': tipos_input}",
		"    ",
		"    # ============================================",
		"    # 4. DETALHES DE BOTÕES",
		"    # ============================================",
		"    print(\"\\n4️⃣ DETALHES DOS BOTÕES:\")",
		"    print(\"-\" * 40)",
		"    ",
		"    buttons = driver.find_elements(By.TAG_NAME, \"button\")",
		"    tipos_button = {}",
		"    for btn in buttons:",
		"        tipo = btn.get_attribute('type') or 'submit'",
		"        tipos_button[tipo] = tipos_button.get(tipo, 0) + 1",
		"    ",
		"    print(f\"   🔘 Total de botões: {len(buttons)}\")",
		"    if tipos_button:",
		"        print(f\"   📊 Tipos encontrados:\")",
		"        for tipo, qtd in sorted(tipos_button.items()):",
		"            print(f\"      - {tipo}: {qtd}\")",
		"    ",
		"    resumo['buttons'] = {'total': len(buttons), 'tipos': tipos_button}",
		"    ",
		"    # ============================================",
		"    # 5. ELEMENTOS POR CLASSE (Top 20)",
		"    # ============================================",
		"    print(\"\\n5️⃣ ELEMENTOS POR CLASSE (Top 20):\")",
		"    print(\"-\" * 40)",
		"    ",
		"    # Coletar todas as classes",
		"    contador_classes = Counter()",
		"    elementos_com_classe = driver.find_elements(By.XPATH, \"//*[@class]\")",
		"    ",
		"    for elem in elementos_com_classe:",
		"        classes = elem.get_attribute('class').split()",
		"        for classe in classes:",
		"            contador_classes[classe] += 1",
		"    ",
		"    print(f\"   📌 Total de classes únicas: {len(contador_classes)}\")",
		"    print(f\"\\n   📊 Classes mais comuns:\")",
		"    ",
		"    top_classes = contador_classes.most_common(20)",
		"    for i, (classe, qtd) in enumerate(top_classes, 1):",
		"        print(f\"      {i:2d}. .{classe}: {qtd} elementos\")",
		"    ",
		"    resumo['classes'] = {'total': len(contador_classes), 'top_20': top_classes}",
		"    ",
		"    # ============================================",
		"    # 6. FORMULÁRIOS",
		"    # ============================================",
		"    print(\"\\n6️⃣ FORMULÁRIOS:\")",
		"    print(\"-\" * 40)",
		"    ",
		"    forms = driver.find_elements(By.TAG_NAME, \"form\")",
		"    total_campos_form = 0",
		"    ",
		"    for form in forms:",
		"        campos = form.find_elements(By.TAG_NAME, \"input\")",
		"        campos += form.find_elements(By.TAG_NAME, \"select\")",
		"        campos += form.find_elements(By.TAG_NAME, \"textarea\")",
		"        total_campos_form += len(campos)",
		"    ",
		"    print(f\"   📋 Total de formulários: {len(forms)}\")",
		"    print(f\"   📝 Total de campos: {total_campos_form}\")",
		"    ",
		"    resumo['formularios'] = {'total': len(forms), 'campos': total_campos_form}",
		"    ",
		"    # ============================================",
		"    # 7. TABELAS",
		"    # ============================================",
		"    print(\"\\n7️⃣ TABELAS:\")",
		"    print(\"-\" * 40)",
		"    ",
		"    tabelas = driver.find_elements(By.TAG_NAME, \"table\")",
		"    total_linhas = 0",
		"    total_celulas = 0",
		"    ",
		"    for tabela in tabelas:",
		"        linhas = tabela.find_elements(By.TAG_NAME, \"tr\")",
		"        celulas = tabela.find_elements(By.TAG_NAME, \"td\")",
		"        celulas += tabela.find_elements(By.TAG_NAME, \"th\")",
		"        total_linhas += len(linhas)",
		"        total_celulas += len(celulas)",
		"    ",
		"    print(f\"   📊 Total de tabelas: {len(tabelas)}\")",
		"    if tabelas:",
		"        print(f\"   📊 Total de linhas: {total_linhas}\")",
		"        print(f\"   📊 Total de células: {total_celulas}\")",
		"    ",
		"    resumo['tabelas'] = {",
		"        'total': len(tabelas),",
		"        'linhas': total_linhas,",
		"        'celulas': total_celulas",
		"    }",
		"    ",
		"    # ============================================",
		"    # 8. LISTAS",
		"    # ============================================",
		"    print(\"\\n8️⃣ LISTAS:\")",
		"    print(\"-\" * 40)",
		"    ",
		"    ul = driver.find_elements(By.TAG_NAME, \"ul\")",
		"    ol = driver.find_elements(By.TAG_NAME, \"ol\")",
		"    ",
		"    total_itens_ul = 0",
		"    for lista in ul:",
		"        itens = lista.find_elements(By.TAG_NAME, \"li\")",
		"        total_itens_ul += len(itens)",
		"    ",
		"    total_itens_ol = 0",
		"    for lista in ol:",
		"        itens = lista.find_elements(By.TAG_NAME, \"li\")",
		"        total_itens_ol += len(itens)",
		"    ",
		"    print(f\"   📋 UL (não ordenadas): {len(ul)} (itens: {total_itens_ul})\")",
		"    print(f\"   📋 OL (ordenadas): {len(ol)} (itens: {total_itens_ol})\")",
		"    print(f\"   📋 Total de itens: {total_itens_ul + total_itens_ol}\")",
		"    ",
		"    resumo['listas'] = {",
		"        'ul': len(ul),",
		"        'ul_itens': total_itens_ul,",
		"        'ol': len(ol),",
		"        'ol_itens': total_itens_ol,",
		"        'total_itens': total_itens_ul + total_itens_ol",
		"    }",
		"    ",
		"    # ============================================",
		"    # 9. LINKS (com detalhes de destino)",
		"    # ============================================",
		"    print(\"\\n9️⃣ LINKS:\")",
		"    print(\"-\" * 40)",
		"    ",
		"    links = driver.find_elements(By.TAG_NAME, \"a\")",
		"    links_externos = 0",
		"    links_internos = 0",
		"    ",
		"    dominio = driver.current_url.split('/')[0] + '//' + driver.current_url.split('/')[2]",
		"    ",
		"    for link in links:",
		"        href = link.get_attribute('href')",
		"        if href:",
		"            if href.startswith(dominio) or href.startswith('/') or href.startswith('#'):",
		"                links_internos += 1",
		"            else:",
		"                links_externos += 1",
		"    ",
		"    print(f\"   🔗 Total de links: {len(links)}\")",
		"    print(f\"   🔗 Links internos: {links_internos}\")",
		"    print(f\"   🔗 Links externos: {links_externos}\")",
		"    ",
		"    resumo['links'] = {",
		"        'total': len(links),",
		"        'internos': links_internos,",
		"        'externos': links_externos",
		"    }",
		"    ",
		"    # ============================================",
		"    # 10. IMAGENS",
		"    # ============================================",
		"    print(\"\\n🔟 IMAGENS:\")",
		"    print(\"-\" * 40)",
		"    ",
		"    imagens = driver.find_elements(By.TAG_NAME, \"img\")",
		"    imagens_com_alt = 0",
		"    imagens_sem_alt = 0",
		"    ",
		"    for img in imagens:",
		"        if img.get_attribute('alt'):",
		"            imagens_com_alt += 1",
		"        else:",
		"            imagens_sem_alt += 1",
		"    ",
		"    print(f\"   🖼️ Total de imagens: {len(imagens)}\")",
		"    print(f\"   🖼️ Com descrição (alt): {imagens_com_alt}\")",
		"    print(f\"   🖼️ Sem descrição (alt): {imagens_sem_alt}\")",
		"    ",
		"    resumo['imagens'] = {",
		"        'total': len(imagens),",
		"        'com_alt': imagens_com_alt,",
		"        'sem_alt': imagens_sem_alt",
		"    }",
		"    ",
		"    # ============================================",
		"    # 11. RESUMO GERAL",
		"    # ============================================",
		"    print(\"\\n\" + \"=\" * 60)",
		"    print(\"📊 RESUMO GERAL DA PÁGINA:\")",
		"    print(\"=\" * 60)",
		"    print(f\"   📄 Título: {resumo['titulo']}\")",
		"    print(f\"   📝 Texto: {resumo['texto_tamanho']:,} caracteres\")",
		"    print(f\"   📝 Parágrafos: {contagem.get('p', 0)}\")",
		"    print(f\"   🔗 Links: {len(links)} ({links_internos} internos, {links_externos} externos)\")",
		"    print(f\"   🖼️ Imagens: {len(imagens)}\")",
		"    print(f\"   📌 Cabeçalhos: {sum([contagem.get(f'h{i}', 0) for i in range(1,7)])}\")",
		"    print(f\"   📦 Divs: {contagem.get('div', 0)}\")",
		"    print(f\"   📍 Spans: {contagem.get('span', 0)}\")",
		"    print(f\"   🏷️  Labels: {contagem.get('label', 0)}\")",
		"    print(f\"   📝 Inputs: {len(inputs)}\")",
		"    print(f\"   🔘 Botões: {len(buttons)}\")",
		"    print(f\"   📋 Formulários: {len(forms)} ({total_campos_form} campos)\")",
		"    print(f\"   📊 Tabelas: {len(tabelas)}\")",
		"    print(f\"   📋 Listas: {len(ul) + len(ol)} (itens: {total_itens_ul + total_itens_ol})\")",
		"    print(f\"   📌 Classes únicas: {len(contador_classes)}\")",
		"    print(\"=\" * 60)",
		"    ",
		"    return resumo",
