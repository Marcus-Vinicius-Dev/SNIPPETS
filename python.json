		//editar_texto_leitor
	"editar_texto_leitor": {
		"prefix": "pyleredicao",
		"body": [
			"${1:endereco_arquivo = r'${2:C:\\\\endereco.arq}'}",
			"",
			"#################### edição de texto lista_portas.txt ####################",
			"def editar_texto(linha):    ",
			"    texto = linha.split('#')[0]                         # Remove comentários",
			"    texto = texto.strip()                               # Remove espaços do início e fim",
			"    texto = re.sub(r'\\s+', ' ', texto)                  # Remove espaços extras (múltiplos viram um só)",
			"    texto = texto.replace(\" \", \"\")                      # Substitui \" \" por \"\"",
			"    texto = texto.upper()                               # Converte para maiúsculo",
			"    texto = re.sub(r'\\s+', ' ', texto).strip()          # Remove espaços extras novamente (por segurança)",
			"    texto = re.sub(r'[^a-zA-Z0-9\\s]', '', texto)        # Remove caracteres especiais (mantém letras, números e espaços)",
			"    ",
			"    texto = ''.join(                                    # Remove acentos    ",
			"        c for c in unicodedata.normalize('NFD', texto)",
			"        if unicodedata.category(c) != 'Mn'",
			"    )",
			"    ",
			"    for palavra in ['Porta', 'Port']:                   # Remove palavras-chave (opcional)",
			"        texto = texto.replace(palavra, '')",
			"    ",
			"    return texto"
		],
		"description": "Edição de texto a ser lido (comentários, espaços, acentos, caracteres especiais)"
	},

