		"",
		"# funções ",
		"ler_pasta_origem = '${2:1}'",
		"",
		"# dicionário com lógica",
		"dicionario_pastas_origem = {",
		"    '1': r'C:\\Users\\marcus.silva05\\Desktop\\DADOS\\BASES_CSV\\CEPEA',",
		"    '2': r'C:\\Users\\marcus.silva05\\Desktop\\DADOS\\BASES_CSV\\CONTAGEH',",
		"    '3': r'C:\\Users\\marcus.silva05\\Desktop\\DADOS\\BASES_CSV\\SAS',",
		"}",
		"",
		"# lógica",
		"pasta_base = dicionario_pastas_origem.get(pasta_origem, None)",
		"if pasta_base is None:",
		"    print(Fore.RED + Style.BRIGHT + \"pasta_origem não selecionada\")",
		"else:",
		"    print(Fore.YELLOW + f\"✅ Pasta selecionada: '{pasta_base}'\")"
	],
	"description": "Seleciona pasta CSV por origem"
},

//DICIONARIO
"DICIONARIO": {
	"prefix": "çdicionario",
	"body": [
		"# dicionário nível 1 (chave mestra = seleciona o grupo)",
		"dicionario_1 = {",
		"    '1': r'C:\\endereco\\pasta_1',                                            ",
		"    '2': r'C:\\endereco\\pasta_2',                                            ",
		"    '3': r'C:\\endereco\\pasta_3',                                            ",
		"}",
		"",
		"# dicionário nível 2 (chave mestra = dicionario_1, chave interna = item)",
		"dicionario_associado_a_1 = {",
		"    '1': {                                                                   ",
		"        '1': 'arquivo_1_1.csv',                                             ",
		"        '2': 'arquivo_1_2.csv',                                             ",
		"        '3': 'arquivo_1_3.csv',                                             ",
		"    },",
		"    '2': {                                                                   ",
		"        '1': 'arquivo_2_1.csv',                                             ",
		"        '2': 'arquivo_2_2.csv',                                             ",
		"        '3': 'arquivo_2_3.csv',                                             ",
		"    },",
		"    '3': {                                                                   ",
		"        '1': 'arquivo_3_1.csv',                                             ",
		"        '2': 'arquivo_3_2.csv',                                             ",
		"        '3': 'arquivo_3_3.csv',                                             ",
		"    },",
		"}",
		"",
		"# resolução em 2 níveis (segura contra chave inexistente)",
		"pasta_origem   = '${1:1}'                                                        ",
		"arquivo_origem = '${2:}'                                                         ",
		"caminho_1      = dicionario_1.get(pasta_origem, None)                       ",
		"caminho_2      = dicionario_associado_a_1.get(pasta_origem, {}).get(arquivo_origem, None)  ",
		"caminho_final  = os.path.join(caminho_1, caminho_2) if caminho_1 and caminho_2 else None   ",
		"print(Fore.CYAN + f\"caminho_final = {caminho_final}\")"
	],
	"description": "Dicionário de 2 níveis com resolução segura"
},

//FUNCAO_LER_PASTA_ORIGEM
"FUNCAO_LER_PASTA_ORIGEM": {
	"prefix": "çf_ler_pasta_origem",
	"body": [
		"def funcao_ler_pasta_origem(): # verifique o comando çlogica",
		"    arquivos = os.listdir(pasta_base)                                          # lista todos os itens da pasta_base",
		"    print(Fore.YELLOW + Style.BRIGHT + f\"Total de itens em '{os.path.basename(pasta_base)}' = {len(arquivos)} itens\") # exibe quantidade",
		"    for arq in arquivos:                                                        # percorre cada item",
		"        caminho_completo = os.path.join(pasta_base, arq)   ",
		"        if os.path.isfile(caminho_completo):                                    # verifica se é arquivo",
		"            print(Fore.BLUE + f\"  ARQUIVO: {os.path.basename(caminho_completo)}\")   # exibe só nome+extensão                           ",
		"        else:                                                                   # caso contrário é pasta",
		"            print(Fore.YELLOW + f\"  SUBPASTA: {os.path.basename(caminho_completo)}\")  # exibe só nome da pasta",
		"    return arquivos                                                             # retorna lista de arquivos",
		"",
		"# CHAMAR FUNÇÃO funcao_ler_pasta_origem",
		"if ${1:ler_pasta_origem} == '1':",
		"    funcao_ler_pasta_origem()",
		"else:",
		"    print(Fore.RED + Style.BRIGHT + f\"funcao_ler_pasta_origem não chamada\")"
	],
	"description": "Lista conteúdo da pasta de origem com contagem"
}

