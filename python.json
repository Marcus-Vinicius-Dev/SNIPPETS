"verificar_cabeçalho_e_linhas_excel": {
	"prefix": "weblerexcelcabecalho",
	"body": [
		"arquivo = r\"${1:CAMINHO_DO_ARQUIVO_A_SER_LIDO}\"",
		"    ",
		"def analisar_cabecalhos_e_linhas(caminho_arquivo):",
		"    \"\"\"Foco apenas em cabeçalhos e primeiras linhas de cada planilha\"\"\"",
		"    ",
		"    if not os.path.exists(caminho_arquivo):",
		"        print(f\"❌ Arquivo não encontrado: {caminho_arquivo}\")",
		"        return",
		"    ",
		"    print(\"=\" * 80)",
		"    print(f\"📊 CABEÇALHOS E PRIMEIRAS LINHAS\")",
		"    print(\"=\" * 80)",
		"    print(f\"📁 {os.path.basename(caminho_arquivo)}\")",
		"    print(\"=\" * 80)",
		"    ",
		"    try:",
		"        xl_file = pd.ExcelFile(caminho_arquivo)",
		"        sheet_names = xl_file.sheet_names",
		"        ",
		"        print(f\"\\n📋 {len(sheet_names)} planilha(s) encontrada(s):\")",
		"        for i, name in enumerate(sheet_names, 1):",
		"            print(f\"   {i}. {name}\")",
		"        ",
		"        for sheet_name in sheet_names:",
		"            print(\"\\n\" + \"=\" * 80)",
		"            print(f\"📄 PLANILHA: {sheet_name}\")",
		"            print(\"=\" * 80)",
		"            ",
		"            try:",
		"                # Ler a planilha",
		"                df = pd.read_excel(caminho_arquivo, sheet_name=sheet_name)",
		"                ",
		"                if df.empty:",
		"                    print(\"⚠️  Planilha vazia!\")",
		"                    continue",
		"                ",
		"                # Mostrar cabeçalho",
		"                print(f\"\\n📌 CABEÇALHO ({len(df.columns)} colunas):\")",
		"                print(\"-\" * 40)",
		"                for i, col in enumerate(df.columns, 1):",
		"                    print(f\"   {i:2d}. {col}\")",
		"                ",
		"                # Mostrar primeiras linhas",
		"                print(f\"\\n📄 PRIMEIRAS LINHAS:\")",
		"                print(\"-\" * 40)",
		"                ",
		"                # Quantas linhas mostrar (padrão 5)",
		"                n_linhas = min(5, len(df))",
		"                ",
		"                # Criar tabela bonita",
		"                for linha in range(n_linhas):",
		"                    valores = []",
		"                    for col in df.columns[:10]:  # Mostrar até 10 colunas",
		"                        valor = df.iloc[linha][col]",
		"                        if pd.isna(valor):",
		"                            valores.append(\"\")",
		"                        else:",
		"                            # Truncar valores longos",
		"                            valor_str = str(valor)",
		"                            if len(valor_str) > 30:",
		"                                valor_str = valor_str[:27] + \"...\"",
		"                            valores.append(valor_str)",
		"                    ",
		"                    print(f\"   Linha {linha+1}: {' | '.join(valores)}\")",
		"                    if len(df.columns) > 10:",
		"                        print(f\"   ... e mais {len(df.columns)-10} colunas\")",
		"                ",
		"                # Mostrar total de linhas",
		"                print(f\"\\n   Total: {len(df)} linhas\")",
		"                ",
		"            except Exception as e:",
		"                print(f\"❌ Erro ao ler planilha: {e}\")",
		"            ",
		"            print(\"-\" * 80)",
		"            ",
		"    except Exception as e:",
		"        print(f\"❌ Erro ao abrir arquivo: {e}\")",
		"",
		"if __name__ == \"__main__\":",
		"    analisar_cabecalhos_e_linhas(arquivo)"
	],
	"description": "Verifica cabeçalhos e primeiras linhas de todas as planilhas de um arquivo Excel"
},

"ler_arquivo_txt": {
    "prefix": "weblerarquivotxt",
    "body": [
        "caminho = r\"${1:C:\\\\caminho\\\\para\\\\arquivo.txt}\"",
        "def ${2:ler_linhas}(caminho,",
        "               ignorar_vazias=${3:True},        # ignorar linhas que ficaram vazias após strip",
        "               remover_acentos=${4:False},      # normalizar acentos (ex: 'coração' -> 'coracao')",
        "               converter_maiusculas=${5:False}, # transformar tudo em maiúsculas",
        "               converter_minusculas=${6:False}, # transformar tudo em minúsculas",
        "               remover_pontuacao=${7:False},    # remove tudo que não for dígito (CPF/CNPJ)",
        "               manter_apenas_digitos=${8:False},# igual a remover_pontuacao (sinônimo)",
        "               filtrar_por_prefixo=${9:None},   # ex: \"CPF:\" -> só linhas começando com isso",
        "               filtrar_por_sufixo=${10:None},    # ex: \"@sp.gov.br\" -> só linhas terminando assim",
        "               pular_linhas_iniciais=${11:0},    # pular N primeiras linhas",
        "               limitar_linhas=${12:None},        # ler no máximo N linhas (int)",
        "               remover_duplicatas=${13:False},   # mantém apenas a primeira ocorrência",
        "               comentario_inicio='${14:#}',      # ignorar linhas que começam com este caractere",
        "               strip_caracteres=${15:None},      # strip específico (ex: ' \\t\\n\\r')",
        "               validar_cpf=${16:False},          # só adiciona se for um CPF válido",
        "               validar_email=${17:False}):       # só adiciona se tiver formato de e-mail",
        "    ",
        "    import re",
        "    linhas = []",
        "    vistos = set()",
        "    ",
        "    with open(caminho, 'r', encoding='utf-8') as f:",
        "        for idx, linha in enumerate(f):",
        "            # 1. Extrair valor (strip)",
        "            if strip_caracteres is None:",
        "                valor = linha.strip()",
        "            else:",
        "                valor = linha.strip(strip_caracteres)",
        "            ",
        "            # 2. Pular linhas iniciais (antes de qualquer filtro)",
        "            if idx < pular_linhas_iniciais:",
        "                continue",
        "            ",
        "            # 3. Ignorar vazias",
        "            if ignorar_vazias and not valor:",
        "                continue",
        "            ",
        "            # 4. Ignorar comentários",
        "            if comentario_inicio and valor.startswith(comentario_inicio):",
        "                continue",
        "            ",
        "            # 5. Remover acentos",
        "            if remover_acentos:",
        "                import unicodedata",
        "                valor = unicodedata.normalize('NFKD', valor).encode('ascii', 'ignore').decode('ascii')",
        "            ",
        "            # 6. Maiúsculas/minúsculas",
        "            if converter_maiusculas:",
        "                valor = valor.upper()",
        "            elif converter_minusculas:",
        "                valor = valor.lower()",
        "            ",
        "            # 7. Remover pontuação (dígitos apenas)",
        "            if remover_pontuacao or manter_apenas_digitos:",
        "                valor = re.sub(r'\\D', '', valor)",
        "            ",
        "            # 8. Filtrar por prefixo",
        "            if filtrar_por_prefixo:",
        "                if not valor.startswith(filtrar_por_prefixo):",
        "                    continue",
        "                # opcional: remover o prefixo (descomente a linha abaixo)",
        "                # valor = valor[len(filtrar_por_prefixo):].strip()",
        "            ",
        "            # 9. Filtrar por sufixo",
        "            if filtrar_por_sufixo:",
        "                if not valor.endswith(filtrar_por_sufixo):",
        "                    continue",
        "            ",
        "            # 10. Validar CPF",
        "            if validar_cpf:",
        "                cpf_limpo = re.sub(r'\\D', '', valor)",
        "                if len(cpf_limpo) != 11 or not cpf_limpo.isdigit():",
        "                    continue",
        "                def _validar_cpf(c):",
        "                    if len(set(c)) == 1: return False",
        "                    soma = sum(int(c[i]) * (10-i) for i in range(9))",
        "                    d1 = 11 - (soma % 11)",
        "                    d1 = 0 if d1 >= 10 else d1",
        "                    soma = sum(int(c[i]) * (11-i) for i in range(10))",
        "                    d2 = 11 - (soma % 11)",
        "                    d2 = 0 if d2 >= 10 else d2",
        "                    return d1 == int(c[9]) and d2 == int(c[10])",
        "                if not _validar_cpf(cpf_limpo):",
        "                    continue",
        "                valor = cpf_limpo",
        "            ",
        "            # 11. Validar e-mail",
        "            if validar_email:",
        "                if not re.match(r'^[\\w\\.-]+@[\\w\\.-]+\\.\\w+$', valor):",
        "                    continue",
        "            ",
        "            # 12. Remover duplicatas (após todas as transformações)",
        "            if remover_duplicatas:",
        "                valor_chave = valor.lower() if converter_minusculas else valor",
        "                if valor_chave in vistos:",
        "                    continue",
        "                vistos.add(valor_chave)",
        "            ",
        "            # 13. Adicionar à lista",
        "            linhas.append(valor)",
        "            ",
        "            # 14. Limitar número de linhas",
        "            if limitar_linhas and len(linhas) >= limitar_linhas:",
        "                break",
        "    ",
        "    return linhas",
        "",
        "# ===== Uso da Fução =====",
        "dados = ${2:ler_linhas}(caminho,",
        "                        ignorar_vazias=${3:True},",
        "                        remover_acentos=${4:False},",
        "                        converter_maiusculas=${5:False},",
        "                        converter_minusculas=${6:False},",
        "                        remover_pontuacao=${7:False},",
        "                        manter_apenas_digitos=${8:False},",
        "                        filtrar_por_prefixo=${9:None},",
        "                        filtrar_por_sufixo=${10:None},",
        "                        pular_linhas_iniciais=${11:0},",
        "                        limitar_linhas=${12:None},",
        "                        remover_duplicatas=${13:False},",
        "                        comentario_inicio='${14:#}',",
        "                        strip_caracteres=${15:None},",
        "                        validar_cpf=${16:False},",
        "                        validar_email=${17:False})",
        "print(f\"Foram lidos {len(dados)} registro(s).\")",
        "for i, item in enumerate(dados[:${18:1000000}], 1):",
        "    print(f\"{i}: {item}\")",
		"print(f\"\\n\\n \\033[1;34m Foram lidas {len(dados)} linhas no total. \\033[0m \\n\\n\")"
    ],
    "description": "Função completa para leitura de arquivos com inúmeras opções (ordem corrigida)"
},

