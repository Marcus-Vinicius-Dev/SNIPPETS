		  "   SELECT *,",
		  "      ROW_NUMBER() OVER (PARTITION BY CPF_DI ORDER BY (SELECT NULL)) AS ROW1 -- OU ORDER BY coluna1 DESC",
		  "   FROM BASE_RANK1",
		  ")",
		  "SELECT *",
		  "INTO #00_CTG",
		  "FROM RANK1",
		  "WHERE ROW1 = 1 --PRIMEIRA LINHA DA DUPLICATA",
		  "ORDER BY CPF_DI",
