	  "        NOME_ALUNO,",
	  "        DATE_FORMAT(TO_DATE(DATA_NASCIMENTO), 'dd/MM/yyyy') AS DATA_NASCIMENTO,",
	  "        CONCAT(CAST(ROUND(FREQUENCIA_1_BIMESTRE * 100, 2) AS STRING), '%') AS FREQUENCIA_1_BIMESTRE_PCT,",
	  "        CONCAT(CAST(ROUND(FREQUENCIA_2_BIMESTRE * 100, 2) AS STRING), '%') AS FREQUENCIA_2_BIMESTRE_PCT,",
	  "        CONCAT(CAST(ROUND(MEDIA_FREQUENCIA_1_E_2_BIMESTRE_2024 * 100, 2) AS STRING), '%') AS MEDIA_FREQ_PCT,",
	  "        CD_ALUNO,",
