		  "LEFT JOIN #BFE L ON J.CD_MOT_INTERRUP_CESS_TIT  = L.COD",
		  "LEFT JOIN #NIVEL M ON A.CPF  = M.CPF",
		  "LEFT JOIN #PESSOAL N ON A.CPF  = N.NR_CPF",
