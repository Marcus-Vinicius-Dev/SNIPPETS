		  "      CD_IDENT_REF_FAIXA_TIT AS REF_FAIXA,",
		  "      CD_IDENT_GRAU_NIV_TIT AS GRAU_NIV,",
		  "      CD_JORNADA_TIT AS JORNADA   ,",
		  "      CD_UNID_ESC_CLASS_TIT AS CIE_C,",
		  "      CD_UNID_ADM_CLASS_TIT AS UA_C,",
		  "      CD_UNID_ESC_EXERC_TIT AS CIE_E,",
		  "      CD_UNID_ADM_EXERC_TIT AS UA_E,",
		  "      CD_TIP_INTERRUP_CESS_TIT AS INTERRUP,",
		  "      CD_MOT_INTERRUP_CESS_TIT AS MOT_INTERRUP,",
		  "      DT_INIC_INTERRUP_CESS_TIT AS DTI_INTERRUP,",
		  "      DT_FIM_INTERRUP_CESS_TIT AS DTF_INTERRUP,",
		  "      CD_MOT_AFAST_TIT AS MOTIAFAS,",
		  "      DT_INIC_AFAST_TIT AS DTI_MOTIAFAS,",
		  "      DT_FIM_AFAST_TIT AS DTF_MOTIAFAS,",
		  "      CD_MOT_LIC_TIT AS MOTILICE  ,",
		  "      DT_INIC_LIC_TIT AS DTI_MOTILICE,",
		  "      DT_FIM_LIC_TIT AS DTF_MOTICE,",
		  "      CD_TIP_PROV_COMIS           ,",
		  "      CD_CARGO_FUNCAO_COMIS AS CARGO_COMIS,",
		  "      DT_POSSE_COMIS              ,",
		  "      DT_INIC_EXERC_COMIS         ,",
		  "      DT_INIC_SIT_ESP_COMIS AS SIT_ESP_COMIS,",
		  "      CD_IDENT_GRAU_NIV_COMIS     ,",
		  "      CD_UNID_ESC_CLASS_COMIS AS UE_C_COMIS,",
		  "      CD_UNID_ADM_CLASS_COMIS AS UA_C_COMIS,",
		  "      CD_UNID_ESC_EXER_COMIS AS UE_E_COMIS,",
		  "      CD_UNID_ADM_EXER_COMIS AS UA_E_COMIS,",
		  "      CD_TIP_INTERRUP_CESS_COMIS AS INTERRUP_COMIS,",
		  "      CD_MOT_INTERRUP_CESS_COMIS AS MOT_INTERRUP_COMIS,",
		  "      DT_INIC_INTERRUP_CESS_COMIS AS DTI_INTERRUP_COMIS,",
		  "      DT_FIM_INTERRUP_CESS_COMIS AS DTF_INTERRUP_COMIS,",
		  "      CD_MOT_AFAST_COMIS AS MOTIAFAS_COMIS,",
		  "      DT_INIC_MOT_AFAST_COMIS AS DTI_MOTIAFAS_COMIS,",
		  "      DT_FIM_MOT_AFAST_COMIS AS DTF_MOTIAFAS_COMIS,",
		  "      CD_MOT_LIC_COMIS AS MOTILICE_COMIS,",
		  "      DT_INIC_LIC_COMIS AS DTI_MOTILICE_COMIS,",
		  "      DT_FIM_LIC_COMIS AS DTF_MOTILICE_COMIS,",
		  "      CD_CARGO_FUNCAO_DESIGN AS CARGO_DESIGN,",
		  "      DT_INIC_DESIGN              ,",
		  "      CD_IDENT_REF_FAIXA_DESIGN AS REF_FAIXA_DESIGN,",
		  "      CD_IDENT_GRAU_NIV_DESIGN AS NIV_DESIGN,",
		  "      CD_UNID_ESC_CLASS_DESIGN AS UE_C_DESIGN,",
		  "      CD_UNID_ADM_CLASS_DESIGN AS UA_C_DESIGN,",
		  "      CD_MOT_SUBST_DESIGN         ,",
		  "      CD_TIP_INTERRUP_CESS_DESIGN ,",
		  "      CD_MOT_INTERRUP_CESS_DESIGN ,",
		  "      DT_INIC_INTERRUP_CESS_DESIGN,",
		  "      DT_FIM_INTERRUP_CESS_DESIGN ,",
		  "      CD_MOT_AFAST_DESIGN         ,",
		  "      DT_INIC_AFAST_DESIGN        ,",
		  "      DT_FIM_AFAST_DESIGN         ,",
		  "      CD_MOT_LIC_DESIGN           ,",
		  "      DT_INIC_LIC_DESIGN          ,",
		  "      DT_FIM_LIC_DESIGN           ,",
		  "      CD_IDENT_GRAU_NIV           ,",
		  "      CD_DIR_ENSI_ORG_CENTRAL     ,",
		  "      COD_CARGO                   ,",
		  "      COD_UNID_ADM                ",
		  "FROM CONTAGEH..TB_FUNCIONAL",
		  "WHERE CD_SIT_REG = 'A' -- A = ATIVO, E = EXCLUÍDO, F = falecido, 0 = erro, P CATEGORIA P, I = INATIVO, B = BLOQUEADO"
	  ],
	  "description": "CONTAGEH_TB_FUNCIONAL"
  },
  
