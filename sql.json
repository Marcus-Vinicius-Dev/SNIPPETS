// USECATALOG
"USECATALOG": {
	"scope": "sql",
	"prefix": "KZ_USECATALOG",
	"body": [
	  "USE CATALOG ${1:producao}"
	],
	"description": "USE_CATALOG"
  },
  
  // USESCHEMA
  "USESCHEMA": {
	"scope": "sql",
	"prefix": "KZ_USESQUEMA",
	"body": [
	  "USE SCHEMA ${1:nome_do_schema}"
	],
	"description": "USE_ESQUEMA"
  },
  
  // LISTCATALOGS
  "LISTCATALOGS": {
	"scope": "sql",
	"prefix": "KZ_LISTCATALOG",
