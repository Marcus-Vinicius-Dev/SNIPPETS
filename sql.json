	"prefix": "çrow_multiplo",
	"body": [
		"# ROWNUMBER MULTIPLO - EXEMPLO COM CHOR_MATTATHIAS",
		"# OBJETIVO: Para cada CPF e ESCOLA, pegar a primeira ocorrência",
		"coluna1 = '${1:CPF}'    # Primeira partição",
		"coluna2 = '${2:ESCOLA}' # Segunda partição",
		"print(Fore.GREEN + f\"\\n📊 ROW_NUMBER() OVER (PARTITION BY {coluna1}, {coluna2}):\")",
		"",
		"# Cria uma cópia para não alterar o df original",
		"df_rank = df.copy()",
		"",
		"# Adiciona colunas de rank para cada partition",
		"df_rank[f'RANK_{coluna1}'] = df_rank.groupby(coluna1).cumcount() + 1  # ROW_NUMBER por CPF",
		"df_rank[f'RANK_{coluna2}'] = df_rank.groupby(coluna2).cumcount() + 1  # ROW_NUMBER por ESCOLA",
		"",
		"# Filtra onde rank = 1 para qualquer uma das colunas",
		"df_filtrado = df_rank[(df_rank[f'RANK_{coluna1}'] == 1) | (df_rank[f'RANK_{coluna2}'] == 1)]",
		"",
		"print(Fore.WHITE + f\"   Total original: {len(df)} registros\")",
		"print(Fore.WHITE + f\"   Total filtrado: {len(df_filtrado)} registros\")",
		"print(Fore.CYAN + f\"\\n{df_filtrado[['NOME', 'CPF', 'ESCOLA', f'RANK_{coluna1}', f'RANK_{coluna2}']].head(10)}\")"
	],
