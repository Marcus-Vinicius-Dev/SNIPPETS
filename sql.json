},

// TIPO_DADOS_TABELA - VERSÃO MYSQL
"TIPO_DADOS_TABELA": {
	"scope": "sql",
	"prefix": "MYDDTIPO",
	"body": [
	  "${2:DESCRIBE ${1:nome_da_tabela}  -- MYSQL USA DESCRIBE EM VEZ DE sp_help}",
