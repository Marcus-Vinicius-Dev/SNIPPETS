	"description": "Soma total das contagens por grupo DO COUNT"
  },
  
  // FILTRARCARACTERESINICIOFIM
  "FILTRARCARACTERESINICIOFIM": {
	"scope": "sql",
	"prefix": "ZDDINICFIM",
	"body": [
	  "SELECT DISTINCT",
	  "      ${1:COLUNA}",
	  "FROM ${2:BASE}",
	  "WHERE UPPER(LEFT(${1:COLUNA}, 1)) IN (${3:'A','E','I','O','U'})  -- CARACTERES NO INICIO",
	  "  AND UPPER(RIGHT(${1:COLUNA}, 1)) IN (${4:'A','E','I','O','U'})  -- CARACTERES NO FINAL"
	],
	"description": "CARACTERES NO INICIO E CARACTERES NO FINAL"
  },
  
