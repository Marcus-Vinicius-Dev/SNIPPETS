// ROW_NUMBER_SEM_DUPLICATAS - VERSÃO MYSQL
"ROW_NUMBER_SEM_DUPLICATAS": {
	"scope": "sql",
	"prefix": "MYROW",
	"body": [
	  "$5WITH BASE_RANK${1:1} AS (",
	  "   --SELECT *",
	  "   --FROM BASE",
	  "),",
	  "RANK${2:1} AS (",
	  "   SELECT *,",
	  "      ROW_NUMBER() OVER (PARTITION BY ${3:CPF_DI} ORDER BY (SELECT NULL)) AS ROW${4:1} -- ROW_NUMBER FUNCIONA IGUAL NO MYSQL 8.0+",
	  "   FROM BASE_RANK${1:1}",
	  ")",
	  "SELECT *",
	  "FROM RANK${2:1}",
	  "WHERE ROW${4:1} = 1 -- PRIMEIRA LINHA DA DUPLICATA",
	  "ORDER BY ${3:CPF_DI}",
	  "-- OBS: MYSQL 8.0+ SUPORTA ROW_NUMBER() OVER()"
	],
	"description": "ROW_NUMBER - VERSAO MYSQL"
},

// ROW_NUMBER_MULTIPLO - VERSÃO MYSQL
"ROW_NUMBER_MULTIPLO": {
	"scope": "sql",
	"prefix": "MYROWMULT",
	"body": [
	  "$6WITH BASE_RANK${1:1} AS (",
	  "   --SELECT *",
	  "   --FROM BASE",
	  "),",
	  "RANK${2:1} AS (",
	  "   SELECT *,",
	  "      ROW_NUMBER() OVER (PARTITION BY ${3:coluna1} ORDER BY (SELECT NULL)) AS RANK_${3:coluna1}, -- ROW_NUMBER FUNCIONA NO MYSQL 8.0+",
	  "      ROW_NUMBER() OVER (PARTITION BY ${4:coluna2} ORDER BY (SELECT NULL)) AS RANK_${4:coluna2}",
	  "   FROM BASE_RANK${1:1}",
	  ")",
	  "SELECT *",
	  "INTO ${5:BASE_SEM_DUPLICIDADE}",
	  "FROM RANK${2:1}",
	  "WHERE RANK_${3:coluna1} = 1   -- Primeira linha de cada DADO DA COLUNA ${3:coluna1}",
	  "   OR RANK_${4:coluna2} = 1   -- Primeira linha de cada DADO DA COLUNA ${4:coluna2}",
	  "ORDER BY ${3:CPF_DI}",
	  "-- OBS: MySQL 8.0+ suporta ROW_NUMBER() igual ao T-SQL"
	],
	"description": "FILTRO DUPLO EM LISTA UNICA - VERSAO MYSQL"
},

// EXTRAI_TEMPO - VERSÃO MYSQL
"EXTRAI_TEMPO": {
	"scope": "sql",
	"prefix": "MYDDTEMP",
	"body": [
	  "YEAR(A.create_date) AS ANO_TABELA,  -- MYSQL USA YEAR() IGUAL AO T-SQL",
	  "MONTH(A.create_date) AS MES_TABELA,  -- MONTH() IGUAL AO T-SQL",
	  "DAY(A.create_date) AS DIA_TABELA,  -- DAY() IGUAL AO T-SQL",
	  "HOUR(A.create_date) AS HORA_TABELA,  -- MYSQL USA HOUR() EM VEZ DE DATEPART(HOUR)",
	  "MINUTE(A.create_date) AS MINUTO_TABELA,  -- MINUTE() EM VEZ DE DATEPART(MINUTE)",
	  "SECOND(A.create_date) AS SEGUNDOS_TABELA  -- SECOND() EM VEZ DE DATEPART(SECOND)",
	  "-- OBS: MYSQL USA HOUR(), MINUTE(), SECOND() EM VEZ DE DATEPART()"
	],
	"description": "EXTRAI REGISTROS DE TEMPOS COMPOSTOS DD/MM/YYYY HH:MM:SS - VERSAO MYSQL"
},

// COLA_DE_DADOS - VERSÃO MYSQL
"COLA_DE_DADOS": {
	"scope": "sql",
	"prefix": "MYCOLADATA",
	"body": [
	  "/*",
	  "REGRAS DE BOAS PRATICAS:",
	  "  - VARCHAR para textos (a menos que precise de Unicode)",
	  "  - Tipos numericos para numeros (nunca guarde numeros em VARCHAR)",
	  "  - Tipos de data para datas (nunca guarde datas em texto)",
	  "  - Evite MAX a menos que necessario (indices nao funcionam bem)",
	  "",
	  "TIPO          |                                        | OCUPACAO       | EXEMPLO DE USO                 | O QUE ARMAZENA",
	  "--------------|----------------------------------------|----------------|--------------------------------|-------------------------------",
	  "BIT 0 ou 1                                             | 1 byte         | ativo BIT DEFAULT 1            | 1 (verdadeiro), 0 (falso)",
	  "TINYINT(0 a 255)                                       | 1 byte         | idade TINYINT                  | 25, 0, 255",
	  "INT(-2,1Bi a 2,1Bi)                                    | 4 bytes        | id INT AUTO_INCREMENT          | 1, 999, -4587",
	  "DECIMAL(p,s) Até 38 digitos                            | 5-17 bytes     | salario DECIMAL(10,2)          | 12345.67, -999.99",
	  "NUMERIC(p,s) Mesmo que DECIMAL                         | 5-17 bytes     | nota NUMERIC(4,2)              | 9.75, 7.50",
	  "FLOAT(-1.79E+308 a 1.79E+308)                          | 4 ou 8 bytes   | temperatura FLOAT              | 23.56789, -15.3",
	  "CHAR(1 a 255) Fixo                                     | n bytes        | uf CHAR(2)                     | 'SP', 'RJ', 'MG'",
	  "VARCHAR(1-65535) Variável                              | tam + 1 byte   | nome VARCHAR(100)              | 'Joao Silva', 'Ana'",
	  "VARCHAR(MAX) Até 2GB                                   | tam + 2 bytes  | observacao TEXT                | Textos longos",
	  "TEXT Até 65535 caracteres                              | tam + 2 bytes  | descricao TEXT                 | 'Texto longo...'",
	  "LONGTEXT Até 4GB                                      | tam + 4 bytes  | comentario LONGTEXT            | Textos muito longos",
	  "DATE do tipo 1000-01-01 a 9999-12-31                   | 3 bytes        | data_nascimento DATE           | '1990-05-15'",
	  "TIME do tipo -838:59:59 a 838:59:59                    | 3 bytes        | hora_entrada TIME              | '14:30:00'",
	  "DATETIME do tipo 1000-01-01 a 9999-12-31               | 8 bytes        | data_cadastro DATETIME         | '2024-03-19 15:45:30'",
	  "TIMESTAMP do tipo 1970-01-01 a 2038-01-19              | 4 bytes        | data_atualizacao TIMESTAMP     | '2024-03-19 15:45:30'",
	  "*/",
	  "-- OBS: MYSQL USA AUTO_INCREMENT EM VEZ DE IDENTITY",
	  "-- MYSQL NAO TEM MONEY (USE DECIMAL(19,4))",
	  "-- MYSQL NAO TEM NCHAR/NVARCHAR (USE CHAR/VARCHAR COM COLLATE utf8mb4)"
	],
	"description": "Cola de tipos de dados - VERSAO MYSQL"
},

// ID_PRIMRIRA_VEZ - VERSÃO MYSQL
"ID_PRIMRIRA_VEZ": {
	"scope": "sql",
	"prefix": "MYID",
	"body": [
	  "${1:ID INT AUTO_INCREMENT PRIMARY KEY  -- MYSQL USA AUTO_INCREMENT EM VEZ DE IDENTITY}"
	],
	"description": "ID_PRIMRIRA_VEZ - VERSAO MYSQL"
},

// ID_ACRESCENTADO_EM_COLUNA - VERSÃO MYSQL
"ID_ACRESCENTADO_EM_COLUNA": {
	"scope": "sql",
	"prefix": "MYID+",
	"body": [
	  "ALTER TABLE ${1:tabela}",
	  "ADD ID INT AUTO_INCREMENT PRIMARY KEY  -- MYSQL USA AUTO_INCREMENT",
	  "-- OBS: MYSQL SO PERMITE UM AUTO_INCREMENT POR TABELA"
	],
	"description": "ACRESCENTA COLUNA ID COM PRIMARY KEY - VERSAO MYSQL"
},

// CRIAR_TABELA - VERSÃO MYSQL
"CRIAR_TABELA": {
	"scope": "sql",
	"prefix": "MYCRIARTAB",
	"body": [
	  "$12DROP TABLE IF EXISTS ${1:BASE}  -- DROP TABLE IF EXISTS FUNCIONA NO MYSQL",
	  "CREATE TABLE ${1:BASE} (",
	  "    ${2:COLUNA1} VARCHAR(${3:100}),",
	  "    ${4:COLUNA2} VARCHAR(${5:100})",
	  ") ENGINE=InnoDB DEFAULT CHARSET=utf8mb4  -- ENGINE E CHARSET RECOMENDADOS",
	  " ",
	  "INSERT INTO ${1:BASE} (${2:COLUNA1}, ${4:COLUNA2}) VALUES",
	  "('${6:DADO}', '${7:DADO}'),",
	  "('${8:DADO}', '${9:DADO}'),",
	  "('${10:DADO}', '${11:DADO}')",
	  "-- OBS: MYSQL ACEITA INSERT MULTIPLO IGUAL AO T-SQL"
	],
	"description": "CRIAR_TABELA - VERSAO MYSQL"
},

// CRIAR_COLUNA - VERSÃO MYSQL
"CRIAR_COLUNA": {
	"scope": "sql",
	"prefix": "MYCRIARCOL",
	"body": [
	  "ALTER TABLE ${1:nome_da_tabela}",
	  "    ADD  ${2:coluna1} VARCHAR(${3:100}) NULL,  -- MYSQL USA VARCHAR EM VEZ DE NVARCHAR",
	  "    ADD  ${4:coluna2} VARCHAR(${5:100}) NULL   -- PARA UNICODE USE CHAR SET utf8mb4",
	  "-- OBS: MYSQL NAO TEM NVARCHAR, USE VARCHAR COM utf8mb4"
	],
	"description": "CRIAR_COLUNA - VERSAO MYSQL"
},

// DROP_TABLE - VERSÃO MYSQL
"DROP_TABLE": {
	"scope": "sql",
	"prefix": "MYDROP",
	"body": [
	  "${2:DROP TABLE IF EXISTS ${1:#BASE}  -- DROP TABLE IF EXISTS FUNCIONA NO MYSQL}",
	  "-- OBS: MYSQL NAO USA # PARA TABELAS TEMPORARIAS, USE TEMPORARY TABLE"
	],
	"description": "DROP TABLE IF EXISTS - VERSAO MYSQL"
},

// EXCLUIR_COLUNA - VERSÃO MYSQL
"EXCLUIR_COLUNA": {
	"scope": "sql",
	"prefix": "MYEXCLCOL",
	"body": [
	  "ALTER TABLE ${1:tabela}",
	  "DROP COLUMN ${2:coluna1}, ${3:coluna2}  -- MYSQL PERMITE DROP DE MULTIPLAS COLUNAS"
	],
	"description": "EXCLUIR_COLUNA - VERSAO MYSQL"
},

// EXCLUIR_LINHAS_NULL - VERSÃO MYSQL
"EXCLUIR_LINHAS_NULL": {
	"scope": "sql",
	"prefix": "MYEXCLLINULL",
	"body": [
	  "DELETE FROM ${1:tabela}",
	  "WHERE ${2:coluna1} IS NULL",
	  "   AND ${3:coluna2} IS NULL",
	  "   AND ${4:coluna3} IS NULL"
	],
	"description": "EXCLUIR_LINHAS_NULL - VERSAO MYSQL"
},

// COUNT - VERSÃO MYSQL
"COUNT": {
	"scope": "sql",
	"prefix": "MYCOUNT",
	"body": [
	  "COUNT(${1:CPF+DI}) AS ${2:TOTAL} ${3:-- SUM(* OU COLUNA), AVG(* OU COLUNA), MAX(* OU COLUNA), MIN(* OU COLUNA) VEJA MAIS EM MYGROUP}",
	  "-- OBS: FUNCOES DE AGREGACAO FUNCIONAM IGUAL NO MYSQL"
	],
	"description": "CONTAR E AGRUPAR - VERSAO MYSQL"
},

// GROUP_BY - VERSÃO MYSQL
"GROUP_BY": {
	"scope": "sql",
	"prefix": "MYGROUP",
	"body": [
	  "$3GROUP BY ${1:COLUNA1}",
	  "${2:ORDER BY TOTAL DESC}",
	  "-- OBS: GROUP BY FUNCIONA IGUAL NO MYSQL"
	],
	"description": "GROUP_BY - VERSAO MYSQL"
},

// HAVING - VERSÃO MYSQL
"HAVING": {
	"scope": "sql",
	"prefix": "MYCOUNTHAVING",
	"body": [
	  "HAVING ${1:COUNT(*) > 10 } -- FILTRAR APOS O GROUP BY COM COUNT",
	  "   ${2:AND AVG(preco) > 50}",
	  "${3:ORDER BY TOTAL DESC}",
	  "-- OBS: HAVING FUNCIONA IGUAL NO MYSQL"
	],
	"description": "HAVING = FILTRAR APOS O GROUP BY - VERSAO MYSQL"
},
  
// NULL - VERSÃO MYSQL
"NULL": {
	"scope": "sql",
	"prefix": "MYNULL",
	"body": [
	"IFNULL(${1:COLUNA},'') AS ${2:NOVO_NOME1},  -- MYSQL USA IFNULL EM VEZ DE ISNULL"
	],
	"description": "NULL - VERSAO MYSQL"
},

// NULIFICA - VERSÃO MYSQL
"NULIFICA": {
	"scope": "sql",
	"prefix": "MYNULLIF",
	"body": [
	  "SELECT NULLIF(${1:COLUNA}, 25) AS SEM_25  -- NULLIF FUNCIONA IGUAL NO MYSQL"
	],
	"description": "NULIFICA - VERSAO MYSQL"
},

// COALESCE - VERSÃO MYSQL
"COALESCE": {
	"scope": "sql",
	"prefix": "MYCOAL",
	"body": [
	  "COALESCE(${1:COLUNA}, '') AS ${1:COLUNA}  -- COALESCE FUNCIONA IGUAL NO MYSQL"
	],
	"description": "COALESCE NULIFICANDO - VERSAO MYSQL"
},

// COALESCE_SEM_NULOS - VERSÃO MYSQL
"COALESCE_SEM_NULOS": {
	"scope": "sql",
	"prefix": "MYCOALNULLIF",
	"body": [
	  "COALESCE(NULLIF(${1:COLUNA1}, ''), ${2:COLUNA2}, '') AS ${3:NOVO_NOME},  -- COALESCE E NULLIF FUNCIONAM IGUAL NO MYSQL"
	],
	"description": "COALESCE com NULLIF para NOME, fallback para NOME_SERVIDOR e vazio - VERSAO MYSQL"
},

// QUANTIDADE_DE_CARACTERES - VERSÃO MYSQL
"QUANTIDADE_DE_CARACTERES": {
	"scope": "sql",
	"prefix": "MYDDQTDBYTE",
	"body": [
	  "CHAR_LENGTH(${1:coluna1}) AS CARACTERES,  -- MYSQL USA CHAR_LENGTH (CONTA CARACTERES) EM VEZ DE DATALENGTH (CONTA BYTES)",
	  "LENGTH(${1:coluna1}) AS BYTES  -- LENGTH CONTA BYTES (EQUIVALENTE AO DATALENGTH)"
	],
	"description": "CONTA A QUANTIDADE DE CARACTERES - VERSAO MYSQL"
},

// RENOMEAR_TABELA - VERSÃO MYSQL
"RENOMEAR_TABELA": {
	"scope": "sql",
	"prefix": "MYRENTAB",
	"body": [
	  "RENAME TABLE ${1:nome_atual} TO ${2:novo_nome}  -- MYSQL USA RENAME TABLE EM VEZ DE sp_rename"
	],
	"description": "RENOMEIA TABELA - VERSAO MYSQL"
},

// BACKUP_DA_TABELA - VERSÃO MYSQL
"BACKUP_DA_TABELA": {
	"scope": "sql",
	"prefix": "MYBKPTAB",
	"body": [
	  "CREATE TABLE BKP AS  -- MYSQL USA CREATE TABLE ... AS PARA BACKUP",
	  "SELECT *",
	  "FROM ${1:BD}  -- DEPOIS INSERT INTO BD_BKP SELECT * FROM BKP"
	],
	"description": "BACKUP_DA_TABELA - VERSAO MYSQL"
},

// BACKUP_DE_BD - VERSÃO MYSQL
"BACKUP_DE_BD": {
	"scope": "sql",
	"prefix": "MYBKPBD",
	"body": [
	  "-- MYSQL NAO TEM BACKUP DATABASE VIA SQL (FAZ-SE VIA MYSQLDUMP NO TERMINAL)",
