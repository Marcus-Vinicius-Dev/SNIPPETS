  // BRONZEALUNOPRESENCA
  "BRONZEALUNOPRESENCA": {
	"scope": "sql",
	"prefix": "KB_ALUNOPRESENTE",
	"body": [
	  "SELECT ",
	  "        MUNICIPIO,",
	  "        DISTRITO,",
