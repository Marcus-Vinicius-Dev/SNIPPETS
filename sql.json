			"# 1. CHAMAR O EXCEL",
			"# ============================================================",
			"if excel == '1':",
			"    dados = ler_excel()",
			"    print(Fore.GREEN + f\"\\n✅ {len(dados)} RGs carregados do Excel!\")",
			"else:",
			"    dados = ['${1:179874871}']",
			"    print(Fore.YELLOW + f\"\\n⚠️ Usando RG de exemplo: {dados[0]}\")",
			"",
			"# ============================================================",
			"# 2. CHAMAR teste_rg() (FORA DO IF/ELSE) RELACIONANDO A EXCEL",
