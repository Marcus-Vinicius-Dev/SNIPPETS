  // CONTAGEH_TB_FUNCIONAL 
  "CONTAGEH_TB_FUNCIONAL": {
	  "scope": "sql",
	  "prefix": "ZCONTTBFUNC",
	  "body": [
		  "SELECT",
		  "      NR_CPF AS CPF               ,",
		  "      NR_DI AS DI                 ,",
		  "      CONCAT(NR_CPF, NR_DI) AS CPF_DI,",
		  "      NR_RG AS RG                 ,",
