  // Z00CTG
"Z00CTG": {
	"scope": "sql",
	"prefix": "Z00CTG",
	"body": [
	  "---------------------------------------------------------------------------------- DATAS ----------------------------------------------------------------------------------",
	  "",
	  "-- ${1:05}26",
	  "-- [${1:05}2026]",
	  "",
	  "USE CEPEA_SAS",
	  "",
	  "---------------------------------------------------------------------------------- BASES ----------------------------------------------------------------------------------",
	  "",
	  "DROP TABLE IF EXISTS #ARQ",
	  "DROP TABLE IF EXISTS #ID",
	  "DROP TABLE IF EXISTS #CARGO",
	  "DROP TABLE IF EXISTS #DISC",
	  "DROP TABLE IF EXISTS #BFE",
	  "DROP TABLE IF EXISTS #FUNC",
	  "DROP TABLE IF EXISTS #TB_EVENT",
	  "DROP TABLE IF EXISTS #NIVEL",
	  "DROP TABLE IF EXISTS #PESSOAL",
	  "",
	  "SELECT * INTO #ARQ FROM ARQDEUA${1:05}26",
	  "SELECT * INTO #ID FROM TB_ID_INTERNO_SERV",
	  "SELECT * INTO #CARGO FROM TAB_CARGO${1:05}26",
	  "SELECT * INTO #DISC FROM DESENV.DBO.DISCIPLINA",
	  "SELECT * INTO #BFE FROM TAB_CODBFE",
	  "SELECT * INTO #FUNC FROM SAS.[${1:05}2026].TB_FUNCIONAL",
	  "SELECT * INTO #TB_EVENT FROM CONTAGEH.dbo.TB_TIPO_EVENTO",
	  "SELECT * INTO #NIVEL FROM NIVEL_FORMACAO${1:05}26",
	  "SELECT * INTO #PESSOAL FROM SAS.[${1:05}2026].TB_PESSOAL",
	  "",
	  "---------------------------------------------------------------------------------- #00_JOIN ----------------------------------------------------------------------------------",
	  "",
	  "DROP TABLE IF EXISTS #00_JOIN",
	  "SELECT",
	  "     COALESCE(B.REGIAO, '') AS REGIAO_C,",
	  "     COALESCE(B.NOMEDE, '') AS URE_C,",
	  "     COALESCE(A.CODUA_C, '0') AS CODUA_C,",
	  "     COALESCE(B.NOMEUA, '') AS NOMEUA_C,",
	  "     COALESCE(A.CPF, '0') AS CPF,",
	  "     COALESCE(A.DI, '0') AS DI,",
	  "     COALESCE(CONCAT(A.CPF, A.DI), '0') AS CPF_DI,",
	  "     COALESCE(D.ID, '0') AS ID,",
	  "     COALESCE(A.NOME, '') AS NOME_SERVIDOR,",
	  "     COALESCE(N.NM_PESSOA_SOCIAL, '') AS NOME_SOCIAL,",
	  "     COALESCE(A.CARGO_C, '0') AS CARGO_C,",
	  "     COALESCE(E.NM_CARGO, '') AS NM_CARGO_C,",
	  "     COALESCE(CONCAT(A.CARGO_C, ' - ', E.NM_CARGO), '') AS CARGO_C_DESC,",
	  "     COALESCE(A.CATEG_C, '') AS CATEG_C,",
	  "     COALESCE(A.CATEG_C_DESC, '') AS CATEG_C_DESC,",
	  "     COALESCE(E.NM_QUADRO, '') AS QUADRO_C,",
	  "     COALESCE(",
	  "         CASE",
	  "             WHEN E.NM_QUADRO = 'QM' THEN 'QM - QUADRO DO MAGISTERIO'",
	  "             WHEN E.NM_QUADRO = 'QAE' THEN 'QAE - QUADRO DE APOIO ESCOLAR'",
	  "             WHEN E.NM_QUADRO = 'QSE' THEN 'QSE - QUADRO DA SECRETARIA DA EDUCACAO'",
	  "             ELSE E.NM_QUADRO",
	  "         END,",
	  "         ''",
	  "     ) AS NM_QUADRO_C,",
	  "     COALESCE(A.FAIXA_C, '') AS FAIXA_C,",
	  "     COALESCE(A.NIVEL_C, '') AS NIVEL_C,",
	  "     COALESCE(A.FAIXA_NIVEL_C, '') AS FAIXA_NIVEL_C,",
	  "     COALESCE(B.NOMEMUN, '') AS MUNICIPIO_C,",
	  "     COALESCE(",
	  "         CONVERT(VARCHAR(10), TRY_CAST(A.DTIEXER_C AS DATE), 120),",
	  "         ''",
	  "     ) AS DTIEXER_C,",
	  "     COALESCE(",
	  "         CONVERT(VARCHAR(10), TRY_CAST(A.DTIEXER_C AS DATE), 103),",
	  "         ''",
	  "     ) AS DTIEXER_C_CONV,",
	  "     COALESCE(A.ANOSTRAB_C, '0') AS ANOSTRAB_C,",
	  "     COALESCE(C.REGIAO, '') AS REGIAO_E,",
	  "     COALESCE(C.NOMEDE, '') AS URE_E,",
	  "     COALESCE(A.CODUA_E, '0') AS CODUA_E,",
	  "     COALESCE(C.NOMEUA, '') AS NOMEUA_E,",
	  "     COALESCE(A.CARGO_E, '0') AS CARGO_E,",
	  "     COALESCE(F.NM_CARGO, '') AS NM_CARGO_E,",
	  "     COALESCE(CONCAT(A.CARGO_E, ' - ', F.NM_CARGO), '') AS CARGO_E_DESC,",
	  "     COALESCE(A.CATEG_E, '') AS CATEG_E,",
	  "     COALESCE(A.CATEG_E_DESC, '') AS CATEG_E_DESC,",
	  "     COALESCE(F.NM_QUADRO, '') AS QUADRO_E,",
	  "     COALESCE(",
	  "         CASE",
	  "             WHEN F.NM_QUADRO = 'QM' THEN 'QM - QUADRO DO MAGISTERIO'",
	  "             WHEN F.NM_QUADRO = 'QAE' THEN 'QAE - QUADRO DE APOIO ESCOLAR'",
	  "             WHEN F.NM_QUADRO = 'QSE' THEN 'QSE - QUADRO DA SECRETARIA DA EDUCACAO'",
	  "             ELSE F.NM_QUADRO",
	  "         END,",
	  "         ''",
	  "     ) AS NM_QUADRO_E,",
	  "     COALESCE(A.FAIXA_E, '') AS FAIXA_E,",
	  "     COALESCE(A.NIVEL_E, '') AS NIVEL_E,",
	  "     COALESCE(A.FAIXA_NIVEL_E, '') AS FAIXA_NIVEL_E,",
	  "     COALESCE(C.NOMEMUN, '') AS MUNICIPIO_E,",
	  "     COALESCE(",
	  "         CONVERT(VARCHAR(10), TRY_CAST(A.DTIEXER_E AS DATE), 120),",
	  "         ''",
	  "     ) AS DTIEXER_E,",
	  "     COALESCE(",
	  "         CONVERT(VARCHAR(10), TRY_CAST(A.DTIEXER_E AS DATE), 103),",
	  "         ''",
	  "     ) AS DTIEXER_E_CONV,",
	  "     COALESCE(A.ANOSTRAB_E, '0') AS ANOSTRAB_E,",
	  "     COALESCE(A.CARFUNCO, '') AS CARFUNCO,",
	  "     COALESCE(",
	  "         CONVERT(VARCHAR(10), TRY_CAST(A.DT_SITREG AS DATE), 120),",
	  "         ''",
	  "     ) AS DT_SITREG,",
	  "     COALESCE(",
	  "         CONVERT(VARCHAR(10), TRY_CAST(A.DT_SITREG AS DATE), 103),",
	  "         ''",
	  "     ) AS DT_SITREG_CONV,",
	  "     COALESCE(",
	  "         CONVERT(VARCHAR(10), TRY_CAST(A.DTPOSSE_C AS DATE), 120),",
	  "         ''",
	  "     ) AS DTPOSSE_C,",
	  "     COALESCE(",
	  "         CONVERT(VARCHAR(10), TRY_CAST(A.DTPOSSE_C AS DATE), 103),",
	  "         ''",
	  "     ) AS DTPOSSE_C_CONV,",
	  "     COALESCE(",
	  "         CONVERT(VARCHAR(10), TRY_CAST(A.DTPOSSE_E AS DATE), 120),",
	  "         ''",
	  "     ) AS DTPOSSE_E,",
	  "     COALESCE(",
	  "         CONVERT(VARCHAR(10), TRY_CAST(A.DTPOSSE_E AS DATE), 103),",
	  "         ''",
	  "     ) AS DTPOSSE_E_CONV,",
	  "     COALESCE(A.SITESP, '') AS SITESP,",
	  "     COALESCE(A.MOTIAFAS, '0') AS MOTIAFAS,",
	  "     COALESCE(H.EVENTO, '') AS EVENTO_AFAS,",
	  "     COALESCE(CONCAT(A.MOTIAFAS, ' - ', H.EVENTO), '') AS MOTIAFAS_DESC,",
	  "     COALESCE(A.MOTLICE, '0') AS MOTLICE,",
	  "     COALESCE(I.EVENTO, '') AS EVENTO_LICE,",
	  "     COALESCE(CONCAT(A.MOTLICE, ' - ', I.EVENTO), '') AS MOTLICE_DESC,",
	  "     COALESCE(J.CD_TIP_INTERRUP_CESS_TIT, '0') AS TIPO_INTERRUP,",
	  "     COALESCE(K.NM_TIP_EVE, '') AS NM_TIP_EVE,",
	  "     COALESCE(J.CD_MOT_INTERRUP_CESS_TIT, '') AS MOT_INTERRUP,",
	  "     COALESCE(L.EVENTO, '') AS EVENTO_INTERRUP,",
	  "     COALESCE(CONCAT(J.CD_MOT_INTERRUP_CESS_TIT, ' - ', L.EVENTO), '') AS MOT_INTERRUP_DESC,",
	  "     COALESCE(",
	  "         CONVERT(VARCHAR(10), TRY_CAST(A.DTISESP AS DATE), 120),",
	  "         ''",
	  "     ) AS DTISESP,",
	  "     COALESCE(",
	  "         CONVERT(VARCHAR(10), TRY_CAST(A.DTISESP AS DATE), 103),",
	  "         ''",
	  "     ) AS DTISESP_CONV,",
	  "     COALESCE(",
	  "         CONVERT(VARCHAR(10), TRY_CAST(A.DTIINTE AS DATE), 120),",
	  "         ''",
	  "     ) AS DTIINTE,",
	  "     COALESCE(",
	  "         CONVERT(VARCHAR(10), TRY_CAST(A.DTIINTE AS DATE), 103),",
	  "         ''",
	  "     ) AS DTIINTE_CONV,",
	  "     COALESCE(",
	  "         CONVERT(VARCHAR(10), TRY_CAST(A.DTFINTE AS DATE), 120),",
	  "         ''",
	  "     ) AS DTFINTE,",
	  "     COALESCE(",
	  "         CONVERT(VARCHAR(10), TRY_CAST(A.DTFINTE AS DATE), 103),",
	  "         ''",
	  "     ) AS DTFINTE_CONV,",
	  "     COALESCE(",
	  "         CONVERT(VARCHAR(10), TRY_CAST(A.DTIAFAS AS DATE), 120),",
	  "         ''",
	  "     ) AS DTIAFAS,",
	  "     COALESCE(",
	  "         CONVERT(VARCHAR(10), TRY_CAST(A.DTIAFAS AS DATE), 103),",
	  "         ''",
	  "     ) AS DTIAFAS_CONV,",
	  "     COALESCE(",
	  "         CONVERT(VARCHAR(10), TRY_CAST(A.DTFAFAS AS DATE), 120),",
	  "         ''",
	  "     ) AS DTFAFAS,",
	  "     COALESCE(",
	  "         CONVERT(VARCHAR(10), TRY_CAST(A.DTFAFAS AS DATE), 103),",
	  "         ''",
	  "     ) AS DTFAFAS_CONV,",
	  "     COALESCE(",
	  "         CONVERT(VARCHAR(10), TRY_CAST(A.DTILICE AS DATE), 120),",
	  "         ''",
	  "     ) AS DTILICE,",
	  "     COALESCE(",
	  "         CONVERT(VARCHAR(10), TRY_CAST(A.DTILICE AS DATE), 103),",
	  "         ''",
	  "     ) AS DTILICE_CONV,",
	  "     COALESCE(",
	  "         CONVERT(VARCHAR(10), TRY_CAST(A.DTFLICE AS DATE), 120),",
	  "         ''",
	  "     ) AS DTFLICE,",
	  "     COALESCE(",
	  "         CONVERT(VARCHAR(10), TRY_CAST(A.DTFLICE AS DATE), 103),",
	  "         ''",
	  "     ) AS DTFLICE_CONV,",
	  "     COALESCE(",
	  "         CONVERT(VARCHAR(10), TRY_CAST(J.DT_INIC_INTERRUP_CESS_TIT AS DATE), 120),",
	  "         ''",
	  "     ) AS DTI_INTERRUP,",
	  "     COALESCE(",
	  "         CONVERT(VARCHAR(10), TRY_CAST(J.DT_INIC_INTERRUP_CESS_TIT AS DATE), 103),",
	  "         ''",
	  "     ) AS DTI_INTERRUP_CONV,",
	  "     COALESCE(",
	  "         CONVERT(VARCHAR(10), TRY_CAST(J.DT_FIM_INTERRUP_CESS_TIT AS DATE), 120),",
	  "         ''",
	  "     ) AS DTF_INTERRUP,",
	  "     COALESCE(",
	  "         CONVERT(VARCHAR(10), TRY_CAST(J.DT_FIM_INTERRUP_CESS_TIT AS DATE), 103),",
	  "         ''",
	  "     ) AS DTF_INTERRUP_CONV,",
	  "     COALESCE(",
	  "         CONVERT(VARCHAR(10), TRY_CAST(A.DTIEXCO AS DATE), 120),",
	  "         ''",
	  "     ) AS DTIEXCO,",
	  "     COALESCE(",
	  "         CONVERT(VARCHAR(10), TRY_CAST(A.DTIEXCO AS DATE), 103),",
	  "         ''",
	  "     ) AS DTIEXCO_CONV,",
	  "     COALESCE(",
	  "         CONVERT(VARCHAR(10), TRY_CAST(A.DTIDESIG AS DATE), 120),",
	  "         ''",
	  "     ) AS DTIDESIG,",
	  "     COALESCE(",
	  "         CONVERT(VARCHAR(10), TRY_CAST(A.DTIDESIG AS DATE), 103),",
	  "         ''",
	  "     ) AS DTIDESIG_CONV,",
	  "     COALESCE(A.SITREG, '') AS SITREG,",
	  "     COALESCE(A.QTQUINQ, '0') AS QTQUINQ,",
	  "     COALESCE(",
	  "         CONVERT(VARCHAR(10), TRY_CAST(A.DTQUINQ AS DATE), 120),",
	  "         ''",
	  "     ) AS DTQUINQ,",
	  "     COALESCE(",
	  "         CONVERT(VARCHAR(10), TRY_CAST(A.DTQUINQ AS DATE), 103),",
	  "         ''",
	  "     ) AS DTQUINQ_CONV,",
	  "     COALESCE(A.QUALIF, '') AS QUALIF,",
	  "     COALESCE(A.CLDISC, '0') AS CLDISC,",
	  "     COALESCE(G.NOME_DISCIPLINA, '') AS NOME_DISCIPLINA,",
	  "     COALESCE(A.SITVINC, '') AS SITVINC,",
	  "     COALESCE(A.SITVINCO, '') AS SITVINCO,",
	  "     COALESCE(A.SITVINDE, '') AS SITVINDE,",
	  "     COALESCE(A.RG, '0') AS RG,",
	  "     COALESCE(A.RG12, '0') AS RG12,",
	  "     COALESCE(A.RG11, '0') AS RG11,",
	  "     COALESCE(A.UFRG, '') AS UFRG,",
	  "     COALESCE(N.ID_ORG_EMIS_RG, '') AS ORG_EMIS_RG ,",
	  "     COALESCE(",
	  "         CONVERT(VARCHAR(10), TRY_CAST(N.DT_EMIS_RG AS DATE), 120),",
	  "         ''",
	  "     ) AS DT_EMIS_RG,",
	  "     COALESCE(",
	  "         CONVERT(VARCHAR(10), TRY_CAST(N.DT_EMIS_RG AS DATE), 103),",
	  "         ''",
	  "     ) AS DT_EMIS_RG_CONV,",
	  "     COALESCE(A.RS, '0') AS RS,",
	  "     COALESCE(A.PV, '0') AS PV,",
	  "     COALESCE(CONCAT(A.RS, ' - ', A.PV), '0') AS RSPV,",
	  "     COALESCE(A.COD_BANCO, '0') AS COD_BANCO,",
	  "     COALESCE(A.COD_AGENCIA, '0') AS COD_AGENCIA,",
	  "     COALESCE(A.TP_CONTA, '0') AS TP_CONTA,",
	  "     COALESCE(A.NUM_CONTA, '0') AS NUM_CONTA,",
	  "     COALESCE(A.CD_VERIF, '0') AS CD_VERIF,",
	  "     COALESCE(A.TIPO_DESIG, '0') AS TIPO_DESIG,",
	  "     COALESCE(",
	  "         CASE",
	  "             WHEN A.JORNADA = 'A' THEN 'A - AMPLIADA (32)'",
	  "             WHEN A.JORNADA = 'B' THEN 'B - BÁSICA (25)'",
	  "             WHEN A.JORNADA = 'C' THEN 'C - COMPLETA (20)'",
	  "             WHEN A.JORNADA = 'L' THEN 'L - COMPLETA (20) - NOVA CARREIRA'",
	  "             WHEN A.JORNADA = 'I' THEN 'I - INTEGRAL (33)'",
	  "             WHEN A.JORNADA = 'R' THEN 'R - REDUZIDA (10)'",
	  "             ELSE A.JORNADA",
	  "         END,",
	  "         ''",
	  "     ) AS JORNADA,",
	  "     COALESCE(A.EMAIL, '') AS EMAIL,",
	  "     COALESCE(A.EMAIL_INST1, '') AS EMAIL_INST1,",
	  "     COALESCE(A.EMAIL_INST2, '') AS EMAIL_INST2,",
	  "     COALESCE(A.SEXO, '') AS SEXO,",
	  "     COALESCE(",
	  "         CONVERT(VARCHAR(10), TRY_CAST(A.DTNASC AS DATE), 120),",
	  "         ''",
	  "     ) AS DTNASC,",
	  "     COALESCE(",
	  "         CONVERT(VARCHAR(10), TRY_CAST(A.DTNASC AS DATE), 103),",
	  "         ''",
	  "     ) AS DTNASC_CONV,",
	  "     COALESCE(A.IDADE, '0') AS IDADE,",
	  "     COALESCE(A.GRAUESCO, '0') AS GRAUESCO,",
	  "     COALESCE(A.SITESCO, '') AS SITESCO,",
	  "     COALESCE(",
	  "         CASE",
	  "             WHEN A.ESTCIVIL = 'A' THEN 'A - SEPARADO JUDICIALMENTE'",
	  "             WHEN A.ESTCIVIL = 'C' THEN 'C - CASADO'",
	  "             WHEN A.ESTCIVIL = 'D' THEN 'D - DESQUITADO'",
	  "             WHEN A.ESTCIVIL = 'E' THEN 'E - UNIÃO ESTÁVEL'",
	  "             WHEN A.ESTCIVIL = 'H' THEN 'H - UNIÃO ESTÁVEL HOMOAFETIVA'",
	  "             WHEN A.ESTCIVIL = 'R' THEN 'R - DIVORCIADO'",
	  "             WHEN A.ESTCIVIL = 'S' THEN 'S - SOLTEIRO'",
	  "             WHEN A.ESTCIVIL = 'U' THEN 'U - ERRO'",
	  "             WHEN A.ESTCIVIL = 'V' THEN 'V - VIUVO'",
	  "             ELSE A.ESTCIVIL",
	  "         END,",
	  "         ''",
	  "     ) AS ESTCIVIL,",
	  "     COALESCE(N.QT_DEP_IR, '0') AS QT_DEP_IR ,",
	  "     COALESCE(N.QT_DEP_SAL_FAM, '0') AS QT_DEP_SAL_FAM ,",
	  "     COALESCE(",
	  "         CONVERT(VARCHAR(10), TRY_CAST(N.DT_INIC_SERV_PUBL AS DATE), 120),",
	  "         ''",
	  "     ) AS DT_INIC_SERV_PUBL,",
	  "     COALESCE(",
	  "         CONVERT(VARCHAR(10), TRY_CAST(N.DT_INIC_SERV_PUBL AS DATE), 103),",
	  "         ''",
	  "     ) AS DT_INIC_SERV_PUBL_CONV,",
	  "     COALESCE(",
	  "         CONVERT(VARCHAR(10), TRY_CAST(N.DT_ANO_PRIM_EMPR AS DATE), 120),",
	  "         ''",
	  "     ) AS DT_ANO_PRIM_EMPR,",
	  "     COALESCE(",
	  "         CONVERT(VARCHAR(10), TRY_CAST(N.DT_ANO_PRIM_EMPR AS DATE), 103),",
	  "         ''",
	  "     ) AS DT_ANO_PRIM_EMPR_CONV,",
	  "     COALESCE(N.NR_PIS_PASEP, '0') AS PIS_PASEP ,",
	  "     COALESCE(A.TIPODEF, '') AS TIPODEF,",
	  "     COALESCE(A.ALDEADO, '') AS ALDEADO,",
	  "     COALESCE(A.ANOPRIEM, '') AS ANOPRIEM,",
	  "     COALESCE(",
	  "         CONVERT(VARCHAR(10), TRY_CAST(A.DTINICSP AS DATE), 120),",
	  "         ''",
	  "     ) AS DTINICSP,",
	  "     COALESCE(",
	  "         CONVERT(VARCHAR(10), TRY_CAST(A.DTINICSP AS DATE), 103),",
	  "         ''",
	  "     ) AS DTINICSP_CONV,",
	  "     COALESCE(A.TOTBRU, '0') AS TOTBRU,",
	  "     COALESCE(A.TOTMES, '0') AS TOTMES,",
	  "     COALESCE(A.TOTLIQ, '0') AS TOTLIQ,",
	  "     COALESCE(A.OPVCTOEX, '0') AS OPVCTOEX,",
	  "     COALESCE(A.TIPOEX, '0') AS TIPOEX,",
	  "     COALESCE(A.TIPOPROV, '0') AS TIPOPROV,",
	  "     COALESCE(A.ID_COR_DESC, '') AS ID_COR_DESC,",
	  "     COALESCE(A.TIPODEF_DESC, '') AS TIPODEF_DESC,",
	  "     COALESCE(M.FORMACAO, '') AS FORMACAO,",
	  "     COALESCE(M.NIVEL_FORMACAO, '') AS NIVEL_FORMACAO ,",
	  "     COALESCE(N.NR_IDENT_SRV_MED, '') AS NR_IDENT_SRV_MED ,",
	  "     COALESCE(N.CD_DDD, '') AS CD_DDD ,",
	  "     COALESCE(N.NR_TEL, '') AS NR_TEL ,",
	  "     COALESCE(N.CD_DDD_CEL, '') AS CD_DDD_CEL ,",
	  "     COALESCE(N.NR_TEL_CEL, '') AS NR_TEL_CEL",
	  "INTO #00_JOIN",
	  "FROM CTG0526 A",
	  "LEFT JOIN #ARQ B ON A.CODUA_C = B.UA",
	  "LEFT JOIN #ARQ C ON A.CODUA_E = C.UA",
	  "LEFT JOIN #ID D ON A.CPF = D.CPF",
	  "LEFT JOIN #CARGO E ON A.CARGO_C = E.CD_CARGO",
	  "LEFT JOIN #CARGO F ON A.CARGO_E = F.CD_CARGO",
	  "LEFT JOIN #DISC G ON CONVERT(VARCHAR, A.CLDISC)  = CONVERT(VARCHAR, G.COD_DISCIPLINA)",
	  "LEFT JOIN #BFE H ON A.MOTIAFAS  = H.COD",
	  "LEFT JOIN #BFE I ON A.MOTLICE  = I.COD",
	  "LEFT JOIN #FUNC J ON A.CPF  = J.NR_CPF",
	  "LEFT JOIN #TB_EVENT K ON J.CD_TIP_INTERRUP_CESS_TIT  = K.CD_TIP_EVE",
	  "LEFT JOIN #BFE L ON J.CD_MOT_INTERRUP_CESS_TIT  = L.COD",
	  "LEFT JOIN #NIVEL M ON A.CPF  = M.CPF",
	  "LEFT JOIN #PESSOAL N ON A.CPF  = N.NR_CPF",
	  "",
	  "---------------------------------------------------------------------------------- ROW_NUMBER ----------------------------------------------------------------------------------",
	  "",
	  "DROP TABLE IF EXISTS #00_CTG",
	  "WITH BASE_RANK1 AS (",
	  "   SELECT *",
	  "   FROM #00_JOIN",
	  "),",
	  "RANK1 AS (",
	  "   SELECT *,",
	  "      ROW_NUMBER() OVER (PARTITION BY CPF_DI ORDER BY (SELECT NULL)) AS ROW1 -- OU ORDER BY coluna1 DESC",
	  "   FROM BASE_RANK1",
	  ")",
	  "SELECT *",
	  "INTO #00_CTG",
	  "FROM RANK1",
	  "WHERE ROW1 = 1 --PRIMEIRA LINHA DA DUPLICATA",
	  "ORDER BY CPF_DI",
	  "",
	  "-- (243162 linhas afetadas)",
	  "",
	  "---------------------------------------------------------------------------------- #00_CTG ----------------------------------------------------------------------------------",
	  "",
	  "SELECT",
