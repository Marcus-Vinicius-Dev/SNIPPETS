		  "INTO #00_JOIN",
		  "FROM CTG0526 A",
		  "LEFT JOIN #ARQ B ON A.CODUA_C = B.UA",
		  "LEFT JOIN #ARQ C ON A.CODUA_E = C.UA",
		  "LEFT JOIN #ID D ON A.CPF = D.CPF",
		  "LEFT JOIN #CARGO E ON A.CARGO_C = E.CD_CARGO",
		  "LEFT JOIN #CARGO F ON A.CARGO_E = F.CD_CARGO",
		  "LEFT JOIN #DISC G ON CONVERT(VARCHAR, A.CLDISC)  = CONVERT(VARCHAR, G.COD_DISCIPLINA)",
		  "LEFT JOIN #BFE H ON A.MOTIAFAS  = H.COD",
		  "LEFT JOIN #BFE I ON A.MOTLICE  = I.COD",
