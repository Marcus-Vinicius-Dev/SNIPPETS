  // COMPARARDADOSDETABELASDIFERENTES
  "COMPARARDADOSDETABELASDIFERENTES": {
	"scope": "sql",
	"prefix": "ZDDCOMPTABLE",
	"body": [
	  "SELECT",
	  "     CPF",
	  "FROM #BASE1 A",
	  "WHERE EXISTS (  -- ou NOT EXISTS",
	  "SELECT",
	  "     CPF",
	  "FROM #BASE2 B",
	  "WHERE A.CPF = B.CPF)"
	],
	"description": "COMPARAR_DADOS_DE_TABELAS_DIFERENTES"
  },
  
  // INSERIRDADOSEMTEMPORARIA
  "INSERIRDADOSEMTEMPORARIA": {
	"scope": "sql",
	"prefix": "ZDDINSTEMP",
	"body": [
	  "DROP TABLE IF EXISTS #${1:BASE_TEMP}",
	  "CREATE TABLE #${1:BASE_TEMP} (",
	  "    ${2:COLUNA} ${3:VARCHAR}(${4:100})",
	  "    )",
	  "INSERT INTO #${1:BASE_TEMP} (${2:COLUNA}) VALUES",
	  "${5:('DADO1'),}",
	  "${5:('DADO2'),}",
	  "${5:('ETC...'),}"
	],
	"description": "INSERIR_DADOS_EM_TEMPORARIA"
  },
  
  // UNIONSEMDUPLICATAS
  "UNIONSEMDUPLICATAS": {
	"scope": "sql",
	"prefix": "ZUNION",
	"body": [
	  "${7:DROP TABLE IF EXISTS ${1:#BASE}_UNION}",
	  "SELECT",
	  "${2:COLUNA1}",
	  "${3:COLUNA2}",
	  "${4:COLUNA2}",
	  "INTO ${1:#BASE}_UNION",
	  "FROM ${5:#BASE1}",
	  "UNION",
	  "SELECT",
	  "${2:COLUNA1}",
	  "${3:COLUNA2}",
	  "${4:COLUNA2}",
	  "FROM ${6:#BASE2} -- SE QUISER, COPIE MAIS UM 'UNION ATÉ FROM'"
	],
	"description": "UNION_SEM_DUPLICATAS"
  },

	// UNIONALLMANTEMDUPLICATAS
"UNIONALLMANTEMDUPLICATAS": {
	"scope": "sql",
	"prefix": "ZUNIONALL",
	"body": [
	  "${7:DROP TABLE IF EXISTS ${1:#UNION_ALL}}",
	  "SELECT",
	  "${2:COLUNA1}",
	  "${3:COLUNA2}",
	  "${4:COLUNA2}",
	  "INTO ${1:#UNION_ALL}",
	  "FROM ${5:#BASE1}",
	  "UNION ALL",
	  "SELECT",
	  "${2:COLUNA1}",
	  "${3:COLUNA2}",
	  "${4:COLUNA2}",
	  "FROM ${6:#BASE2} -- SE QUISER, COPIE MAIS UM 'UNION ATÉ FROM'"
	],
	"description": "UNION_ALL_MANTEM_DUPLICATAS"
  },
  
  // REGIAOARQDEUA
  "REGIAOARQDEUA": {
	"scope": "sql",
