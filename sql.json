  	// SERVER_CPU - VERSÃO MYSQL
	"MYSERVER_CPU": {
		"scope": "sql",
		"prefix": "MYSYSCPU",
		"body": [
		  "$1:SELECT              ",
		  "   -- EM MYSQL NAO TEMOS hyperthread_ratio DIRETO, USAMOS UMA APROXIMACAO",
		  "   (SELECT COUNT(*) FROM information_schema.processlist WHERE command != 'Sleep') AS CONEXOES_ATIVAS,",
		  "   @@global.innodb_buffer_pool_size / 1024 / 1024 / 1024 AS BUFFER_POOL_GB,",
		  "   @@global.max_connections AS MAX_CONEXOES_PERMITIDAS,",
		  "   @@version_compile_os AS SISTEMA_OPERACIONAL,",
		  "   @@version_compile_machine AS ARQUITETURA,",
		  "   -- METRICAS DE PERFORMANCE DO MYSQL (EQUIVALENTE AO DMV DO SQL SERVER)",
		  "   (SELECT VARIABLE_VALUE FROM performance_schema.global_status WHERE VARIABLE_NAME = 'UPTIME') AS UPTIME_SEGUNDOS,",
		  "   (SELECT VARIABLE_VALUE FROM performance_schema.global_status WHERE VARIABLE_NAME = 'THREADS_RUNNING') AS THREADS_EM_EXECUCAO",
		  "FROM DUAL",
		  "-- OBS: MYSQL NAO TEM sys.dm_os_sys_info COMO T-SQL",
		  "-- OS DADOS DE CPU E RAM FISICA SAO OBTIDOS VIA COMANDOS DO SISTEMA OPERACIONAL OU VARIÁVEIS GLOBAIS",
		  "-- PARA VER A MEMORIA TOTAL DO SERVIDOR, USE COMANDOS EXTERNOS OU CONSULTE O information_schema"
		  ],
		"description": "INFO SOBRE CPU E SISTEMA DO SERVER - VERSAO MYSQL"
	},

	// MYSERVER_CPU - VERSÃO MYSQL
	"MYSERVER_CPU": {
		"scope": "sql",
		"prefix": "MYSYSSERV",
		"body": [
		  "$1:SELECT              ",
		  "   (SELECT COUNT(*) FROM information_schema.processlist WHERE command != 'Sleep') AS CONEXOES_ATIVAS,",
		  "   @@global.innodb_buffer_pool_size / 1024 / 1024 / 1024 AS BUFFER_POOL_GB,",
		  "   @@global.max_connections AS MAX_CONEXOES_PERMITIDAS,",
		  "   @@version_compile_os AS SISTEMA_OPERACIONAL,",
		  "   @@version_compile_machine AS ARQUITETURA,",
		  "   (SELECT VARIABLE_VALUE FROM performance_schema.global_status WHERE VARIABLE_NAME = 'UPTIME') AS UPTIME_SEGUNDOS,",
		  "   (SELECT VARIABLE_VALUE FROM performance_schema.global_status WHERE VARIABLE_NAME = 'THREADS_RUNNING') AS THREADS_EM_EXECUCAO",
		  "FROM DUAL",
		  "-- OBS: MYSQL NAO TEM sys.dm_os_sys_info COMO T-SQL",
		  "-- OS DADOS DE CPU E RAM FISICA SAO OBTIDOS VIA COMANDOS DO SISTEMA OPERACIONAL OU VARIÁVEIS GLOBAIS",
		  "-- PARA VER A MEMORIA TOTAL DO SERVIDOR, USE COMANDOS EXTERNOS OU CONSULTE O information_schema"
		  ],
		"description": "INFO SOBRE CPU E SISTEMA DO SERVER - VERSAO MYSQL"
	},

