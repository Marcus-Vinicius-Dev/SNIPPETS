// FILTRAR_CARACTERES_INICIO_FIM - T-SQL
"FILTRAR_CARACTERES_INICIO_FIM": {
	"scope": "sql",
	"prefix": "ZDDINICFIM",
	"body": [
	  "SELECT DISTINCT",
	  "      ${1:COLUNA}",
	  "FROM ${2:BASE}",
	  "WHERE UPPER(LEFT(${1:COLUNA}, 1)) IN (${3:'A','E','I','O','U'})  -- CARACTERES NO INICIO",
	  "  AND UPPER(RIGHT(${1:COLUNA}, 1)) IN (${4:'A','E','I','O','U'})  -- CARACTERES NO FINAL"
	],
	"description": "FILTRAR DADOS QUE COMEÇAM OU TERMINAM COM DETERMINADO CARACTER - T-SQL"
},
  
	// COLA_CATEGORIAS
	"COLA_CATEGORIAS": {
		"scope": "sql",
		"prefix": "ZCOLACATEG",
		"body": [
			"COALESCE(",
			"   CASE",
			"      WHEN ${1:COLUNA} = 'A' THEN 'A - EFETIVO'",
			"      WHEN ${1:COLUNA} = 'C' THEN 'C - COMISSIONADO'",
			"      WHEN ${1:COLUNA} = 'D' THEN 'D - DESIGNADO'",
			"      WHEN ${1:COLUNA} = 'F' THEN 'F - ESTÁVEL'",
			"      WHEN ${1:COLUNA} = 'N' THEN 'N - CLT'",
			"      WHEN ${1:COLUNA} = 'O' THEN 'O - TEMPORÁRIO'",
			"      WHEN ${1:COLUNA} = 'P' THEN 'P - ESTÁVEL'",
			"      WHEN ${1:COLUNA} = '8' THEN '8 - COMISSIONADO'",
			"      WHEN ${1:COLUNA} = '9' THEN '9 - COMISSIONADO'",
			"      ELSE ${1:COLUNA}",
			"   END AS ${2:NOVA_COLUNA} ,"
		],
		"description": "COLA_CATEGORIAS"
	},
  
