  // CONT_EVENTOS
  "CONT_EVENTOS": {
	  "scope": "sql",
	  "prefix": "Z00EVENTOS",
	  "body": [
		  "-- 0526",
		  "-- [052026]",
		  "",
		  "USE CEPEA_SAS",
		  "",
		  "-------------------------------------------------------------- TEMPORÁRIAS --------------------------------------------------------------",
		  "",
		  "DROP TABLE IF EXISTS #ARQ",
		  "DROP TABLE IF EXISTS #ID",
		  "DROP TABLE IF EXISTS #PESSOAL",
		  "DROP TABLE IF EXISTS #TIP_EVE",
		  "DROP TABLE IF EXISTS #CD_EVE",
		  "",
		  "SELECT * INTO #ARQ FROM ARQDEUA0526",
		  "SELECT * INTO #ID FROM TB_ID_INTERNO_SERV",
		  "SELECT * INTO #PESSOAL FROM SAS.[052026].TB_PESSOAL",
		  "SELECT * INTO #TIP_EVE FROM CONTAGEH.dbo.TB_TIPO_EVENTO",
		  "SELECT * INTO #CD_EVE FROM CONTAGEH.dbo.TB_EVENTO",
		  "",
		  "-------------------------------------------------------------- TOP 1000 EVENTOS --------------------------------------------------------------",
		  "",
		  "SELECT TOP 1000",
		  "    B.REGIAO         ,",
		  "    CASE",
		  "       WHEN A.CD_UNID_ADM_CLASS = '000000' THEN ''",
		  "       ELSE B.NOMEDE",
		  "    END AS URE ,",
		  "    A.CD_UNID_ADM_CLASS AS UA_C,",
		  "    A.CD_UNID_ADM_EVE,",
		  "    CASE",
		  "       WHEN A.CD_UNID_ADM_CLASS = '000000' THEN ''",
		  "       ELSE B.NOMEUA",
		  "    END AS NOMEUA ,",
		  "    A.NR_CPF AS CPF,",
		  "    A.NR_DI AS DI,",
		  "    CONCAT(A.NR_CPF, A.NR_DI) AS CPF_DI,",
		  "    D.ID             ,",
		  "    E.NM_PESSOA AS NOME_SERVIDOR          ,",
		  "    B.NOMEMUN  AS MUNICIPIO_C      ,",
		  "    A.CD_TIP_EVE,",
		  "    F.NM_TIP_EVE     ,",
		  "    A.CD_EVE,",
		  "    G.NM_EVE    ,",
		  "    A.TP_MOT_TRM,",
		  "    A.CD_EVE_TRM,",
		  "    H.NM_EVE     ,",
		  "    A.ID_SIT_VINC,",
		  "    A.DT_SIT_VINC,",
		  "    A.DT_INI_EXERC,",
		  "    A.DT_INI_VIG,",
		  "    A.DT_FIM_VIG,",
		  "    A.DT_INI_VIG_EVE,",
		  "    A.DT_FIM_VIG_EVE,",
		  "    A.TP_ATO_OFIC_TRM,",
		  "    A.DT_INIC_VIGEN_EVENT_TRM,",
		  "    A.DT_FIM_VIGEN_EVENT_TRM,",
		  "    A.DT_POSSE,",
		  "    A.DT_ULT_ALTER,",
		  "    A.CD_CARGO_FUNC_ATUAL,",
		  "    A.CD_CARGO_FUNC_EVE,",
		  "    A.ID_CARGO_FUNC,",
		  "    A.ID_CAT_FUNC,",
		  "    A.ID_ORI_CARGO_FUNC,",
		  "    A.CD_JORN_ANT,",
		  "    A.CD_JORN_ATU,",
		  "    A.CD_UNID_ESCOL_CLASSIF_TIT,",
		  "    A.CD_UNID_ESCOL_EVE,",
		  "    A.CD_TIP_PROV,",
		  "    A.FL_PROLABOR,",
		  "    A.TP_ATO_OFIC,",
		  "    A.ID_ORG_ATO_OFIC,",
		  "    A.NR_ATO_OFIC,",
		  "    A.NR_ANO_ATO_OFIC,",
		  "    A.DT_PUBL_ATO_OFIC,",
		  "    A.ID_REF_FAIXA,",
		  "    A.ID_GRAU_NIV,",
		  "    A.QT_HORA_CARGA_SUPL,",
		  "    A.NR_RG_SUBST,",
		  "    A.CD_MOT_SUBST,",
		  "    A.ID_LOCAL_AFAST,",
		  "    A.NM_LOCAL_AFAST,",
		  "    A.CD_ACUM_CARGO_1,",
		  "    A.TP_ACUM_CARGO_1,",
		  "    A.NR_PAREC_COMIS_ACUM_CARGO_1,",
		  "    A.NR_ANO_PAREC_ACUM_CARGO_1,",
		  "    A.DT_PUBL_ACUM_CARGO_1,",
		  "    A.CD_REG_HABILIT,",
		  "    A.DT_REG_HABILIT,",
		  "    A.CD_ORG_EMIS_REG,",
		  "    A.TP_ATO_OFIC_CES_EXER,",
		  "    A.ID_ORG_ATO_OFIC_CES_EXER,",
		  "    A.NR_ATO_OFIC_CES_EXER,",
		  "    A.NR_ANO_ATO_OFIC_CES_EXER,",
		  "    A.DT_PUBL_ATO_OFIC_CES_EXER,",
		  "    A.CD_OPCAO_TRANS_UTIL,",
		  "    A.CD_TERMINAL,",
		  "    A.CD_OPER,",
		  "    A.DT_ALTER,",
		  "    A.DT_HORA_INIC_ALTER,",
		  "    A.DT_HORA_FIM_ALTER,",
		  "    A.FL_FOLHA_PAGTO_HIST,",
		  "    A.ID_NUM_PROC_SAUDE,",
		  "    A.NR_ANO_PROC_SAUDE,",
		  "    A.TP_TEMPO_SIT_ESPEC,",
		  "    A.DT_PUBL_2,",
		  "    A.NR_PROC,",
		  "    A.ID_ORG_EMIS_PROC,",
		  "    A.NR_ANO_PROC,",
		  "    A.ACAO_JUDICIAL,",
		  "    A.DT_ULT_ATUALIZ,",
		  "    A.ID_ORG_ATO_OFIC_TRM,",
		  "    A.NR_ATO_OFIC_TRM,",
		  "    A.NR_ANO_ATO_OFIC_TRM,",
		  "    A.DT_PUBL_ATO_OFIC_TRM,",
		  "    A.CD_UNID_ADM_EVE_TRM,",
		  "    A.CD_CARGO_FUNC_EVE_TRM,",
		  "    A.FL_PROC_QUEBRA,",
		  "    A.CD_CARGO_FUNCAO_ATUAL_TRM,",
		  "    A.CD_UNID_ADM_CLASSIF_TRM,",
		  "    A.CD_JORN_ANT_TRM,",
		  "    A.CD_JORN_ATUAL_TRM,",
		  "    A.CD_UNID_ESCOL_CLASSIF_TITUL_TRM,",
		  "    A.CD_UNID_ESCOL_EVENT_TRM,",
		  "    A.CD_TP_PROV_TRM,",
		  "    A.FL_PROLABOR_TRM,",
		  "    A.DT_POSSE_TRM,",
		  "    A.DT_INIC_EXERC_TRM,",
		  "    A.ID_SIT_VINC_TRM,",
		  "    A.DT_SIT_VINC_TRM,",
		  "    A.ID_REF_FAIXA_TRM,",
		  "    A.ID_GRAU_NIVEL_TRM,",
		  "    A.ID_CARGO_FUNCAO_TRM,",
		  "    A.ID_CATEG_FUNCIO_TRM,",
		  "    A.ID_ORIG_CARGO_FUNCAO_TRM,",
		  "    A.QTD_HR_CARGA_SUPL_TRM,",
		  "    A.NR_RG_SUBST_TRM,",
		  "    A.CD_CARGO_FUNCAO_TRM,",
		  "    A.TP_EVOL_EVENT,",
		  "    A.TP_DOC_EVENT,",
		  "    A.DT_PEDIDO_CERTIF_EVENT,",
		  "    A.NR_ATO_ACAO_JUDICIAL,",
		  "    A.NR_RG,",
		  "    A.FL_FOLHA_PAGTO,",
		  "    A.[SYS_C00079_14093022:06:13$]",
		  "FROM CONTAGEH.dbo.TB_ATRIB_EVENTO A",
		  "LEFT JOIN #ARQ B ON A.CD_UNID_ADM_CLASS = B.UA",
		  "LEFT JOIN #ID D ON A.NR_CPF = D.CPF",
		  "LEFT JOIN #PESSOAL E ON A.NR_CPF = E.NR_CPF",
		  "LEFT JOIN #TIP_EVE F ON A.CD_TIP_EVE = F.CD_TIP_EVE",
		  "LEFT JOIN #CD_EVE G ON A.CD_EVE = G.CD_EVE",
		  "LEFT JOIN #CD_EVE H ON A.CD_EVE_TRM = H.CD_EVE",
		  "-- WHERE A.NR_CPF = '35146922896'",
		  "",
		  "-- ~ 10 seg"
	  ],
	  "description": "CONT_EVENTOS"
  },
  
  // MAPEAMENTO_DATABRICKS_CONSULTAR
  "MAPEAMENTO_DATABRICKS_CONSULTAR": {
