// LISTAR_TABELAS - VERSÃO MYSQL
	"LISTAR_TABELAS": {
		"scope": "sql",
		"prefix": "MYSYSTABLIST",
		"body": [  
		  "$1SELECT", 
		  "   t.TABLE_NAME AS NOME_TABELA,",
		  "   t.TABLE_SCHEMA AS ESQUEMA,",
		  "   YEAR(t.CREATED) AS ANO_CRIACAO,",
		  "   YEAR(t.UPDATED) AS ANO_MODIFICACAO,",
		  "   (SELECT COUNT(*) FROM information_schema.COLUMNS c WHERE c.TABLE_SCHEMA = t.TABLE_SCHEMA AND c.TABLE_NAME = t.TABLE_NAME) AS QTD_COLUNAS,",
		  "   t.TABLE_ROWS AS QTD_LINHAS_APROX",
		  "FROM information_schema.TABLES t",
		  "WHERE t.TABLE_SCHEMA NOT IN ('information_schema', 'performance_schema', 'mysql')  -- FILTRA BANCOS DO SISTEMA",
		  "ORDER BY ",
		  "   ANO_MODIFICACAO DESC",
		  "-- OBS: MYSQL NAO TEM sys.tables, USAMOS information_schema.TABLES",
		  "-- TABLE_ROWS E APROXIMADO PARA TABELAS INNODB"
		],
		"description": "LISTAR TABELAS - VERSAO MYSQL"
	},

// DADOS_DA_TABELA - VERSÃO MYSQL
	"DADOS_DA_TABELA": {
		"scope": "sql",
		"prefix": "MYSYSDDTAB",
		"body": [
		  "DESCRIBE `${1:NOME_TABELA}`;  -- MYSQL USA DESCRIBE OU SHOW COLUMNS EM VEZ DE sp_help",
		  "SHOW INDEX FROM `${1:NOME_TABELA}`;  -- MOSTRA INDICES",
		  "SHOW CREATE TABLE `${1:NOME_TABELA}`;  -- MOSTRA DDL COMPLETO"
		],
		"description": "Retorna informacoes da tabela (colunas, indices, constraints) - VERSAO MYSQL"
	},

