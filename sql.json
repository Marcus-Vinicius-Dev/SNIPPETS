	"description": "LIMPAR_ESPACOS_VAZIOS_DA_ESQUERDA_OU_DIREITA - VERSAO MYSQL"
},

// LIMPAR_TODOS_OS_ESPACOS_VAZIOS - VERSÃO MYSQL
"LIMPAR_TODOS_OS_ESPACOS_VAZIOS": {
