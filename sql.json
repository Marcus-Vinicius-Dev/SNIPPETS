	  "    CLDISC,",
	  "    NOME_DISCIPLINA,",
	  "    SITVINC,",
	  "    SITVINCO,",
	  "    SITVINDE,",
	  "    RG,",
	  "    RG12,",
	  "    RG11,",
	  "    UFRG,",
	  "    ORG_EMIS_RG,",
	  "    DT_EMIS_RG,",
	  "    RS,",
	  "    PV,",
	  "    RSPV,",
	  "    COD_BANCO,",
