  },
  
  // Z00CTG
  "Z00CTG": {
	  "scope": "sql",
	  "prefix": "Z00CTG",
	  "body": [
		  "---------------------------------------------------------------------------------- DATAS ----------------------------------------------------------------------------------",
		  "",
		  "-- ${1:05}26",
		  "-- [${1:05}2026]",
		  "",
		  "USE CEPEA_SAS",
		  "",
		  "---------------------------------------------------------------------------------- BASES ----------------------------------------------------------------------------------",
		  "",
		  "DROP TABLE IF EXISTS #ARQ",
		  "DROP TABLE IF EXISTS #ID",
		  "DROP TABLE IF EXISTS #CARGO",
		  "DROP TABLE IF EXISTS #DISC",
		  "DROP TABLE IF EXISTS #BFE",
		  "DROP TABLE IF EXISTS #FUNC",
		  "DROP TABLE IF EXISTS #TB_EVENT",
		  "DROP TABLE IF EXISTS #NIVEL",
		  "DROP TABLE IF EXISTS #PESSOAL",
		  "",
		  "SELECT * INTO #ARQ FROM ARQDEUA${1:05}26",
		  "SELECT * INTO #ID FROM TB_ID_INTERNO_SERV",
		  "SELECT * INTO #CARGO FROM TAB_CARGO${1:05}26",
		  "SELECT * INTO #DISC FROM DESENV.DBO.DISCIPLINA",
		  "SELECT * INTO #BFE FROM TAB_CODBFE",
		  "SELECT * INTO #FUNC FROM SAS.[${1:05}2026].TB_FUNCIONAL",
		  "SELECT * INTO #TB_EVENT FROM CONTAGEH.dbo.TB_TIPO_EVENTO",
		  "SELECT * INTO #NIVEL FROM NIVEL_FORMACAO${1:05}26",
		  "SELECT * INTO #PESSOAL FROM SAS.[${1:05}2026].TB_PESSOAL",
		  "",
		  "---------------------------------------------------------------------------------- #00_JOIN ----------------------------------------------------------------------------------",
		  "",
		  "DROP TABLE IF EXISTS #00_JOIN",
		  "SELECT",
		  "     COALESCE(B.REGIAO, '') AS REGIAO_C,",
		  "     COALESCE(B.NOMEDE, '') AS URE_C,",
		  "     COALESCE(A.CODUA_C, '0') AS CODUA_C,",
		  "     COALESCE(B.NOMEUA, '') AS NOMEUA_C,",
		  "     COALESCE(A.CPF, '0') AS CPF,",
		  "     COALESCE(A.DI, '0') AS DI,",
		  "     COALESCE(CONCAT(A.CPF, A.DI), '0') AS CPF_DI,",
		  "     COALESCE(D.ID, '0') AS ID,",
		  "     COALESCE(A.NOME, '') AS NOME_SERVIDOR,",
		  "     COALESCE(N.NM_PESSOA_SOCIAL, '') AS NOME_SOCIAL,",
		  "     COALESCE(A.CARGO_C, '0') AS CARGO_C,",
		  "     COALESCE(E.NM_CARGO, '') AS NM_CARGO_C,",
		  "     COALESCE(CONCAT(A.CARGO_C, ' - ', E.NM_CARGO), '') AS CARGO_C_DESC,",
		  "     COALESCE(A.CATEG_C, '') AS CATEG_C,",
		  "     COALESCE(A.CATEG_C_DESC, '') AS CATEG_C_DESC,",
		  "     COALESCE(E.NM_QUADRO, '') AS QUADRO_C,",
		  "     COALESCE(",
		  "         CASE",
		  "             WHEN E.NM_QUADRO = 'QM' THEN 'QM - QUADRO DO MAGISTERIO'",
		  "             WHEN E.NM_QUADRO = 'QAE' THEN 'QAE - QUADRO DE APOIO ESCOLAR'",
		  "             WHEN E.NM_QUADRO = 'QSE' THEN 'QSE - QUADRO DA SECRETARIA DA EDUCACAO'",
		  "             ELSE E.NM_QUADRO",
		  "         END,",
		  "         ''",
		  "     ) AS NM_QUADRO_C,",
		  "     COALESCE(A.FAIXA_C, '') AS FAIXA_C,",
		  "     COALESCE(A.NIVEL_C, '') AS NIVEL_C,",
		  "     COALESCE(A.FAIXA_NIVEL_C, '') AS FAIXA_NIVEL_C,",
		  "     COALESCE(B.NOMEMUN, '') AS MUNICIPIO_C,",
		  "     COALESCE(",
		  "         CONVERT(VARCHAR(10), TRY_CAST(A.DTIEXER_C AS DATE), 120),",
		  "         ''",
		  "     ) AS DTIEXER_C,",
		  "     COALESCE(",
		  "         CONVERT(VARCHAR(10), TRY_CAST(A.DTIEXER_C AS DATE), 103),",
		  "         ''",
		  "     ) AS DTIEXER_C_CONV,",
		  "     COALESCE(A.ANOSTRAB_C, '0') AS ANOSTRAB_C,",
		  "     COALESCE(C.REGIAO, '') AS REGIAO_E,",
		  "     COALESCE(C.NOMEDE, '') AS URE_E,",
		  "     COALESCE(A.CODUA_E, '0') AS CODUA_E,",
		  "     COALESCE(C.NOMEUA, '') AS NOMEUA_E,",
		  "     COALESCE(A.CARGO_E, '0') AS CARGO_E,",
		  "     COALESCE(F.NM_CARGO, '') AS NM_CARGO_E,",
