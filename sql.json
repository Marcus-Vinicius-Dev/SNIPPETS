	"SELECIONAR MENOR/MAIOR DADO DA COLUNA": {
		"scope": "sql",
		"prefix": "ZDDMINMAX",
		"body": [
		  "$1(SELECT TOP 1 ",
		  "    NOME, ",
		  "    LEN(NOME) AS TAMANHO",
