	  "      WHEN ${1:COLUNA} = 'A' THEN 'A - EFETIVO'",
	  "      WHEN ${1:COLUNA} = 'C' THEN 'C - COMISSIONADO'",
	  "      WHEN ${1:COLUNA} = 'D' THEN 'D - DESIGNADO'",
	  "      WHEN ${1:COLUNA} = 'F' THEN 'F - ESTÁVEL'",
