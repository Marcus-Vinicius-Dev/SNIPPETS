	  "    DT_INI_LICENCA,",
	  "    DT_FIM_LICENCA,",
	  "    FL_READAPTADO,",
	  "    DT_INI_READAPTADO,",
	  "    DT_FIM_READAPTADO,",
	  "    FL_INTERRUPCAO,",
	  "    DT_INI_INTERRUPCAO,",
	  "    DT_FIM_INTERRUPCAO",
	  "    --SEQUENCE_RAW,",
