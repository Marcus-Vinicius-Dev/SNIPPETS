	  "-- OBS: MYSQL SO PERMITE UM AUTO_INCREMENT POR TABELA"
	],
	"description": "ACRESCENTA COLUNA ID COM PRIMARY KEY - VERSAO MYSQL"
},

// CRIAR_TABELA - VERSÃO MYSQL
"CRIAR_TABELA": {
	"scope": "sql",
	"prefix": "MYCRIARTAB",
	"body": [
	  "$12DROP TABLE IF EXISTS ${1:BASE}  -- DROP TABLE IF EXISTS FUNCIONA NO MYSQL",
	  "CREATE TABLE ${1:BASE} (",
	  "    ${2:COLUNA1} VARCHAR(${3:100}),",
	  "    ${4:COLUNA2} VARCHAR(${5:100})",
	  ") ENGINE=InnoDB DEFAULT CHARSET=utf8mb4  -- ENGINE E CHARSET RECOMENDADOS",
	  " ",
	  "INSERT INTO ${1:BASE} (${2:COLUNA1}, ${4:COLUNA2}) VALUES",
	  "('${6:DADO}', '${7:DADO}'),",
	  "('${8:DADO}', '${9:DADO}'),",
	  "('${10:DADO}', '${11:DADO}')",
	  "-- OBS: MYSQL ACEITA INSERT MULTIPLO IGUAL AO T-SQL"
	],
	"description": "CRIAR_TABELA - VERSAO MYSQL"
},

// CRIAR_COLUNA - VERSÃO MYSQL
"CRIAR_COLUNA": {
	"scope": "sql",
	"prefix": "MYCRIARCOL",
	"body": [
	  "ALTER TABLE ${1:nome_da_tabela}",
	  "    ADD  ${2:coluna1} VARCHAR(${3:100}) NULL,  -- MYSQL USA VARCHAR EM VEZ DE NVARCHAR",
	  "    ADD  ${4:coluna2} VARCHAR(${5:100}) NULL   -- PARA UNICODE USE CHAR SET utf8mb4",
	  "-- OBS: MYSQL NAO TEM NVARCHAR, USE VARCHAR COM utf8mb4"
	],
	"description": "CRIAR_COLUNA - VERSAO MYSQL"
},

// DROP_TABLE - VERSÃO MYSQL
"DROP_TABLE": {
	"scope": "sql",
	"prefix": "MYDROP",
	"body": [
	  "${2:DROP TABLE IF EXISTS ${1:#BASE}  -- DROP TABLE IF EXISTS FUNCIONA NO MYSQL}",
	  "-- OBS: MYSQL NAO USA # PARA TABELAS TEMPORARIAS, USE TEMPORARY TABLE"
	],
	"description": "DROP TABLE IF EXISTS - VERSAO MYSQL"
},

// EXCLUIR_COLUNA - VERSÃO MYSQL
"EXCLUIR_COLUNA": {
	"scope": "sql",
	"prefix": "MYEXCLCOL",
	"body": [
	  "ALTER TABLE ${1:tabela}",
	  "DROP COLUMN ${2:coluna1}, ${3:coluna2}  -- MYSQL PERMITE DROP DE MULTIPLAS COLUNAS"
	],
	"description": "EXCLUIR_COLUNA - VERSAO MYSQL"
},

// EXCLUIR_LINHAS_NULL - VERSÃO MYSQL
"EXCLUIR_LINHAS_NULL": {
	"scope": "sql",
	"prefix": "MYEXCLLINULL",
	"body": [
	  "DELETE FROM ${1:tabela}",
	  "WHERE ${2:coluna1} IS NULL",
	  "   AND ${3:coluna2} IS NULL",
	  "   AND ${4:coluna3} IS NULL"
	],
	"description": "EXCLUIR_LINHAS_NULL - VERSAO MYSQL"
},

// COUNT - VERSÃO MYSQL
"COUNT": {
	"scope": "sql",
	"prefix": "MYCOUNT",
	"body": [
	  "COUNT(${1:CPF+DI}) AS ${2:TOTAL} ${3:-- SUM(* OU COLUNA), AVG(* OU COLUNA), MAX(* OU COLUNA), MIN(* OU COLUNA) VEJA MAIS EM MYGROUP}",
	  "-- OBS: FUNCOES DE AGREGACAO FUNCIONAM IGUAL NO MYSQL"
	],
	"description": "CONTAR E AGRUPAR - VERSAO MYSQL"
},

// GROUP_BY - VERSÃO MYSQL
"GROUP_BY": {
	"scope": "sql",
	"prefix": "MYGROUP",
	"body": [
	  "$3GROUP BY ${1:COLUNA1}",
	  "${2:ORDER BY TOTAL DESC}",
	  "-- OBS: GROUP BY FUNCIONA IGUAL NO MYSQL"
	],
	"description": "GROUP_BY - VERSAO MYSQL"
},

// HAVING - VERSÃO MYSQL
"HAVING": {
	"scope": "sql",
	"prefix": "MYCOUNTHAVING",
	"body": [
	  "HAVING ${1:COUNT(*) > 10 } -- FILTRAR APOS O GROUP BY COM COUNT",
	  "   ${2:AND AVG(preco) > 50}",
	  "${3:ORDER BY TOTAL DESC}",
	  "-- OBS: HAVING FUNCIONA IGUAL NO MYSQL"
	],
	"description": "HAVING = FILTRAR APOS O GROUP BY - VERSAO MYSQL"
},
  
// NULL - VERSÃO MYSQL
"NULL": {
	"scope": "sql",
	"prefix": "MYNULL",
	"body": [
	"IFNULL(${1:COLUNA},'') AS ${2:NOVO_NOME1},  -- MYSQL USA IFNULL EM VEZ DE ISNULL"
	],
	"description": "NULL - VERSAO MYSQL"
},

// NULIFICA - VERSÃO MYSQL
"NULIFICA": {
	"scope": "sql",
	"prefix": "MYNULLIF",
	"body": [
	  "SELECT NULLIF(${1:COLUNA}, 25) AS SEM_25  -- NULLIF FUNCIONA IGUAL NO MYSQL"
	],
	"description": "NULIFICA - VERSAO MYSQL"
},

// COALESCE - VERSÃO MYSQL
"COALESCE": {
	"scope": "sql",
	"prefix": "MYCOAL",
	"body": [
	  "COALESCE(${1:COLUNA}, '') AS ${1:COLUNA}  -- COALESCE FUNCIONA IGUAL NO MYSQL"
	],
	"description": "COALESCE NULIFICANDO - VERSAO MYSQL"
},

// COALESCE_SEM_NULOS - VERSÃO MYSQL
"COALESCE_SEM_NULOS": {
	"scope": "sql",
	"prefix": "MYCOALNULLIF",
	"body": [
	  "COALESCE(NULLIF(${1:COLUNA1}, ''), ${2:COLUNA2}, '') AS ${3:NOVO_NOME},  -- COALESCE E NULLIF FUNCIONAM IGUAL NO MYSQL"
	],
	"description": "COALESCE com NULLIF para NOME, fallback para NOME_SERVIDOR e vazio - VERSAO MYSQL"
},

// QUANTIDADE_DE_CARACTERES - VERSÃO MYSQL
"QUANTIDADE_DE_CARACTERES": {
	"scope": "sql",
	"prefix": "MYDDQTDBYTE",
	"body": [
	  "CHAR_LENGTH(${1:coluna1}) AS CARACTERES,  -- MYSQL USA CHAR_LENGTH (CONTA CARACTERES) EM VEZ DE DATALENGTH (CONTA BYTES)",
	  "LENGTH(${1:coluna1}) AS BYTES  -- LENGTH CONTA BYTES (EQUIVALENTE AO DATALENGTH)"
	],
	"description": "CONTA A QUANTIDADE DE CARACTERES - VERSAO MYSQL"
},

// RENOMEAR_TABELA - VERSÃO MYSQL
"RENOMEAR_TABELA": {
	"scope": "sql",
	"prefix": "MYRENTAB",
	"body": [
	  "RENAME TABLE ${1:nome_atual} TO ${2:novo_nome}  -- MYSQL USA RENAME TABLE EM VEZ DE sp_rename"
	],
	"description": "RENOMEIA TABELA - VERSAO MYSQL"
},

// BACKUP_DA_TABELA - VERSÃO MYSQL
"BACKUP_DA_TABELA": {
	"scope": "sql",
	"prefix": "MYBKPTAB",
	"body": [
	  "CREATE TABLE BKP AS  -- MYSQL USA CREATE TABLE ... AS PARA BACKUP",
	  "SELECT *",
	  "FROM ${1:BD}  -- DEPOIS INSERT INTO BD_BKP SELECT * FROM BKP"
	],
	"description": "BACKUP_DA_TABELA - VERSAO MYSQL"
},

// BACKUP_DE_BD - VERSÃO MYSQL
"BACKUP_DE_BD": {
	"scope": "sql",
	"prefix": "MYBKPBD",
	"body": [
	  "-- MYSQL NAO TEM BACKUP DATABASE VIA SQL (FAZ-SE VIA MYSQLDUMP NO TERMINAL)",
	  "-- COMANDO NO TERMINAL: mysqldump -u usuario -p ${1:NOME_BD} > C:/caminho/backup.sql",
	  "SELECT 'USE MYSQLDUMP NO TERMINAL PARA BACKUP' AS AVISO"
	],
	"description": "BACKUP_DE_BD - VERSAO MYSQL"
},

// CONCATENAR - VERSÃO MYSQL
"CONCATENAR": {
	"scope": "sql",
	"prefix": "MYCONC",
	"body": [
	  "CONCAT(${1:col1},' - ', ${2:col2}) AS ${3:NOME}  -- CONCAT FUNCIONA IGUAL NO MYSQL"
	],
	"description": "CONCATENAR - VERSAO MYSQL"
},

// TIPO_DADOS_TABELA - VERSÃO MYSQL
"TIPO_DADOS_TABELA": {
	"scope": "sql",
	"prefix": "MYDDTIPO",
	"body": [
	  "${2:DESCRIBE ${1:nome_da_tabela}  -- MYSQL USA DESCRIBE EM VEZ DE sp_help}",
	  "-- OU: SHOW COLUMNS FROM ${1:nome_da_tabela}"
	],
	"description": "TIPO DE DADOS DA TABELA POR COLUNA - VERSAO MYSQL"
},

// ALTERAR_TIPO_DADOS_COLUNA - VERSÃO MYSQL
"ALTERAR_TIPO_DADOS_COLUNA": {
	"scope": "sql",
	"prefix": "MYDDALTERTIPO",
	"body": [
	  "ALTER TABLE ${1:tabela} ${6:MODIFY COLUMN ${2:coluna1} ${3:TIPO}(${4:tamanho}) NULL  -- MYSQL USA MODIFY COLUMN EM VEZ DE ALTER COLUMN}",
	  "${5:-- VERIFICAR MYCOLA}"
	],
	"description": "ALTERAR O TIPO DE DADO DA COLUNA - VERSAO MYSQL"
},

// EXTRAIR_CARACTERES_DA_ESQUERDA_OU_DIREITA - VERSÃO MYSQL
"EXTRAIR_CARACTERES_DA_ESQUERDA_OU_DIREITA": {
	"scope": "sql",
	"prefix": "MYDDEXTRCHAR",
	"body": [
	  "${1:LEFT}${2:RIGHT}(${3:coluna}, ${4:3}) AS ${5:EXTRACAO_ESQUERDA}  -- LEFT E RIGHT FUNCIONAM IGUAL NO MYSQL"
	],
	"description": "EXTRAIR_CARACTERES_DA_ESQUERDA_OU_DIREITA - VERSAO MYSQL"
},

// LIMPAR_ESPACOS_VAZIOS_DA_ESQUERDA_OU_DIREITA - VERSÃO MYSQL
"LIMPAR_ESPACOS_VAZIOS_DA_ESQUERDA_OU_DIREITA": {
	"scope": "sql",
	"prefix": "MYDDLIMP1",
	"body": [
	  "${1:LTRIM}${2:RTRIM}(${3:COLUNA}) AS LIMPA_${4:ESQUERDA}${5:DIREITA}  -- LTRIM E RTRIM FUNCIONAM IGUAL NO MYSQL"
	],
	"description": "LIMPAR_ESPACOS_VAZIOS_DA_ESQUERDA_OU_DIREITA - VERSAO MYSQL"
},

// LIMPAR_TODOS_OS_ESPACOS_VAZIOS - VERSÃO MYSQL
"LIMPAR_TODOS_OS_ESPACOS_VAZIOS": {
	"scope": "sql",
	"prefix": "MYDDLIMP",
	"body": [
	  "TRIM('     SQL Tutorial!     ') AS SEM_ESPACOS  -- TRIM FUNCIONA IGUAL NO MYSQL"
	],
	"description": "LIMPAR_TODOS_OS_ESPACOS_VAZIOS - VERSAO MYSQL"
},

// MUDAR_CARACTER_POR_OUTRO - VERSÃO MYSQL
"MUDAR_CARACTER_POR_OUTRO": {
	"scope": "sql",
	"prefix": "MYDDMUDCHAR",
	"body": [
	  "REPLACE(${1:coluna1}, '${2:T}', '${3:M}') ${4:-- REPLACE FUNCIONA IGUAL NO MYSQL}",
	  "${5:--REPLACE(REPLACE(nome, 'T', 'M'), 't', 'm') AS coluna2 -- mantem coluna original e cria coluna editada}"
	],
	"description": "MUDAR_CARACTER_POR_OUTRO - VERSAO MYSQL"
},

// EXTRAI_TRECHO_DE_STRING - VERSÃO MYSQL
"EXTRAI_TRECHO_DE_STRING": {
	"scope": "sql",
	"prefix": "MYDDEXTR",
	"body": [
	  "SUBSTRING(${1:COLUNA}, ${2:1}, ${3:3}) AS ${4:EXTRATOR}  -- SUBSTRING FUNCIONA IGUAL NO MYSQL"
	],
	"description": "EXTRAI_TRECHO_DE_STRING - VERSAO MYSQL"
},

// TRANSFORMAR_NUMERO_EM_STRING - VERSÃO MYSQL
"TRANSFORMAR_NUMERO_EM_STRING": {
	"scope": "sql",
	"prefix": "MYDDNUM2STR",
	"body": [
	  "CAST(185.476 AS CHAR) AS NUMERO_STRING,  -- MYSQL USA CAST EM VEZ DE STR",
	  "FORMAT(185.476, 2) AS NUMERO_FORMATADO  -- FORMAT PARA FORMATAR COM 2 CASAS DECIMAIS"
	],
	"description": "TRANSFORMAR_NUMERO_EM_STRING - VERSAO MYSQL"
},

// DELETA_E_ACRESCENTA - VERSÃO MYSQL
"DELETA_E_ACRESCENTA": {
	"scope": "sql",
	"prefix": "MYDDDEL_ACRES",
	"body": [
	  "INSERT(${1:'SQL Tutorial'}, ${2:1}, ${3:3}, ${4:'HTML'})  -- MYSQL USA INSERT() EM VEZ DE STUFF()",
	  "-- OBS: INSERT(str, pos, len, newstr) - POSICAO COMEÇA EM 1"
	],
	"description": "DELETA_E_ACRESCENTA - VERSAO MYSQL"
},

// TRANSFORMAR_EM_MAIUSCULA - VERSÃO MYSQL
"TRANSFORMAR_EM_MAIUSCULA": {
	"scope": "sql",
	"prefix": "MYDDUPPER",
	"body": [
	  "UPPER(${1:COLUNA}) AS MAIUSCULA  -- UPPER FUNCIONA IGUAL NO MYSQL",
	  "LOWER(${1:COLUNA}) AS MINUSCULA  -- LOWER TAMBEM"
	],
	"description": "TRANSFORMAR_EM_MAIUSCULA - VERSAO MYSQL"
},

// MODULO_DO_NUMERO - VERSÃO MYSQL
"MODULO_DO_NUMERO": {
	"scope": "sql",
	"prefix": "MYMOD",
	"body": [
	  "ABS(-243.5) AS MODULO  -- ABS FUNCIONA IGUAL NO MYSQL"
	],
	"description": "MODULO_DO_NUMERO - VERSAO MYSQL"
},

// MEDIA - VERSÃO MYSQL
"MEDIA": {
	"scope": "sql",
	"prefix": "MYMED",
	"body": [
	  "AVG(${1:COLUNA}) AS MEDIA  -- AVG FUNCIONA IGUAL NO MYSQL"
	],
	"description": "MEDIA - VERSAO MYSQL"
},

// MAIOR - VERSÃO MYSQL
"MAIOR": {
	"scope": "sql",
	"prefix": "MYMAX",
	"body": [
	  "MAX(${1:COLUNA}) AS MAIOR_VALOR  -- MAX FUNCIONA IGUAL NO MYSQL"
	],
	"description": "MAIOR - VERSAO MYSQL"
},

// MENOR - VERSÃO MYSQL
"MENOR": {
	"scope": "sql",
	"prefix": "MYMIN",
	"body": [
	  "MIN(${1:COLUNA}) AS MENOR_VALOR  -- MIN FUNCIONA IGUAL NO MYSQL"
	],
	"description": "MENOR - VERSAO MYSQL"
},

// ARREDONDAR - VERSÃO MYSQL
"ARREDONDAR": {
	"scope": "sql",
	"prefix": "MYARRED",
	"body": [
	  "ROUND(235.415, 0) AS ARREDONDADO  -- ROUND FUNCIONA IGUAL NO MYSQL",
	  "-- TRUNCATE(235.415, 2) AS TRUNCADO  -- PARA TRUNCAR (CORTAR CASAS DECIMAIS)"
	],
	"description": "ARREDONDAR - VERSAO MYSQL"
},

// SOMAR - VERSÃO MYSQL
"SOMAR": {
	"scope": "sql",
	"prefix": "MYSUM",
	"body": [
	  "SUM(${1:COLUNA}) AS SOMA  -- SUM FUNCIONA IGUAL NO MYSQL"
	],
	"description": "SOMAR - VERSAO MYSQL"
},

// DATA_ATUAL - VERSÃO MYSQL
"DATA_ATUAL": {
	"scope": "sql",
	"prefix": "MYDTATUAL",
	"body": [
	  "NOW() AS DATA_HORA_ATUAL,  -- MYSQL USA NOW() (DATA+HORA)",
	  "CURDATE() AS DATA_ATUAL,  -- MYSQL USA CURDATE() (SÓ DATA)",
	  "CURTIME() AS HORA_ATUAL  -- MYSQL USA CURTIME() (SÓ HORA)"
	],
	"description": "DATA_ATUAL - VERSAO MYSQL"
},

// EXTRAIR_DATA - VERSÃO MYSQL
"EXTRAIR_DATA": {
	"scope": "sql",
	"prefix": "MYDTEXTRAIR",
	"body": [
	  "YEAR('2017-08-25') AS ANO,  -- MYSQL USA YEAR() DIRETO",
	  "MONTH('2017-08-25') AS MES,  -- MONTH() DIRETO",
	  "DAY('2017-08-25') AS DIA,  -- DAY() DIRETO",
	  "DAYNAME('2017-08-25') AS NOME_DIA,  -- NOME DO DIA",
	  "MONTHNAME('2017-08-25') AS NOME_MES  -- NOME DO MES",
	  "-- OBS: MYSQL NAO TEM DATENAME(), USE FUNCOES ESPECIFICAS"
	],
	"description": "EXTRAIR_DATA - VERSAO MYSQL"
},

// SOMAR_DATA - VERSÃO MYSQL
"SOMAR_DATA": {
	"scope": "sql",
	"prefix": "MYDTSOMAR",
	"body": [
	  "DATE_ADD(${5:COLUNA}, INTERVAL ${4:QTD} ${3:YEAR/MONTH/DAY/HOUR/MINUTE/SECOND}) AS ${6:NOVO_NOME},  -- MYSQL USA DATE_ADD",
	  "DATE_SUB(${5:COLUNA}, INTERVAL ${4:QTD} ${3:YEAR/MONTH/DAY}) AS ${6:NOVO_NOME_SUB}  -- MYSQL USA DATE_SUB PARA SUBTRAIR"
	],
	"description": "SOMAR DATA OU CALCULAR DIFERENCA - VERSAO MYSQL"
},

// SUBTRAIR_DATA - VERSÃO MYSQL
"SUBTRAIR_DATA": {
	"scope": "sql",
	"prefix": "MYDTSUBTRAIR",
	"body": [
	  "DATEDIFF(${2:COLUNA2}, ${3:COLUNA1}) AS ${4:NOVA_COLUNA}  -- MYSQL USA DATEDIFF(data_inicial, data_final)",
	  "-- OBS: DATEDIFF NO MYSQL RETORNA DIFERENCA EM DIAS"
	],
	"description": "SUBTRAIR_DATA - VERSAO MYSQL"
},

// CONVERTER_DATA - VERSÃO MYSQL
"CONVERTER_DATA": {
	"scope": "sql",
	"prefix": "MYDTCONVERT",
	"body": [
	  "DATE_FORMAT(${1:COLUNA}, '%d/%m/%Y') AS ${3:${1:COLUNA}},  -- MYSQL USA DATE_FORMAT",
	  "-- %d = dia (01-31), %m = mes (01-12), %Y = ano (4 digitos), %y = ano (2 digitos)",
	  "-- %H = hora 24h, %h = hora 12h, %i = minutos, %s = segundos",
	  "-- %W = nome do dia, %M = nome do mes",
	  "-- EXEMPLOS:",
	  "-- '%d/%m/%Y' = 25/08/2017",
	  "-- '%Y-%m-%d' = 2017-08-25",
	  "-- '%d-%m-%Y %H:%i:%s' = 25-08-2017 14:30:00"
	],
	"description": "CONVERTER_DATA - VERSAO MYSQL"
},

// COLA_DATA - VERSÃO MYSQL
"COLA_DATA": {
	"scope": "sql",
	"prefix": "MYCOLADATA",
	"body": [
	  "/*",
	  "MYSQL DATE_FORMAT - FORMATOS COMUNS:",
	  "'%d/%m/%Y'              = 25/08/2017",
	  "'%Y-%m-%d'              = 2017-08-25",
	  "'%d-%m-%Y'              = 25-08-2017",
	  "'%d.%m.%Y'              = 25.08.2017",
	  "'%Y-%m-%d %H:%i:%s'    = 2017-08-25 14:30:00",
	  "'%d/%m/%Y %H:%i'       = 25/08/2017 14:30",
	  "'%W, %d de %M de %Y'   = Sexta-feira, 25 de Agosto de 2017",
	  "'%a, %d %b %Y'         = Sex, 25 Aug 2017",
	  "/*"
	],
	"description": "COLA_DATA - VERSAO MYSQL"
},

// CONVERTER_TIPO_DE_DADOS - VERSÃO MYSQL
"CONVERTER_TIPO_DE_DADOS": {
	"scope": "sql",
	"prefix": "MYDDCONVERT",
	"body": [
	  "CAST(${2:CPF} AS UNSIGNED) AS ${2:CPF}  -- MYSQL USA CAST, TIPOS: UNSIGNED, CHAR, DATE, DATETIME, DECIMAL",
	  "-- OU: CONVERT(${2:CPF}, UNSIGNED) AS ${2:CPF}  -- CONVERT TAMBEM FUNCIONA (SINTAXE DIFERENTE)"
	],
	"description": "CONVERTER_TIPO_DE_DADOS - VERSAO MYSQL"
},

// IF - VERSÃO MYSQL
"IF": {
	"scope": "sql",
	"prefix": "MYIF",
	"body": [
	  "IF(${1:COLUNA}>1, 'YES', 'NO') AS STATUS  -- MYSQL USA IF() EM VEZ DE IIF()",
	  "-- =, <>, !=, >, <"
	],
	"description": "IF - VERSAO MYSQL"
},

// CASE_WHEN - VERSÃO MYSQL
"CASE_WHEN": {
	"scope": "sql",
	"prefix": "MYCASE",
	"body": [
	  "CASE",
	  "   WHEN ${1:SITUACAO1} THEN ${2:SITUACAO2}",
	  "   ${3:WHEN ${4:SITUACAO1} THEN ${5:SITUACAO2}}",
	  "   ELSE ${6:SITUACAO3}",
	  "END AS ${7:COLUNA}  -- CASE FUNCIONA IGUAL NO MYSQL"
	],
	"description": "CASE_WHEN - VERSAO MYSQL"
},

// JOIN - VERSÃO MYSQL
"JOIN": {
	"scope": "sql",
	"prefix": "MYJOIN",
	"body": [
	  "${1:LEFT} JOIN ${2:Tabela} ${3:B} ON ${4:A}.${5:coluna} = ${6:B}.${7:coluna}  -- JOIN FUNCIONA IGUAL NO MYSQL"
	],
	"description": "JOIN - VERSAO MYSQL"
},

// TRATAMENTO_DE_DADOS - VERSÃO MYSQL
"TRATAMENTO_DE_DADOS": {
	"scope": "sql",
	"prefix": "MYDDTRAT",
	"body": [
	  "${1:CASE}",
	  "      WHEN ${2:COLUNA} ${3:IS NOT NULL} THEN REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(NOMEUA_COMPLETO, 'Á', 'A'), 'Ã', 'A'), 'À', 'A'), 'Â', 'A'), 'É', 'E'), 'Ê', 'E'), 'Ó', 'O'), 'Õ', 'O'), 'Ú', 'U'), 'Ü', 'U'), 'Ç', 'C'), 'Ñ', 'N')",
	  "     ${1:ELSE COLUNA}",
	  "${1:END AS COLUNA}  -- REPLACE FUNCIONA IGUAL NO MYSQL"
	],
	"description": "TRATAR DADOS RETIRANDO CARACTERES ESPECIFICOS - VERSAO MYSQL"
},

// COMPARAR_DADOS_DE_TABELAS_DIFERENTES - VERSÃO MYSQL
"COMPARAR_DADOS_DE_TABELAS_DIFERENTES": {
	"scope": "sql",
	"prefix": "MYDDCOMPTABLE",
	"body": [
	  "SELECT",
	  "     CPF",
	  "FROM BASE1 A",
	  "WHERE EXISTS (  -- ou NOT EXISTS",
	  "SELECT",
	  "     CPF",
	  "FROM BASE2 B",
	  "WHERE A.CPF = B.CPF)  -- EXISTS FUNCIONA IGUAL NO MYSQL",
	  "-- OBS: MYSQL NAO USA # PARA TABELAS TEMPORARIAS"
	],
	"description": "COMPARAR_DADOS_DE_TABELAS_DIFERENTES - VERSAO MYSQL"
},

// INSERIR_DADOS_EM_TEMPORARIA - VERSÃO MYSQL
"INSERIR_DADOS_EM_TEMPORARIA": {
	"scope": "sql",
	"prefix": "MYDDINSTEMP",
	"body": [
	  "DROP TEMPORARY TABLE IF EXISTS ${1:BASE_TEMP};  -- MYSQL USA TEMPORARY TABLE",
	  "CREATE TEMPORARY TABLE ${1:BASE_TEMP} (",
	  "    ${2:COLUNA} ${3:VARCHAR}(${4:100})",
	  "    ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4",
	  "INSERT INTO ${1:BASE_TEMP} (${2:COLUNA}) VALUES",
	  "${5:('DADO1'),}",
	  "${5:('DADO2'),}",
	  "${5:('ETC...')}  -- MYSQL USA TEMPORARY TABLE EM VEZ DE #"
	],
	"description": "INSERIR_DADOS_EM_TEMPORARIA - VERSAO MYSQL"
},

// UNION_SEM_DUPLICATAS - VERSÃO MYSQL
"UNION_SEM_DUPLICATAS": {
	"scope": "sql",
	"prefix": "MYUNION",
	"body": [
	  "DROP TEMPORARY TABLE IF EXISTS ${1:BASE}_UNION;",
	  "CREATE TEMPORARY TABLE ${1:BASE}_UNION AS",
	  "SELECT",
	  "${2:COLUNA1}",
	  "${3:COLUNA2}",
	  "${4:COLUNA3}",
	  "FROM ${5:BASE1}",
	  "UNION",
	  "SELECT",
	  "${2:COLUNA1}",
	  "${3:COLUNA2}",
	  "${4:COLUNA3}",
	  "FROM ${6:BASE2}  -- UNION REMOVE DUPLICATAS, UNION ALL MANTEM",
	  "-- OBS: MYSQL USA CREATE TABLE ... AS SELECT EM VEZ DE SELECT INTO"
	],
	"description": "UNION_SEM_DUPLICATAS - VERSAO MYSQL"
},

// UNION_ALL_MANTEM_DUPLICATAS - VERSÃO MYSQL
"UNION_ALL_MANTEM_DUPLICATAS": {
	"scope": "sql",
	"prefix": "MYUNIONALL",
	"body": [
	  "DROP TEMPORARY TABLE IF EXISTS ${1:UNION_ALL};",
	  "CREATE TEMPORARY TABLE ${1:UNION_ALL} AS",
	  "SELECT",
	  "${2:COLUNA1}",
	  "${3:COLUNA2}",
	  "${4:COLUNA3}",
	  "FROM ${5:BASE1}",
	  "UNION ALL",
	  "SELECT",
	  "${2:COLUNA1}",
	  "${3:COLUNA2}",
	  "${4:COLUNA3}",
	  "FROM ${6:BASE2}  -- UNION ALL MANTEM DUPLICATAS",
	  "-- OBS: MYSQL USA CREATE TEMPORARY TABLE ... AS SELECT EM VEZ DE SELECT INTO"
	],
	"description": "UNION_ALL_MANTEM_DUPLICATAS - VERSAO MYSQL"
},

// REGIAO_ARQDEUA - VERSÃO MYSQL
"REGIAO_ARQDEUA": {
	"scope": "sql",
	"prefix": "MYARQ_CABECALHO",
	"body": [
	  "      B.REGIAO                      ,",
	  "      B.NOMEDE AS URE               ,",
	  "LEFT JOIN ARQDEUA0326 A ON A.UA = B.UA  -- JOIN FUNCIONA IGUAL NO MYSQL",
	  "-- OBS: MANTIDA A MESMA ESTRUTURA, APENAS O PREFIX FOI ALTERADO"
	],
	"description": "REGIAO E URE DE ARQDEUA - VERSAO MYSQL"
},

// ORDER_BY - VERSÃO MYSQL
"ORDER_BY": {
	"scope": "sql",
	"prefix": "MYORDER",
	"body": [
	  "ORDER BY REGIAO, URE, NOME  -- ORDER BY FUNCIONA IGUAL NO MYSQL"
	],
	"description": "ORDER BY - VERSAO MYSQL"
},

