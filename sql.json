// CRIAR E-MAIL DE ESCOLA - VERSÃO MYSQL
"CRIAR_E-MAIL_ESCOLA": {
	"scope": "sql",
	"prefix": "MYEMAIL",
	"body": [
	  "${1:CASE                                                              }",
	  "   WHEN CATESC='VINCULADA' THEN",
	  "      CONCAT('e', LPAD(ESCVINC, 6, '0'), 'a@educacao.sp.gov.br')  -- MYSQL USA LPAD EM VEZ DE FORMAT",
	  "   ELSE",
	  "       CONCAT('e', LPAD(CODESC, 6, '0'), 'a@educacao.sp.gov.br')  -- LPAD(6,'0') = 6 DIGITOS COM ZEROS A ESQUERDA",
	  "END",
	  "AS EMAIL",
	  "-- OBS: MYSQL USA LPAD(STRING, TAMANHO, '0') EM VEZ DE FORMAT(STRING, '000000')"
	],
	"description": "CRIACAO DE E-MAIL DE ESCOLAS - VERSAO MYSQL"
},

