	  "SELECT 'USE MYSQLDUMP NO TERMINAL PARA BACKUP' AS AVISO"
	],
	"description": "BACKUP_DE_BD - VERSAO MYSQL"
},

// CONCATENAR - VERSÃO MYSQL
"CONCATENAR": {
	"scope": "sql",
	"prefix": "MYCONC",
