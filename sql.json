	],
	"description": "TIPO DE DADOS DA TABELA POR COLUNA - VERSAO MYSQL"
},

// ALTERAR_TIPO_DADOS_COLUNA - VERSÃO MYSQL
"ALTERAR_TIPO_DADOS_COLUNA": {
	"scope": "sql",
	"prefix": "MYDDALTERTIPO",
	"body": [
	  "ALTER TABLE ${1:tabela} ${6:MODIFY COLUMN ${2:coluna1} ${3:TIPO}(${4:tamanho}) NULL  -- MYSQL USA MODIFY COLUMN EM VEZ DE ALTER COLUMN}",
	  "${5:-- VERIFICAR MYCOLA}"
	],
	"description": "ALTERAR O TIPO DE DADO DA COLUNA - VERSAO MYSQL"
},

// EXTRAIR_CARACTERES_DA_ESQUERDA_OU_DIREITA - VERSÃO MYSQL
"EXTRAIR_CARACTERES_DA_ESQUERDA_OU_DIREITA": {
	"scope": "sql",
	"prefix": "MYDDEXTRCHAR",
	"body": [
	  "${1:LEFT}${2:RIGHT}(${3:coluna}, ${4:3}) AS ${5:EXTRACAO_ESQUERDA}  -- LEFT E RIGHT FUNCIONAM IGUAL NO MYSQL"
	],
	"description": "EXTRAIR_CARACTERES_DA_ESQUERDA_OU_DIREITA - VERSAO MYSQL"
},

// LIMPAR_ESPACOS_VAZIOS_DA_ESQUERDA_OU_DIREITA - VERSÃO MYSQL
"LIMPAR_ESPACOS_VAZIOS_DA_ESQUERDA_OU_DIREITA": {
	"scope": "sql",
	"prefix": "MYDDLIMP1",
