	//leitor_testar_portas
	"leitor_testar_portas": {
		"prefix": "çtestaportascompleto",
		"body": [
			"${1:endereco_arquivo = r'${2:C:\\\\endereco.arq}}'",
			"",
			"#################### edição de texto lista_portas.txt ####################",
			"def editar_texto(linha):    ",
			"    texto = linha.split('#')[0]                         # Remove comentários",
			"    texto = texto.strip()                               # Remove espaços do início e fim",
			"    texto = re.sub(r'\\s+', ' ', texto)                  # Remove espaços extras (múltiplos viram um só)",
			"    texto = texto.replace(\" \", \"\")                      # Substitui \" \" por \"\"",
			"    texto = texto.lower()                               # Converte para minúsculo",
			"    texto = texto.upper()                               # Converte para maiúsculo",
			"    texto = re.sub(r'\\s+', ' ', texto).strip()          # Remove espaços extras novamente (por segurança)",
			"    texto = re.sub(r'[^a-zA-Z0-9\\s]', '', texto)        # Remove caracteres especiais (mantém letras, números e espaços)",
			"    ",
			"    texto = ''.join(                                    # Remove acentos    ",
			"        c for c in unicodedata.normalize('NFD', texto)",
			"        if unicodedata.category(c) != 'Mn'",
			"    )",
			"    ",
			"    for palavra in ['Porta', 'Port']:                   # Remove palavras-chave (opcional)",
			"        texto = texto.replace(palavra, '')",
			"    ",
			"    return texto",
			"",
			"#################### leitor lista_portas.txt ####################",
			"if os.path.exists(endereco_arquivo):",
			"    with open(endereco_arquivo, 'r', encoding='utf-8') as arquivo_lido:",
			"        leitura = [",
			"            editar_texto(linha) # edição de texto",
			"            for linha in arquivo_lido.readlines()[1:]",
			"            if linha.strip()     ",
			"        ]        ",
			"    leitura = [x for x in leitura if x] # Remove linhas vazias",
			"",
			"    print(Fore.LIGHTCYAN_EX + Style.BRIGHT + f\"\\n {len(leitura)} portas lidas\")",
			"else:",
			"    print(Fore.RED + f\"❌ Arquivo não encontrado: {endereco_arquivo}\")",
			"    leitura = []",
			"",
			"#################### teste de portas ####################",
			"def porta_em_uso(porta, host='localhost', timeout=1):",
			"    try:",
			"        sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)",
			"        sock.settimeout(timeout)",
			"        sock.bind((host, int(porta)))  # Converte para int",
			"        sock.close()",
			"        return False  # Porta livre",
			"    except OSError:",
			"        return True   # Porta ocupada",
			"    except ValueError:",
			"        return True   # Se não for número, considera ocupada",
			"    ",
			"# ==================== TESTAR PORTA A PORTA ====================",
			"print(Fore.CYAN + Style.BRIGHT + \"=\"*60)",
			"print(\"🔍 TESTANDO PORTAS UMA A UMA\")",
			"print(\"=\"*60)",
			"",
			"# Lista para armazenar resultados",
			"portas_ocupadas = []",
			"portas_livres = []",
			"",
			"for porta in leitura:",
			"    try:",
			"        porta_int = int(porta)  # Converte para inteiro",
			"        if porta_em_uso(porta_int):",
			"            print(Fore.RED + f\"  ⚠️ Porta {porta} está EM USO\")",
			"            portas_ocupadas.append(porta)",
			"        else:",
			"            print(Fore.GREEN + f\"  ✅ Porta {porta} está LIVRE\")",
			"            portas_livres.append(porta)",
			"    except ValueError:",
			"        print(Fore.YELLOW + f\"  ⚠️ '{porta}' não é um número válido\")",
			"",
			"# ==================== RELATÓRIO FINAL ====================",
			"print(\"\\n\" + \"=\"*60)",
			"print(Fore.CYAN + Style.BRIGHT + \"📊 RELATÓRIO FINAL\")",
			"print(\"=\"*60)",
			"print(f\"✅ Portas LIVRES: {len(portas_livres)}\")",
			"print(f\"⚠️ Portas EM USO: {len(portas_ocupadas)}\")",
			"",
			"if portas_ocupadas:",
			"    print(Fore.RED + f\"  Portas em uso: {', '.join(portas_ocupadas[:10])}\")",
			"    if len(portas_ocupadas) > 10:",
			"        print(f\"  ... e mais {len(portas_ocupadas) - 10} portas\")"
		],
		"description": "Leitor de lista de portas com teste porta a porta e relatório final"
	},

