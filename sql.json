	// WHERE
	"WHERE": {
	  "scope": "sql",
	  "prefix": "ZWHERE",
	  "body": [
		"${5:WHERE ${1:coluna1} ${2:LIKE} '%${3:DADO}%' ${4:-- LIKE '%%', NOT LIKE '%%', = '', <> '', MAIOR/MENOR/IGUAL, OR, AND, BETWEEN, IN ('','',''), NOT IN('','',''), NULL/NOTNULL}}"
	  ],
	  "description": "WHERE"
	},
  
	// WHEREDATAS
	"WHEREDATAS": {
	  "scope": "sql",
	  "prefix": "ZWHERED",
	  "body": [
		"${7:WHERE ${1:coluna1} BETWEEN '%${2:DATA1}%' AND '%${3:DATA2}%' ${6:-- LIKE '%%', NOT LIKE '%%', = '', <> '', MAIOR/MENOR/IGUAL, OR, AND, BETWEEN, IN ('','',''), NOT IN('','',''), NULL/NOTNULL}}",
		"${4:--YEAR(coluna1) = 2024}",
		"${5:--MONTH(coluna1) = 01}"
	  ],
	  "description": "WHERE_DATAS"
	},
  
	// ROWNUMBERSEMDUPLICATAS
	"ROWNUMBERSEMDUPLICATAS": {
	  "scope": "sql",
	  "prefix": "ZROW",
	  "body": [
		"WITH BASE_RANK${1:1} AS (",
		"   --SELECT *",
		"   --FROM BASE",
		"),",
		"RANK${2:1} AS (",
		"   SELECT *,",
		"      ROW_NUMBER() OVER (PARTITION BY ${3:CPF_DI} ORDER BY (SELECT NULL)) AS ROW${4:1} -- OU ORDER BY coluna1 DESC",
		"   FROM BASE_RANK${1:1}",
		")",
		"SELECT *",
		"FROM RANK${2:1}",
		"WHERE ROW${4:1} = 1 --PRIMEIRA LINHA DA DUPLICATA",
		"ORDER BY ${3:CPF_DI}"
	  ],
	  "description": "ROW_NUMBER"
	},
  
	// ROWNUMBERMULTIPLO
	"ROWNUMBERMULTIPLO": {
	  "scope": "sql",
	  "prefix": "ZROWMULT",
	  "body": [
		"WITH BASE_RANK${1:1} AS (",
		"   --SELECT *",
		"   --FROM BASE",
		"),",
		"RANK${2:1} AS (",
		"   SELECT *,",
		"      ROW_NUMBER() OVER (PARTITION BY ${3:coluna1} ORDER BY (SELECT NULL)) AS RANK_${3:coluna1}, -- OU ORDER BY ${3:coluna1} DESC",
		"      ROW_NUMBER() OVER (PARTITION BY ${4:coluna2} ORDER BY (SELECT NULL)) AS RANK_${4:coluna2} -- OU ORDER BY ${4:coluna2} DESC",
		"   FROM BASE_RANK${1:1}",
		")",
		"SELECT *",
		"INTO ${5:BASE_SEM_DUPLICIDADE}",
		"FROM RANK${2:1}",
		"WHERE RANK_${3:coluna1} = 1   -- Primeira linha de cada DADO DA COLUNA ${3:coluna1}",
		"   OR RANK_${4:coluna2} = 1   -- Primeira linha de cada DADO DA COLUNA ${4:coluna2}",
		"ORDER BY ${3:CPF_DI}"
	  ],
	  "description": "FILTRO DUPLO EM LISTA ÚNICA"
	},
  
	// EXTRAITEMPO
	"EXTRAITEMPO": {
	  "scope": "sql",
	  "prefix": "ZDDTEMP",
	  "body": [
		"YEAR(A.create_date) AS ANO_TABELA",
		"MONTH(A.create_date) AS MES_TABELA,",
		"DAY(A.create_date) AS DIA_TABELA,",
		"DATEPART(HOUR, A.create_date) AS HORA_TABELA,",
		"DATEPART(MINUTE, A.create_date) AS MINUTO_TABELA,",
		"DATEPART(SECOND, A.create_date) AS SEGUNDOS_TABELA"
	  ],
	  "description": "EXTRAI REGISTROS DE TEMPOS COMPOSTOS DD/MM/YYYY HH:MM:SS"
	},
  
	// COLADEDADOS
	"COLADEDADOS": {
	  "scope": "sql",
	  "prefix": "ZCOLADATA",
	  "body": [
		"/*",
		"REGRAS DE BOAS PRÁTICAS:",
		"  - VARCHAR para textos (a menos que precise de Unicode)",
		"  - Tipos numéricos para números (nunca guarde números em VARCHAR)",
		"  - Tipos de data para datas (nunca guarde datas em texto)",
		"  - Evite MAX a menos que necessário (índices não funcionam bem)",
		"",
		"TIPO          |                                        | OCUPAÇÃO       | EXEMPLO DE USO                 | O QUE ARMAZENA",
		"--------------|----------------------------------------|----------------|--------------------------------|-------------------------------",
		"BIT 0 ou 1                                             | 1 byte         | ativo BIT DEFAULT 1            | 1 (verdadeiro), 0 (falso)",
		"TINYINT(0 a 255)                                       | 1 byte         | idade TINYINT                  | 25, 0, 255",
		"INT(-2,1Bi a 2,1Bi)                                    | 4 bytes        | id INT IDENTITY(1,1)           | 1, 999, -4587",
		"DECIMAL(p,s) Até 38 dígitos                            | 5-17 bytes     | salario DECIMAL(10,2)          | 12345.67, -999.99",
		"NUMERIC(p,s) Mesmo que DECIMAL                         | 5-17 bytes     | nota NUMERIC(4,2)              | 9.75, 7.50",
		"MONEY(-922 tri a 922 tri)                              | 8 bytes        | salario MONEY                  | 5250.75, 125000.00",
		"FLOAT(-1.79E+308 a 1.79E+308)                          | 4 ou 8 bytes   | temperatura FLOAT              | 23.56789, -15.3",
		"CHAR(1 a 8000) Fixo, n = 1-8000                        | n bytes        | uf CHAR(2)                     | 'SP', 'RJ', 'MG'",
		"VARCHAR(1-8000) Variável, n = 1-8000                   | tam + 2 bytes  | nome VARCHAR(100)              | 'João Silva', 'Ana'",
		"VARCHAR(MAX) Até 2GB                                   | tam + 2 bytes  | observacao VARCHAR(MAX)        | Textos longos",
		"NCHAR(1 a 4000) Unicode fixo, n = 1-4000               | n * 2 bytes    | nome_japones NCHAR(50)         | '田中太郎'",
		"NVARCHAR(1-4000) Unicode var, n = 1-4000               | (tam*2)+2 bytes| nome_completo NVARCHAR(100)    | 'João', '张伟', '😊'",
		"NVARCHAR(MAX) Unicode até 2GB                          | (tam*2)+2 bytes| comentario NVARCHAR(MAX)       | Textos c/ emojis",
		"TEXT Obsoleto (use VARCHAR(MAX))                       | Variável       | descricao TEXT (evitar)        | 'Texto antigo...'",
		"NTEXT Obsoleto (use NVARCHAR(MAX))                     | Variável       | descricao NTEXT (evitar)       | 'Texto unicode antigo'",
		"DATE do tipo 0001-01-01 a 9999-12-31                   | 3 bytes        | data_nascimento DATE           | '1990-05-15'",
		"TIME(n) do tipo 00:00:00 a 23:59:59.9999999            | 3-5 bytes      | hora_entrada TIME              | '14:30:00'",
		"DATETIME do tipo 1753-01-01 a 9999-12-31               | 8 bytes        | data_cadastro DATETIME         | '2024-03-19 15:45:30'",
		"*/"
	  ],
	  "description": "Cola de tipos de dados SQL Server"
	},
  
	// IDPRIMEIRAVEZ
	"IDPRIMEIRAVEZ": {
	  "scope": "sql",
	  "prefix": "ZID",
	  "body": [
		"${1:ID INT IDENTITY(1,1) PRIMARY KEY}"
	  ],
	  "description": "ID_PRIMRIRA_VEZ"
	},
  
	// IDACRESCENTADOEMCOLUNA
	"IDACRESCENTADOEMCOLUNA": {
	  "scope": "sql",
	  "prefix": "ZID+",
	  "body": [
		"ALTER TABLE ${1:tabela}",
		"ADD ID INT IDENTITY(1,1) PRIMARY KEY"
	  ],
	  "description": "ACRESCENTA COLUNA ID COM PRIMARY KEY (direto)"
	},
  
	// CRIARTABELA
	"CRIARTABELA": {
	  "scope": "sql",
	  "prefix": "ZCRIARTAB",
	  "body": [
		"DROP TABLE IF EXISTS ${1:BASE}",
		"CREATE TABLE ${1:BASE} (",
		"    ${2:COLUNA1} VARCHAR(${3:100}),",
		"    ${4:COLUNA2} VARCHAR(${5:100})",
		")",
		" ",
		"INSERT INTO ${1:BASE} (${2:COLUNA1}, ${4:COLUNA2}) VALUES",
		"('${6:DADO}', '${7:DADO}'),",
		"('${8:DADO}', '${9:DADO}'),",
		"('${10:DADO}', '${11:DADO}')"
	  ],
	  "description": "CRIAR_TABELA"
	},
  
	// CRIARCOLUNA
	"CRIARCOLUNA": {
	  "scope": "sql",
	  "prefix": "ZCRIARCOL",
	  "body": [
		"ALTER TABLE ${1:nome_da_tabela}",
		"    ADD  ${2:coluna1} NVARCHAR(${3:100}) NULL,",
		"    ADD  ${4:coluna1} NVARCHAR(${5:100}) NULL"
	  ],
	  "description": "CRIAR_COLUNA"
	},
  
	// DROPTABLE
	"DROPTABLE": {
	  "scope": "sql",
	  "prefix": "ZDROP",
	  "body": [
		"${2:DROP TABLE IF EXISTS ${1:#BASE}}"
	  ],
	  "description": "DROP TABLE IF EXISTS"
	},
  
	// EXCLUIRCOLUNA
	"EXCLUIRCOLUNA": {
	  "scope": "sql",
	  "prefix": "ZEXCLCOL",
	  "body": [
		"ALTER TABLE ${1:tabela}",
		"DROP COLUMN ${2:coluna1}, ${3:coluna2}"
	  ],
	  "description": "EXCLUIR_COLUNA"
	},
  
	// EXCLUIRLINHASNULL
	"EXCLUIRLINHASNULL": {
	  "scope": "sql",
	  "prefix": "ZEXCLLINULL",
	  "body": [
		"DELETE FROM ${1:tabela}",
		"WHERE ${2:coluna1} IS NULL",
		"   AND ${3:coluna2} IS NULL",
		"   AND ${4:coluna3} IS NULL"
	  ],
	  "description": "EXCLUIR_LINHAS_NULL"
	},
  
	// COUNT
	"COUNT": {
	  "scope": "sql",
	  "prefix": "ZCOUNT",
	  "body": [
		"COUNT(${1:CPF+DI}) AS ${2:TOTAL} ${3:-- SUM(* OU COLUNA), AVG(* OU COLUNA), MAX(* OU COLUNA), MIN(* OU COLUNA) VEJA MAIS EM ZGROUP}"
	  ],
	  "description": "CONTAR E AGRUPAR"
	},
  
	// GROUPBY
	"GROUPBY": {
	  "scope": "sql",
	  "prefix": "ZGROUP",
	  "body": [
		"GROUP BY ${1:COLUNA1}",
		"${2:ORDER BY TOTAL DESC}"
	  ],
	  "description": "GROUP_BY"
	},
  
	// HAVING
	"HAVING": {
	  "scope": "sql",
	  "prefix": "ZCOUNTHAVING",
	  "body": [
		"HAVING ${1:COUNT(*) > 10 } -- FILTRAR APÓS O GROUP BY COM COUNT",
		"   ${2:AND AVG(preco) > 50}",
		"${3:ORDER BY TOTAL DESC}"
	  ],
	  "description": "HAVING = FILTRAR APÓS O GROUP BY"
	},
  
	// NULL
	"NULL": {
	  "scope": "sql",
	  "prefix": "ZNULL",
	  "body": [
		"ISNULL(${1:COLUNA},'') AS ${2:NOVO_NOME1},"
	  ],
	  "description": "NULL"
	},
  
// NULIFICA
"NULIFICA": {
	"scope": "sql",
	"prefix": "ZNULLIF",
	"body": [
	  "SELECT NULLIF(${1:COLUNA}, 25) AS SEM_25"
	],
	"description": "NULIFICA"
  },
  
  // COALESCE
  "COALESCE": {
	"scope": "sql",
	"prefix": "ZCOAL",
	"body": [
	  "COALESCE(${1:COLUNA}, '') AS ${1:COLUNA}"
	],
	"description": "COALESCE NULIFICANDO"
  },
  
  // COALESCESEMNULOS
  "COALESCESEMNULOS": {
	"scope": "sql",
	"prefix": "ZCOALNULLIF",
	"body": [
	  "COALESCE(NULLIF(${1:COLUNA1}, ''), ${2:COLUNA2}, '') AS ${3:NOVO_NOME} ,"
	],
	"description": "COALESCE com NULLIF para NOME, fallback para NOME_SERVIDOR e vazio"
  },
  
  // QUANTIDADEDECARACTERES
  "QUANTIDADEDECARACTERES": {
	"scope": "sql",
	"prefix": "ZDDQTDBYTE",
	"body": [
	  "DATALENGTH(${1:coluna1}) AS BYTE"
	],
	"description": "CONTA A QUANTIDADE DE CARACTERES"
  },
  
  // RENOMEARTABELA
  "RENOMEARTABELA": {
	"scope": "sql",
	"prefix": "ZRENTAB",
	"body": [
	  "EXEC sp_rename '${1:nome_atual}', '${2:novo_nome}'"
	],
	"description": "RENOMEIA TABELA"
  },
  
  // BACKUPDATABELA
  "BACKUPDATABELA": {
	"scope": "sql",
	"prefix": "ZBKPTAB",
	"body": [
	  "SELECT *",
	  "INTO #BKP",
	  "FROM ${1:BD} -- depois INTO BD_BKP FROM #BKP"
	],
	"description": "BACKUP_DA_TABELA"
  },
  
  // BACKUPDEBD
  "BACKUPDEBD": {
	"scope": "sql",
	"prefix": "ZBKPBD",
	"body": [
	  "BACKUP DATABASE ${1:CNOME_BD} TO DISK = 'C:ENDERECO_COMPLETO_NOME_BANCO_BACKUP.bak'"
	],
	"description": "BACKUP_DE_BD"
  },
  
  // CONCATENARCOLUNAS
  "CONCATENARCOLUNAS": {
	"scope": "sql",
	"prefix": "ZCONC",
	"body": [
	  "CONCAT(${1:col1},' - ', ${2:col2}) AS ${3:NOME}"
	],
	"description": "CONCATENAR COLUNAS"
  },
  
  // TIPODADOSTABELA
  "TIPODADOSTABELA": {
	"scope": "sql",
	"prefix": "ZDDTIPO",
	"body": [
	  "${2:EXEC sp_help '${1:nome_da_tabela}'}"
	],
	"description": "TIPO DE DADOS DA TABELA POR COLUNA"
  },
  
  // ALTERARTIPODADOSCOLUNA
  "ALTERARTIPODADOSCOLUNA": {
	"scope": "sql",
	"prefix": "ZDDALTERTIPO",
	"body": [
	  "ALTER TABLE ${1:tabela} ${6:ALTER COLUMN ${2:coluna1} ${3:TIPO}(${4:tamanho}) NULL ${5:-- VERIFICAR ZCOLA}}"
	],
	"description": "ALTERAR O TIPO DE DADO DA COLUNA"
  },
  
  // EXTRAIRCARACTERESDAESQUERDAOUDIREITA
  "EXTRAIRCARACTERESDAESQUERDAOUDIREITA": {
	"scope": "sql",
	"prefix": "ZDDEXTRCHAR",
	"body": [
	  "${1:LEFT}${2:RIGHT}(${3:coluna}, ${4:3}) AS ${5:EXTRACAO_ESQUERDA}"
	],
	"description": "EXTRAIR_CARACTERES_DA_ESQUERDA_OU_DIREITA"
  },
  
  // LIMPARESPACOSVAZIOSDAESQUERDAOUDIREITA
  "LIMPARESPACOSVAZIOSDAESQUERDAOUDIREITA": {
	"scope": "sql",
	"prefix": "ZDDLIMP1",
	"body": [
	  "${1:LTRIM}${2:RTRIM}(${3:COLUNA}) AS LIMPA_${4:ESQUERDA}${5:DIREITA}"
	],
	"description": "LIMPAR_ESPACOS_VAZIOS_DA_ESQUERDA_OU_DIREITA"
  },
  
  // LIMPARTODOSOSESPACOSVAZIOS
  "LIMPARTODOSOSESPACOSVAZIOS": {
	"scope": "sql",
	"prefix": "ZDDLIMP",
	"body": [
	  "TRIM('     SQL Tutorial!     ') AS SEM_ESPACOS"
	],
	"description": "LIMPAR_TODOS_OS_ESPACOS_VAZIOS"
  },
  
  // MUDARCARACTERPOROUTRO
  "MUDARCARACTERPOROUTRO": {
	"scope": "sql",
	"prefix": "ZDDMUDCHAR",
	"body": [
	  "REPLACE(${1:colnua1}, '${2:T}', '${3:M}') ${4:-- muda a coluna original onde é T vira M}",
	  "${5:--REPLACE(REPLACE(nome, 'T', 'M'), 't', 'm') AS coluna2 -- mantém coluna original e cria coluna editada}"
	],
	"description": "MUDAR_CARACTER_POR_OUTRO"
  },
  
  // EXTRAITRECHODESTRING
  "EXTRAITRECHODESTRING": {
	"scope": "sql",
	"prefix": "ZDDEXTR",
	"body": [
	  "SUBSTRING(${1:COLUNA}, ${2:1}, ${3:3}) AS ${4:EXTRATOR}"
	],
	"description": "EXTRAI_TRECHO_DE_STRING"
  },
  
  // TRANSFORMARNUMEROEMSTRING
  "TRANSFORMARNUMEROEMSTRING": {
	"scope": "sql",
	"prefix": "ZDDNUM2STR",
	"body": [
	  "STR(185.476, 6, 2)"
	],
	"description": "TRANSFORMAR_NUMERO_EM_STRING"
  },
  
  // DELETAEACRESCENTA
  "DELETAEACRESCENTA": {
	"scope": "sql",
	"prefix": "ZDDDEL_ACRES",
	"body": [
	  "STUFF('SQL Tutorial', 1, 3, 'HTML') -- COMEÇA DA POSIÇÃO CATRACTER 1, APAGA 3 CARACTERES A PARTIR DE 1 E ACRESCENTA HTML"
	],
	"description": "DELETA_E_ACRESCENTA"
  },
  
  // TRANSFORMAREMMAIUSCULA
  "TRANSFORMAREMMAIUSCULA": {
	"scope": "sql",
	"prefix": "ZDDUPPER",
	"body": [
	  "UPPER(${1:COLUNA})"
	],
	"description": "TRANSFORMAR_EM_MAIUSCULA"
  },
  
  // MODULODONUMERO
  "MODULODONUMERO": {
	"scope": "sql",
	"prefix": "ZMOD",
	"body": [
	  "Abs(-243.5) AS MODULO"
	],
	"description": "MÓDULO_DO_NUMERO"
  },
  
  // MEDIA
  "MEDIA": {
	"scope": "sql",
	"prefix": "ZMED",
	"body": [
	  "AVG(${1:COLUNA}) AS MEDIA"
	],
	"description": "MÉDIA"
  },
  
  // MAIOR
  "MAIOR": {
	"scope": "sql",
	"prefix": "ZMAX",
	"body": [
	  "MAX(${1:COLUNA}) AS MAIOR_VALOR"
	],
	"description": "MAIOR"
  },
  
  // MENOR
  "MENOR": {
	"scope": "sql",
	"prefix": "ZMIN",
	"body": [
	  "MIN(${1:COLUNA}) AS MENOR_VALOR"
	],
	"description": "MENOR"
  },
  
  // ARREDONDAR
  "ARREDONDAR": {
	"scope": "sql",
	"prefix": "ZARRED",
	"body": [
	  "ROUND(235.415, 0) AS ARREDONDADO"
	],
	"description": "ARREDONDAR"
  },
  
  // SOMAR
  "SOMAR": {
	"scope": "sql",
	"prefix": "ZSUM",
	"body": [
	  "SUM(${1:COLUNA}) AS SOMA"
	],
	"description": "SOMAR"
  },
  
  // DATAATUAL
  "DATAATUAL": {
	"scope": "sql",
	"prefix": "ZDTATUAL",
	"body": [
	  "CURRENT_TIMESTAMP"
	],
	"description": "DATA_ATUAL"
  },
  
  // EXTRAIRDATA
  "EXTRAIRDATA": {
	"scope": "sql",
	"prefix": "ZDTEXTRAIR",
	"body": [
	  "DATENAME(YEAR, '2017/08/25') AS DATE -- YEAR, MONTH, DAY"
	],
	"description": "EXTRAIR_DATA"
  },
  
  // SOMARDATA
  "SOMARDATA": {
	"scope": "sql",
	"prefix": "ZDTSOMAR",
	"body": [
	  "${1:DATEADD(${3:YEAR, MONTH, DAY}, ${4:QTD}, TRY_CAST(${5:COLUNA} AS DATE)) AS ${6:NOVO_NOME} -- SOMA DATA + QTD}"
	],
	"description": "SOMAR DATA OU CALCULAR DIFERENÇA"
  },
  
  // SUBTRAIRDATA
  "SUBTRAIRDATA": {
	"scope": "sql",
	"prefix": "ZDTSUBTRAIR",
	"body": [
	  "DATEDIFF(${1:YEAR, MONTH, DAY}, TRY_CAST(${2:COLUNA1} AS DATE), TRY_CAST(${3:COLUNA2} AS DATE)) AS ${4:NOVA_COLUNA}"
	],
	"description": "SUBTRAIR_DATA"
  },
  
  // CONVERTERDATA
  "CONVERTERDATA": {
	"scope": "sql",
	"prefix": "ZDTCONVERT",
	"body": [
	  "CONVERT(VARCHAR(10), TRY_CAST(${1:COLUNA} AS DATE), ${2:103}) AS ${3:${1:COLUNA}}, ${4:-- 101 = mm/dd/yyyy; 102 = yyyy.mm.dd; 103 = dd/mm/yyyy; 104 = dd.mm.yyyy; 105 = dd-mm-yyyy; 120 = yyyy-mm-dd hh:mi:ss; 126 = yyyy-mm-ddThh:mi:ss.mmm }"
	],
	"description": "CONVERTER_DATA"
  },
  
  // COLADATA
  "COLADATA": {
	"scope": "sql",
	"prefix": "ZCOLADATA",
	"body": [
	  "/*",
	  "101 = mm/dd/yyyy",
	  "102 = yyyy.mm.dd",
	  "103 = dd/mm/yyyy",
	  "104 = dd.mm.yyyy",
	  "105 = dd-mm-yyyy",
	  "120 = yyyy-mm-dd hh:mi:ss",
	  "126 = yyyy-mm-ddThh:mi:ss.mmm",
	  "*/"
	],
	"description": "COLA_DATA"
  },
  
  // CONVERTERTIPODEDADOS
  "CONVERTERTIPODEDADOS": {
	"scope": "sql",
	"prefix": "ZDDCONVERT",
	"body": [
	  "CONVERT(${1:BIGINT}, A.${2:CPF}) AS ${2:CPF}"
	],
	"description": "CONVERTER_TIPO_DE_DADOS"
  },
  
  // IF
  "IF": {
	"scope": "sql",
	"prefix": "ZIF",
	"body": [
	  "IIF(${1:COLUNA}>1, 'YES', 'NO') -- =, <>, !=, >, <"
	],
	"description": "IF"
  },
  
  // CASEWHEN
  "CASEWHEN": {
	"scope": "sql",
	"prefix": "ZCASE",
	"body": [
	  "CASE",
	  "   WHEN ${1:SITUACAO1} THEN ${2:SITUACAO2}",
	  "   ${3:WHEN ${4:SITUACAO1} THEN ${5:SITUACAO2}}",
	  "   ELSE ${6:SITUACAO3}",
	  "END AS ${7:COLUNA}"
	],
	"description": "CASE_WHEN"
  },
  
  // JOIN
  "LEFTJOIN": {
	"scope": "sql",
	"prefix": "ZJOIN",
	"body": [
	  "${1:LEFT} JOIN ${2:Tabela} ${3:B} ON ${4:A}.${5:coluna} = ${6:B}.${7:coluna}"
	],
	"description": "LEFTJOIN"
  },
  
  // TRATAMENTODEDADOS
  "TRATAMENTODEDADOS": {
	"scope": "sql",
	"prefix": "ZDDTRAT",
	"body": [
	  "${1:CASE}",
	  "      WHEN ${2:COLUNA} ${3:IS NOT NULL} THEN REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(NOMEUA_COMPLETO, 'Á', 'A'), 'Ã', 'A'), 'À', 'A'), 'Â', 'A'), 'É', 'E'), 'Ê', 'E'), 'Ó', 'O'), 'Õ', 'O'), 'Ú', 'U'), 'Ü', 'U'), 'Ç', 'C'), 'Ñ', 'N')",
	  "     ${1:ELSE COLUNA}",
	  "${1:END AS COLUNA}"
	],
