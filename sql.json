	  "      WHEN ${1:COLUNA} = 'O' THEN 'O - TEMPORÁRIO'",
	  "      WHEN ${1:COLUNA} = 'P' THEN 'P - ESTÁVEL'",
	  "      WHEN ${1:COLUNA} = '8' THEN '8 - COMISSIONADO'",
	  "      WHEN ${1:COLUNA} = '9' THEN '9 - COMISSIONADO'",
