  // TIRARTRAOOSEPONTOSCPF
  "TIRARTRAOOSEPONTOSCPF": {
	"scope": "sql",
	"prefix": "ZCPFSEMPONTOS",
	"body": [
	  "REPLACE(REPLACE(A.CPF, '.', ''), '-', '') AS CPF_LIMPO ,"
