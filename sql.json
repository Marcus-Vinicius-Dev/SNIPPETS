			"    # ===== INFORMAÇÕES BÁSICAS =====",
			"    stats = os.stat(arquivo)",
			"    print(Fore.YELLOW + f'📏 Tamanho: {stats.st_size} bytes')",
			"    print(Fore.YELLOW + f'🕐 Modificado: {stats.st_mtime}')",
			"    ",
			"    # ===== TENTA LER COM PYTHON-PPTX =====",
			"    try:",
			"        from pptx import Presentation",
			"        print(Fore.CYAN + '\\n📄 Lendo com python-pptx...')",
			"        ",
			"        prs = Presentation(arquivo)",
			"        print(Fore.GREEN + f'📌 Número de slides: {len(prs.slides)}')",
			"        ",
			"        texto_completo = []",
			"        for i, slide in enumerate(prs.slides[:5]):",
			"            slide_text = []",
			"            for shape in slide.shapes:",
			"                if hasattr(shape, 'text') and shape.text.strip():",
			"                    slide_text.append(shape.text.strip())",
			"            if slide_text:",
			"                texto_completo.append(f'--- Slide {i+1} ---\\n' + '\\n'.join(slide_text))",
			"        ",
			"        if texto_completo:",
			"            print(Fore.CYAN + f'\\n📄 CONTEÚDO (primeiros 500 caracteres):')",
			"            print(Fore.WHITE + '-'*50)",
			"            print('\\n'.join(texto_completo)[:500])",
			"            print(Fore.WHITE + '-'*50)",
			"        else:",
			"            print(Fore.YELLOW + '⚠️ Nenhum texto encontrado nos slides')",
			"        ",
			"    except ImportError:",
			"        print(Fore.RED + '\\n❌ Biblioteca \\'python-pptx\\' NÃO INSTALADA!')",
			"        print(Fore.YELLOW + '💡 Instale com: pip install python-pptx')",
			"        print(Fore.CYAN + '\\n📄 Mostrando informações básicas do arquivo:')",
			"        print(Fore.WHITE + f'  Nome: {arquivo}')",
			"        print(Fore.WHITE + f'  Tamanho: {stats.st_size} bytes')",
			"        print(Fore.WHITE + f'  Local: {os.getcwd()}')",
			"        ",
			"        # ===== TENTA LER COMO ZIP (PPTX é ZIP) =====",
			"        try:",
			"            import zipfile",
			"            print(Fore.CYAN + '\\n📄 Tentando ler estrutura interna (ZIP)...')",
			"            with zipfile.ZipFile(arquivo, 'r') as z:",
			"                arquivos_internos = z.namelist()",
			"                print(Fore.GREEN + f'📌 Arquivos internos: {len(arquivos_internos)}')",
			"                for nome in arquivos_internos[:10]:",
			"                    print(Fore.WHITE + f'  - {nome}')",
			"                if len(arquivos_internos) > 10:",
			"                    print(Fore.YELLOW + f'  ... (e mais {len(arquivos_internos) - 10})')",
			"        except:",
			"            pass",
			"            ",
			"    except Exception as e:",
			"        print(Fore.RED + f'\\n❌ Erro ao ler: {e}')",
			"else:",
			"    print(Fore.RED + Style.BRIGHT + f\"\\n❌ Arquivo '{arquivo}' NÃO ENCONTRADO!\")"
		],
		"description": "Lê arquivo PPTX com python-pptx"
	},

