			"",
			"# ============================================================",
			"# 3. PING",
			"# ============================================================",
			"print(Fore.GREEN + Style.BRIGHT + '\\n🔄 PING')",
			"print(Fore.WHITE + '-'*70)",
			"",
			"# Ping para Google",
			"try:",
			"    if platform.system() == 'Windows':",
			"        ping = subprocess.run(['ping', '-n', '4', '8.8.8.8'], capture_output=True, text=True)",
			"    else:",
			"        ping = subprocess.run(['ping', '-c', '4', '8.8.8.8'], capture_output=True, text=True)",
			"    ",
			"    if 'TTL' in ping.stdout or 'ttl' in ping.stdout:",
			"        print(Fore.WHITE + '  ✅ Google (8.8.8.8): CONECTADO')",
			"        tempos = re.findall(r'tempo[=<](\\d+)ms', ping.stdout)",
			"        if tempos:",
			"            tempos_int = [int(t) for t in tempos]",
			"            print(Fore.WHITE + f'    Min: {min(tempos_int)} ms')",
			"            print(Fore.WHITE + f'    Máx: {max(tempos_int)} ms')",
			"            print(Fore.WHITE + f'    Média: {sum(tempos_int)//len(tempos_int)} ms')",
			"    else:",
			"        print(Fore.RED + '  ❌ Google (8.8.8.8): FALHOU')",
			"except:",
			"    print(Fore.YELLOW + '  ⚠️ Ping não disponível')",
			"",
			"# Ping para Gateway",
			"try:",
			"    if platform.system() == 'Windows':",
			"        route = subprocess.run(['route', 'print'], capture_output=True, text=True)",
			"        linhas = route.stdout.split('\\n')",
			"        gateway = None",
			"        for linha in linhas:",
			"            if '0.0.0.0' in linha and '192.168' in linha:",
			"                partes = linha.split()",
			"                if len(partes) >= 3:",
			"                    gateway = partes[2]",
			"                    break",
			"        ",
			"        if gateway:",
			"            ping_gw = subprocess.run(['ping', '-n', '2', gateway], capture_output=True, text=True)",
			"            if 'TTL' in ping_gw.stdout or 'ttl' in ping_gw.stdout:",
			"                print(Fore.WHITE + f'  ✅ Gateway ({gateway}): CONECTADO')",
			"            else:",
			"                print(Fore.RED + f'  ❌ Gateway ({gateway}): FALHOU')",
			"except:",
			"    pass",
			"",
			"# ============================================================",
			"# 4. PORTAS ABERTAS",
			"# ============================================================",
			"print(Fore.GREEN + Style.BRIGHT + '\\n🔌 PORTAS ABERTAS (TCP)')",
			"print(Fore.WHITE + '-'*70)",
			"",
			"try:",
			"    conexoes = psutil.net_connections(kind='tcp')",
			"    portas_abertas = {}",
			"    for conn in conexoes:",
			"        if conn.status == 'LISTEN':",
			"            porta = conn.laddr.port",
			"            if porta not in portas_abertas:",
			"                portas_abertas[porta] = []",
			"            portas_abertas[porta].append(conn.laddr.ip)",
			"    ",
			"    for porta, ips in sorted(portas_abertas.items()):",
			"        ips_str = ', '.join(set(ips[:3]))",
			"        print(Fore.WHITE + f'  Porta {porta}: {ips_str}')",
			"        if len(ips) > 3:",
			"            print(Fore.WHITE + f'    + {len(ips) - 3} mais IPs')",
			"    ",
			"    print(Fore.WHITE + f'  Total: {len(portas_abertas)} portas abertas')",
			"",
			"except:",
			"    print(Fore.YELLOW + '  Não disponível')",
			"",
			"# ============================================================",
			"# 5. CONEXÕES ATIVAS (Top 10)",
			"# ============================================================",
			"print(Fore.GREEN + Style.BRIGHT + '\\n🔗 CONEXÕES ATIVAS (Top 10)')",
			"print(Fore.WHITE + '-'*70)",
			"",
			"try:",
			"    conexoes = psutil.net_connections(kind='tcp')",
			"    conexoes_ativas = [c for c in conexoes if c.status == 'ESTABLISHED']",
			"    ",
			"    for i, conn in enumerate(conexoes_ativas[:10]):",
			"        if conn.raddr:",
			"            ip = conn.raddr.ip",
			"            porta = conn.raddr.port",
			"            print(Fore.WHITE + f'  {i+1:2}. {ip}:{porta} -> {conn.laddr.ip}:{conn.laddr.port}')",
			"    ",
			"    if len(conexoes_ativas) > 10:",
			"        print(Fore.YELLOW + f'  ... e mais {len(conexoes_ativas) - 10} conexões')",
			"",
			"except:",
			"    print(Fore.YELLOW + '  Não disponível')",
			"",
			"# ============================================================",
			"# 6. IP PÚBLICO",
			"# ============================================================",
			"print(Fore.GREEN + Style.BRIGHT + '\\n🌍 IP PÚBLICO')",
			"print(Fore.WHITE + '-'*70)",
			"",
			"try:",
			"    import requests",
			"    ip = requests.get('https://api.ipify.org', timeout=5).text.strip()",
			"    print(Fore.WHITE + f'  IP Público: {ip}')",
			"    ",
			"    # Geolocalização",
			"    try:",
			"        geo = requests.get(f'https://ipapi.co/{ip}/json/', timeout=5).json()",
			"        if 'city' in geo:",
			"            print(Fore.WHITE + f\"  Cidade: {geo.get('city', 'N/A')}\")",
			"            print(Fore.WHITE + f\"  Região: {geo.get('region', 'N/A')}\")",
			"            print(Fore.WHITE + f\"  País: {geo.get('country_name', 'N/A')}\")",
			"            print(Fore.WHITE + f\"  ISP: {geo.get('org', 'N/A')}\")",
			"    except:",
			"        pass",
			"except:",
			"    print(Fore.YELLOW + '  Não disponível (sem internet?)')",
			"",
			"# ============================================================",
			"# 7. DNS",
			"# ============================================================",
			"print(Fore.GREEN + Style.BRIGHT + '\\n📡 DNS')",
			"print(Fore.WHITE + '-'*70)",
			"",
			"try:",
			"    if platform.system() == 'Windows':",
			"        dns = subprocess.run(['ipconfig', '/all'], capture_output=True, text=True)",
			"        for linha in dns.stdout.split('\\n'):",
			"            if 'Servidores DNS' in linha or 'DNS Servers' in linha:",
			"                # Limpa caracteres especiais",
			"                dns_linha = linha.replace('Servidores DNS . . . . . . . . . . . :', '')",
			"                dns_linha = dns_linha.replace('DNS Servers . . . . . . . . . . . :', '')",
			"                dns_linha = dns_linha.strip()",
			"                if dns_linha:",
			"                    print(Fore.WHITE + f'  {dns_linha}')",
			"except:",
			"    print(Fore.YELLOW + '  Não disponível')",
			"",
			"# ============================================================",
			"# 8. ROTA",
			"# ============================================================",
			"print(Fore.GREEN + Style.BRIGHT + '\\n🗺️ ROTA (Primeiras 10)')",
			"print(Fore.WHITE + '-'*70)",
			"",
			"try:",
			"    if platform.system() == 'Windows':",
			"        route = subprocess.run(['route', 'print'], capture_output=True, text=True)",
			"        linhas = route.stdout.split('\\n')",
			"        count = 0",
			"        for linha in linhas:",
			"            if '192.168' in linha or '0.0.0.0' in linha:",
			"                if count < 10:",
			"                    print(Fore.WHITE + f'  {linha[:80]}')",
			"                    count += 1",
			"        if count == 0:",
			"            print(Fore.YELLOW + '  Nenhuma rota encontrada')",
			"except:",
			"    print(Fore.YELLOW + '  Não disponível')",
			"",
			"print(Fore.CYAN + Style.BRIGHT + '\\n' + '='*70)",
			"print('✅ DIAGNÓSTICO DE REDE CONCLUÍDO!')",
			"print('='*70)"
		],
		"description": "Diagnóstico completo de rede"
	},

