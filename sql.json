// E-MAILS_VAZIOS - VERSÃO MYSQL
"E-MAILS_VAZIOS": {
	"scope": "sql",
	"prefix": "MYEMAVAZIO",
	"body": [
	  "${2:COALESCE(NULLIF(EMAIL_INST2, ''), EMAIL_INST1) AS EMAILI_DIRETOR,  -- NULLIF converte string vazia para NULL, COALESCE funciona igual no MySQL}",
	  "${1:-- COALESCE(NULLIF(EMAIL_INST2, ''), NULLIF(EMAIL_INST1, ''), 'SEM_EMAIL') AS EMAIL_DIRETOR -- valor padrao quando ambos forem vazios}"
	],
	"description": "E-MAILS_VAZIOS - VERSAO MYSQL"
},

// WHERE - VERSÃO MYSQL
"WHERE": {
	"scope": "sql",
	"prefix": "MYWHERE",
	"body": [
	  "${5:WHERE ${1:coluna1} ${2:LIKE} '%${3:DADO}%' ${4:-- LIKE '%%', NOT LIKE '%%', = '', <> '', MAIOR/MENOR/IGUAL, OR, AND, BETWEEN, IN ('','',''), NOT IN('','',''), NULL/NOTNULL}}"
	],
	"description": "WHERE - VERSAO MYSQL"
},

// WHERE_DATAS - VERSÃO MYSQL
"WHERE_DATAS": {
	"scope": "sql",
	"prefix": "MYWHERED",
	"body": [
	  "${7:WHERE ${1:coluna1} BETWEEN '${2:DATA1}' AND '${3:DATA2}' ${6:-- BETWEEN NO MYSQL USA ASPAS SIMPLES, NAO %}}",
	  "${4:--YEAR(coluna1) = 2024}",
	  "${5:--MONTH(coluna1) = 01}",
	  "-- OBS: MYSQL USA YEAR() E MONTH() IGUAL AO T-SQL"
	],
	"description": "WHERE_DATAS - VERSAO MYSQL"
},

// ROW_NUMBER_SEM_DUPLICATAS - VERSÃO MYSQL
"ROW_NUMBER_SEM_DUPLICATAS": {
	"scope": "sql",
	"prefix": "MYROW",
	"body": [
	  "$5WITH BASE_RANK${1:1} AS (",
	  "   --SELECT *",
	  "   --FROM BASE",
	  "),",
	  "RANK${2:1} AS (",
	  "   SELECT *,",
	  "      ROW_NUMBER() OVER (PARTITION BY ${3:CPF_DI} ORDER BY (SELECT NULL)) AS ROW${4:1} -- ROW_NUMBER FUNCIONA IGUAL NO MYSQL 8.0+",
	  "   FROM BASE_RANK${1:1}",
	  ")",
	  "SELECT *",
	  "FROM RANK${2:1}",
	  "WHERE ROW${4:1} = 1 -- PRIMEIRA LINHA DA DUPLICATA",
	  "ORDER BY ${3:CPF_DI}",
	  "-- OBS: MYSQL 8.0+ SUPORTA ROW_NUMBER() OVER()"
	],
	"description": "ROW_NUMBER - VERSAO MYSQL"
},

// ROW_NUMBER_MULTIPLO - VERSÃO MYSQL
"ROW_NUMBER_MULTIPLO": {
	"scope": "sql",
	"prefix": "MYROWMULT",
	"body": [
	  "$6WITH BASE_RANK${1:1} AS (",
	  "   --SELECT *",
	  "   --FROM BASE",
	  "),",
	  "RANK${2:1} AS (",
	  "   SELECT *,",
	  "      ROW_NUMBER() OVER (PARTITION BY ${3:coluna1} ORDER BY (SELECT NULL)) AS RANK_${3:coluna1}, -- ROW_NUMBER FUNCIONA NO MYSQL 8.0+",
	  "      ROW_NUMBER() OVER (PARTITION BY ${4:coluna2} ORDER BY (SELECT NULL)) AS RANK_${4:coluna2}",
	  "   FROM BASE_RANK${1:1}",
	  ")",
	  "SELECT *",
	  "INTO ${5:BASE_SEM_DUPLICIDADE}",
	  "FROM RANK${2:1}",
	  "WHERE RANK_${3:coluna1} = 1   -- Primeira linha de cada DADO DA COLUNA ${3:coluna1}",
	  "   OR RANK_${4:coluna2} = 1   -- Primeira linha de cada DADO DA COLUNA ${4:coluna2}",
	  "ORDER BY ${3:CPF_DI}",
	  "-- OBS: MySQL 8.0+ suporta ROW_NUMBER() igual ao T-SQL"
	],
	"description": "FILTRO DUPLO EM LISTA UNICA - VERSAO MYSQL"
},

// EXTRAI_TEMPO - VERSÃO MYSQL
"EXTRAI_TEMPO": {
	"scope": "sql",
	"prefix": "MYDDTEMP",
	"body": [
	  "YEAR(A.create_date) AS ANO_TABELA,  -- MYSQL USA YEAR() IGUAL AO T-SQL",
	  "MONTH(A.create_date) AS MES_TABELA,  -- MONTH() IGUAL AO T-SQL",
	  "DAY(A.create_date) AS DIA_TABELA,  -- DAY() IGUAL AO T-SQL",
	  "HOUR(A.create_date) AS HORA_TABELA,  -- MYSQL USA HOUR() EM VEZ DE DATEPART(HOUR)",
	  "MINUTE(A.create_date) AS MINUTO_TABELA,  -- MINUTE() EM VEZ DE DATEPART(MINUTE)",
	  "SECOND(A.create_date) AS SEGUNDOS_TABELA  -- SECOND() EM VEZ DE DATEPART(SECOND)",
	  "-- OBS: MYSQL USA HOUR(), MINUTE(), SECOND() EM VEZ DE DATEPART()"
	],
	"description": "EXTRAI REGISTROS DE TEMPOS COMPOSTOS DD/MM/YYYY HH:MM:SS - VERSAO MYSQL"
},

// COLA_DE_DADOS - VERSÃO MYSQL
"COLA_DE_DADOS": {
	"scope": "sql",
	"prefix": "MYCOLADATA",
	"body": [
	  "/*",
	  "REGRAS DE BOAS PRATICAS:",
	  "  - VARCHAR para textos (a menos que precise de Unicode)",
	  "  - Tipos numericos para numeros (nunca guarde numeros em VARCHAR)",
	  "  - Tipos de data para datas (nunca guarde datas em texto)",
	  "  - Evite MAX a menos que necessario (indices nao funcionam bem)",
	  "",
	  "TIPO          |                                        | OCUPACAO       | EXEMPLO DE USO                 | O QUE ARMAZENA",
	  "--------------|----------------------------------------|----------------|--------------------------------|-------------------------------",
	  "BIT 0 ou 1                                             | 1 byte         | ativo BIT DEFAULT 1            | 1 (verdadeiro), 0 (falso)",
	  "TINYINT(0 a 255)                                       | 1 byte         | idade TINYINT                  | 25, 0, 255",
	  "INT(-2,1Bi a 2,1Bi)                                    | 4 bytes        | id INT AUTO_INCREMENT          | 1, 999, -4587",
	  "DECIMAL(p,s) Até 38 digitos                            | 5-17 bytes     | salario DECIMAL(10,2)          | 12345.67, -999.99",
	  "NUMERIC(p,s) Mesmo que DECIMAL                         | 5-17 bytes     | nota NUMERIC(4,2)              | 9.75, 7.50",
	  "FLOAT(-1.79E+308 a 1.79E+308)                          | 4 ou 8 bytes   | temperatura FLOAT              | 23.56789, -15.3",
	  "CHAR(1 a 255) Fixo                                     | n bytes        | uf CHAR(2)                     | 'SP', 'RJ', 'MG'",
	  "VARCHAR(1-65535) Variável                              | tam + 1 byte   | nome VARCHAR(100)              | 'Joao Silva', 'Ana'",
	  "VARCHAR(MAX) Até 2GB                                   | tam + 2 bytes  | observacao TEXT                | Textos longos",
	  "TEXT Até 65535 caracteres                              | tam + 2 bytes  | descricao TEXT                 | 'Texto longo...'",
	  "LONGTEXT Até 4GB                                      | tam + 4 bytes  | comentario LONGTEXT            | Textos muito longos",
	  "DATE do tipo 1000-01-01 a 9999-12-31                   | 3 bytes        | data_nascimento DATE           | '1990-05-15'",
	  "TIME do tipo -838:59:59 a 838:59:59                    | 3 bytes        | hora_entrada TIME              | '14:30:00'",
	  "DATETIME do tipo 1000-01-01 a 9999-12-31               | 8 bytes        | data_cadastro DATETIME         | '2024-03-19 15:45:30'",
	  "TIMESTAMP do tipo 1970-01-01 a 2038-01-19              | 4 bytes        | data_atualizacao TIMESTAMP     | '2024-03-19 15:45:30'",
	  "*/",
	  "-- OBS: MYSQL USA AUTO_INCREMENT EM VEZ DE IDENTITY",
	  "-- MYSQL NAO TEM MONEY (USE DECIMAL(19,4))",
	  "-- MYSQL NAO TEM NCHAR/NVARCHAR (USE CHAR/VARCHAR COM COLLATE utf8mb4)"
	],
	"description": "Cola de tipos de dados - VERSAO MYSQL"
},

