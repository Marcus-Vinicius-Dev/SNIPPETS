  // TIRARZEROSESQUERDACPF
  "TIRARZEROSESQUERDACPF": {
	"scope": "sql",
	"prefix": "ZCPFZERO",
	"body": [
	  "DROP TABLE IF EXISTS #CPF_${1:NOME}_SEM_0",
	  "SELECT ",
	  "CAST(CPF AS BIGINT) AS CPF",
	  "INTO #CPF_${1:NOME}_SEM_0",
	  "FROM ${2:BASE}"
