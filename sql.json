	},
  
	// TRATAMENTO_DE_DADOS
	"TRATAMENTO_DE_DADOS": {
	  "scope": "sql",
	  "prefix": "ZDDTRAT",
	  "body": [
		"${1:CASE}",
		"      WHEN ${2:COLUNA} ${3:IS NOT NULL} THEN REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(NOMEUA_COMPLETO, 'Á', 'A'), 'Ã', 'A'), 'À', 'A'), 'Â', 'A'), 'É', 'E'), 'Ê', 'E'), 'Ó', 'O'), 'Õ', 'O'), 'Ú', 'U'), 'Ü', 'U'), 'Ç', 'C'), 'Ñ', 'N')",
		"     ${1:ELSE COLUNA}",
		"${1:END AS COLUNA}"
	  ],
	  "description": "TRATAR DADOS RETIRANDO CARACTERES ESPECÍFICOS"
	},
  
	// COMPARAR_DADOS_DE_TABELAS_DIFERENTES
	"COMPARAR_DADOS_DE_TABELAS_DIFERENTES": {
	  "scope": "sql",
	  "prefix": "ZDDCOMPTABLE",
	  "body": [
		"SELECT",
		"     CPF",
		"FROM #BASE1 A",
		"WHERE EXISTS (  -- ou NOT EXISTS",
		"SELECT",
		"     CPF",
		"FROM #BASE2 B",
		"WHERE A.CPF = B.CPF)"
	  ],
	  "description": "COMPARAR_DADOS_DE_TABELAS_DIFERENTES"
	},
  
	// INSERIR_DADOS_EM_TEMPORARIA
	"INSERIR_DADOS_EM_TEMPORARIA": {
	  "scope": "sql",
	  "prefix": "ZDDINSTEMP",
	  "body": [
		"DROP TABLE IF EXISTS #${1:BASE_TEMP}",
	  "CREATE TABLE #${1:BASE_TEMP} (",
		"    ${2:COLUNA} ${3:VARCHAR}(${4:100})",
	  "    )",
		"INSERT INTO #${1:BASE_TEMP} (${2:COLUNA}) VALUES",
		"${5:('DADO1'),}",
	  "${5:('DADO2'),}",
		"${5:('ETC...'),}"
	  ],
	  "description": "INSERIR_DADOS_EM_TEMPORARIA"
	},
  
	  // UNION_SEM_DUPLICATAS
	"UNION_SEM_DUPLICATAS": {
	  "scope": "sql",
	  "prefix": "ZUNION",
	  "body": [
		"${7:DROP TABLE IF EXISTS ${1:#BASE}_UNION}",
		"SELECT",
		"${2:COLUNA1}",
		"${3:COLUNA2}",
		"${4:COLUNA2}",
		"INTO ${1:#BASE}_UNION",
		"FROM ${5:#BASE1}",
		"UNION",
		"SELECT",
		"${2:COLUNA1}",
		"${3:COLUNA2}",
		"${4:COLUNA2}",
		"FROM ${6:#BASE2} -- SE QUISER, COPIE MAIS UM 'UNION ATÉ FROM'" 
	  ],
	  "description": "UNION_SEM_DUPLICATAS"
	},
  
	  // UNION_ALL_MANTEM_DUPLICATAS
	"UNION_ALL_MANTEM_DUPLICATAS": {
	  "scope": "sql",
	  "prefix": "ZUNIONALL",
	  "body": [
		"${7:DROP TABLE IF EXISTS ${1:#UNION_ALL}}",
		"SELECT",
		"${2:COLUNA1}",
		"${3:COLUNA2}",
		"${4:COLUNA2}",
		"INTO ${1:#UNION_ALL}",
		"FROM ${5:#BASE1}",
		"UNION ALL",
		"SELECT",
		"${2:COLUNA1}",
		"${3:COLUNA2}",
		"${4:COLUNA2}",
		"FROM ${6:#BASE2} -- SE QUISER, COPIE MAIS UM 'UNION ATÉ FROM'" 
	  ],
	  "description": "UNION_ALL_MANTEM_DUPLICATAS"
	},
  
	// REGIAO_ARQDEUA
	"REGIAO_ARQDEUA": {
	  "scope": "sql",
	  "prefix": "ZARQ_CABECALHO",
	  "body": [
		"      B.REGIAO                      ,",
	  "      B.NOMEDE AS URE               ,",
		"LEFT JOIN ARQDEUA0326 A ON A.UA = B.UA"
	  ],
	  "description": "REGIAO E URE DE ARQDEUA"
	},
  
	// ORDER_BY
	"ORDER_BY": {
	  "scope": "sql",
	  "prefix": "ZORDER",
	  "body": [
		"ORDER BY REGIAO, URE, NOME",
	  ],
	  "description": "ORDER BY"
	},
	
