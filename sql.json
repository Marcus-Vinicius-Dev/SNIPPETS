		  "scope": "sql",
		  "prefix": "ZCOLADATA",
		  "body": [
			  "/*",
		"101 = mm/dd/yyyy",
		"102 = yyyy.mm.dd",
		"103 = dd/mm/yyyy",
		"104 = dd.mm.yyyy",
		"105 = dd-mm-yyyy",
		"120 = yyyy-mm-dd hh:mi:ss",
		"126 = yyyy-mm-ddThh:mi:ss.mmm ",
			  "/*"
		  ],
		  "description": "COLA_DATA"
	  },
	  
	  //CONVERTER_TIPO_DE_DADOS
	  "CONVERTER_TIPO_DE_DADOS": {
